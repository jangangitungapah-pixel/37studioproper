

# Protected admin mutations (payment/refund/proof, stock, ownership, Gallery delete, Danger Zone).
# Secrets stay in this Worker and are never exposed through Vite variables.
VITE_ADMIN_OPERATIONS_URL=

# Studio Owner
# Email pemilik studio — digunakan untuk bootstrap ownership admin pertama.
VITE_OWNER_EMAIL=

# Firebase App Check for AI Logic (reCAPTCHA Enterprise site key).
# The debug token is for local development only and must never be committed with a real value.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Cloudinary Image Upload
# Cloud name dan preset dari Cloudinary Dashboard > Settings > Upload Presets.
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
