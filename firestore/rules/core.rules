rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function hasBootstrapOwnerToken() {
      return request.auth.token.email_verified == true &&
        request.auth.token.get('email', '').lower() == 'marsicprod@gmail.com';
    }
    function isBootstrapOwnerEmail() {
      return isSignedIn() && hasBootstrapOwnerToken();
    }
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function ownershipControlExists() {
      return exists(/databases/$(database)/documents/adminControl/ownership);
    }
    function ownershipControlMatches() {
      return ownershipControlExists() &&
        get(/databases/$(database)/documents/adminControl/ownership).data.currentOwnerUid == request.auth.uid;
    }
    function isOwner() {
      return (!userDocExists() && isBootstrapOwnerEmail() && !ownershipControlExists()) ||
        (userDocExists() &&
          getUserData().role == 'owner' &&
          getUserData().status == 'approved' &&
          ownerUidMatches());
    }
    function ownerUidMatches() {
      let own = /databases/$(database)/documents/adminControl/ownership;
      return !exists(own) || get(own).data.currentOwnerUid == request.auth.uid;
    }
    function actorUser() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(p) ? get(p).data : null;
    }
    function actorIsCurrentOwner(u) {
      return u != null && u.role == 'owner' && u.status == 'approved' && ownerUidMatches();
    }
    function actorIsOwnerOnly() {
      return actorIsCurrentOwner(actorUser());
    }
    function actorHasAdminPage(page) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && u.permissions.get(page, false) == true)
      );
    }
    function actorHasAdminPageOrOwnerOnly(page, ownerOnly) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (!ownerOnly && u.role == 'admin' && u.permissions is map && u.permissions.get(page, false) == true)
      );
    }
    function actorHasTwoAdminPages(pageA, pageB) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get(pageA, false) == true ||
          u.permissions.get(pageB, false) == true
        ))
      );
    }
    function actorCanReadBooking() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('schedule', false),
          u.permissions.get('customers', false),
          u.permissions.get('billing', false),
          u.permissions.get('bookkeeping', false)
        ])
      );
    }
    function actorApprovedGuardAdmin(u) {
      return u != null && u.role == 'admin' &&
        u.status == 'approved' &&
        u.permissions is map &&
        u.permissions.get('guard-attendance', u.permissions.get('operator-fee', false)) == true;
    }
    function actorCanManageGuardAttendanceAdminOnly() {
      return actorApprovedGuardAdmin(actorUser());
    }
    function actorCanManageGuardOrOperatorFees() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get('operator-fee', false) == true ||
          u.permissions.get('guard-attendance', false) == true
        ))
      );
    }
    function isApproved() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        u.role in ['admin', 'studio_guard'] ||
        (u.role == 'owner' && ownerUidMatches())
      );
    }
    function isClientAccount() {
      let u = actorUser();
      return u != null && u.role == 'client' && u.status == 'active';
    }
    function isStudioGuardAccount() {
      let u = actorUser();
      return u != null && u.role == 'studio_guard' && u.status == 'approved';
    }
    function hasCanonicalGuardId(data) {
      return data.guardId is string &&
        data.guardId.size() > 0;
    }
    function hasPermission(page) {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved' &&
        profile.permissions is map &&
        profile.permissions[page] == true
      ) || isOwner();
    }
    function hasApprovedAdminPermission(page) {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved' &&
        profile.permissions is map &&
        profile.permissions[page] == true
      ) || isOwner();
    }
    function hasProcurementBookkeepingPermission() {
      return actorHasAdminPage('bookkeeping');
    }
    function canAccessNotifications() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map &&
          u.permissions.get('notifications', u.permissions.get('settings', false)) == true)
      );
    }
    function canManageOperatorFees() {
      return actorHasAdminPage('operator-fee');
    }
    function canManageGuardAttendance() {
      return isOwner() || actorCanManageGuardAttendanceAdminOnly();
    }
    function canAccessBookingData() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('schedule', false),
          u.permissions.get('customers', false),
          u.permissions.get('billing', false)
        ])
      );
    }
    function isApprovedScheduleAdmin() {
      return actorHasAdminPage('schedule');
    }
    function canAccessCustomerData() {
      return actorHasTwoAdminPages('dashboard', 'customers');
    }
    function canManageCustomerData() {
      return actorHasAdminPage('customers');
    }
    function canAccessBookkeepingData() {
      return actorHasTwoAdminPages('dashboard', 'bookkeeping');
    }
    function canAccessInventoryData() {
      return actorHasTwoAdminPages('dashboard', 'inventory');
    }
    function canAccessMaintenanceData() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('inventory', false),
          u.permissions.get('bookkeeping', false)
        ])
      );
    }
    function actorCanReadProcurementEvent(action) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get('dashboard', false) == true ||
          u.permissions.get('inventory', false) == true ||
          (action == 'payment_recorded' && u.permissions.get('bookkeeping', false) == true)
        ))
      );
    }
    function canAccessBookingDataOrClient(docClientUid) {
      let u = actorUser();
      return u != null && (
        (u.role == 'client' && u.status == 'active' && docClientUid == request.auth.uid) ||
        (u.status == 'approved' && (
          (u.role == 'owner' && ownerUidMatches()) ||
          (u.role == 'admin' && u.permissions is map && true in [
            u.permissions.get('dashboard', false),
            u.permissions.get('schedule', false),
            u.permissions.get('customers', false),
            u.permissions.get('billing', false)
          ])
        ))
      );
    }
    function actorCanReadCustomerOrClient(customerId) {
      let u = actorUser();
      return u != null && (
        (u.role == 'client' && u.status == 'active' && customerId == ('auth_' + request.auth.uid)) ||
        (u.status == 'approved' && (
          (u.role == 'owner' && ownerUidMatches()) ||
          (u.role == 'admin' && u.permissions is map && (
            u.permissions.get('dashboard', false) == true ||
            u.permissions.get('customers', false) == true
          ))
        ))
      );
    }
    function validString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }
    function validStrMax(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }
    function validOptionalString(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxSize);
    }
    function validNumber(value, minValue, maxValue) {
      return value is number && value >= minValue && value <= maxValue;
    }
    function validIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validIsoTimestampString(value) {
      return value is string && value.size() >= 10;
    }
    function validPermissions(data) {
      return data is map &&
        data.keys().hasAll([
          'dashboard', 'schedule', 'customers', 'billing',
          'bookkeeping', 'inventory', 'gallery', 'settings'
        ]) &&
        data.keys().hasOnly([
          'dashboard', 'schedule', 'customers', 'billing', 'bookkeeping',
          'operator-fee', 'guard-attendance', 'inventory', 'gallery', 'settings',
          'notifications'
        ]) &&
        data.values().hasOnly([true, false]);
    }
    function adminPermissionsAllFalse(data) {
      return data.values().hasOnly([false]);
    }
    function hasNoAdminPermissions(data) {
      return adminPermissionsAllFalse(data);
    }
    function hasOnlyGuardPortalPermissions(data) {
      return hasNoAdminPermissions(data);
    }
    function validPreferences(data) {
      return data is map &&
        data.keys().hasOnly(['accountNote', 'defaultLandingKey', 'notificationLevel', 'preferredContact', 'theme']);
    }
    function validUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'provider', 'permissions',
          'preferences', 'role', 'status', 'createdAt', 'updatedAt',
          'ownershipTransferredInAt', 'ownershipTransferredOutAt',
          'adminRequestCancelledAt', 'isGuard', 'guardId'
        ]) &&
        data.uid == userId &&
        data.email is string &&
        data.phoneNumber is string &&
        data.displayName is string && data.displayName.size() > 0 &&
        data.provider is string && data.provider.size() > 0 &&
        validPermissions(data.permissions) &&
        (
          (data.role == 'owner' && data.status == 'approved') ||
          (data.role == 'admin' && data.status in ['pending', 'approved', 'rejected', 'inactive']) ||
          (data.role == 'client' && data.status in ['active', 'rejected', 'inactive'] && hasNoAdminPermissions(data.permissions)) ||
          (data.role == 'studio_guard' && data.status == 'approved' && hasOnlyGuardPortalPermissions(data.permissions) && hasCanonicalGuardId(data)) ||
          (data.role == 'studio_guard' && data.status in ['pending', 'rejected', 'inactive'] && hasOnlyGuardPortalPermissions(data.permissions))
        ) &&
        (!('preferences' in data) || validPreferences(data.preferences)) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        (!data.keys().hasAny(['isGuard']) || data.isGuard == null || data.isGuard == false) &&
        (data.get('guardId', null) == null || data.guardId is string);
    }
    function authIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phoneNumber == request.auth.token.phone_number
        );
    }
    function isSafeAccountSelfCreate(data) {
      let bootstrap = isBootstrapOwnerEmail();
      return (bootstrap && data.role == 'owner' && data.status == 'approved') ||
        (!bootstrap && ((data.role == 'admin' && data.status == 'pending') || (data.role == 'client' && data.status == 'active')));
    }
    function isSafeAdminRequestToClientTransition(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'admin' &&
        resource.data.status in ['pending', 'rejected'] &&
        request.resource.data.role == 'client' &&
        request.resource.data.status == 'active' &&
        validIsoTimestampString(request.resource.data.adminRequestCancelledAt) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'permissions', 'adminRequestCancelledAt', 'updatedAt'
        ]);
    }
