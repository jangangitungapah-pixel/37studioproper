    match /bookkeepingEntries/{entryId} {
      allow read: if isApproved() && canAccessBookkeepingData();
      allow create: if bookkeepingEntryCreateAllowed(request.resource.data, entryId);
      allow update: if hasApprovedAdminPermission('bookkeeping') &&
        validManualBookkeepingEntry(request.resource.data, entryId) &&
        resource.data.source in ['', 'manual'] &&
        manualBookkeepingUpdateAllowed(request.resource.data, entryId);
      allow delete: if manualBookkeepingDeleteAllowed(entryId);
    }

    function validCashClosingSession(data, closingId) {
      let allowedFields = [
        'id', 'businessDate', 'registerId', 'status', 'activityRevision',
        'createdAt', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
        'lastOperationId', 'lastOperationAction', 'lastBookingId',
        'lastLedgerEntryId', 'lastProofId', 'revision', 'cashVariance',
        'closedAt', 'closedByName', 'closedByUid', 'cashDenominations',
        'countedCash', 'cutoffAt', 'digitalCounts', 'digitalReconciliation',
        'expectedCash', 'lastEventAt', 'lastEventId', 'lastEventType',
        'openingCash', 'reviewNote', 'sourceFingerprint', 'sourceWatermark',
        'totalsByMethod', 'transactionCount', 'transactionReferences',
        'varianceReason', 'lastFinanceOperationId', 'reopenReason',
        'reopenedAt', 'reopenedByName', 'reopenedByUid',
        'lastProcurementPaymentAt', 'lastProcurementPaymentId',
        'lastProcurementPurchaseOrderId'
      ];
      return data is map &&
        data.keys().hasOnly(allowedFields) &&
        data.keys().hasAll([
          'id', 'businessDate', 'registerId', 'status', 'activityRevision',
          'createdAt', 'updatedAt', 'revision', 'lastEventId',
          'lastEventType', 'lastOperationId', 'lastOperationAction'
        ]) &&
        data.id == closingId &&
        closingId == data.businessDate + '__main' &&
        validIsoDate(data.businessDate) &&
        data.registerId == 'main' &&
        data.status in ['closed', 'reopened'] &&
        data.activityRevision is int &&
        data.activityRevision >= 0 &&
        data.revision is int &&
        data.revision >= 1 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.lastEventId, 1, 160) &&
        data.lastEventType in ['closed', 'reopened'] &&
        validString(data.lastOperationId, 8, 80) &&
        data.lastOperationAction in ['daily-close', 'daily-reopen'] &&
        data.lastBookingId == '' &&
        data.lastLedgerEntryId == '' &&
        data.lastProofId == '';
    }

    function activityRevisionIncrements(closingId, data) {
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      return exists(closingPath)
        ? data.activityRevision == get(closingPath).data.get('activityRevision', 0) + 1
        : data.activityRevision == 1;
    }

    function financeActivityLedgerCompanionMatchesAfter(data, bookingAfter) {
      return data.lastLedgerEntryId is string &&
        data.lastLedgerEntryId.size() > 0 &&
        bookingAfter.lastFinanceLedgerEntryId == data.lastLedgerEntryId &&
        bookingAfter.lastFinanceProofId == data.lastProofId;
    }

    function financeActivityVoidCompanionMatchesAfter(data, bookingAfter) {
      return data.lastLedgerEntryId == '' &&
        data.lastProofId == '' &&
        bookingAfter.lastFinanceAction == 'void' &&
        bookingAfter.lastFinanceLedgerEntryId == '' &&
        bookingAfter.lastFinanceProofId == '';
    }

    function financeActivityBookingCompanionMatchesAfter(data, action) {
      let bookingPath = /databases/$(database)/documents/bookings/$(data.lastBookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return existsAfter(bookingPath) &&
        bookingAfter.lastFinanceAction == action &&
        bookingAfter.lastFinanceBusinessDate == data.businessDate &&
        bookingAfter.lastFinanceOperationId == data.lastOperationId &&
        bookingAfter.lastFinanceLedgerEntryId == data.lastLedgerEntryId &&
        bookingAfter.lastFinanceProofId == data.lastProofId &&
        (
          action == 'void'
            ? financeActivityVoidCompanionMatchesAfter(data, bookingAfter)
            : financeActivityLedgerCompanionMatchesAfter(data, bookingAfter)
        );
    }

    function validFinanceActivityFence(data, closingId) {
      let fencePath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let allowedChanges = [
        'activityRevision', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
        'lastOperationId', 'lastOperationAction', 'lastBookingId',
        'lastLedgerEntryId', 'lastProofId'
      ];
      return data is map &&
        (
          exists(fencePath)
            ? data.diff(get(fencePath).data).affectedKeys().hasOnly(allowedChanges)
            : data.keys().hasOnly([
                'id', 'businessDate', 'registerId', 'status', 'activityRevision',
                'createdAt', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
                'lastOperationId', 'lastOperationAction', 'lastBookingId',
                'lastLedgerEntryId', 'lastProofId'
              ])
        ) &&
        data.id == closingId &&
        closingId == data.businessDate + '__main' &&
        validIsoDate(data.businessDate) &&
        data.registerId == 'main' &&
        data.status in ['open', 'reopened'] &&
        data.activityRevision is int &&
        data.activityRevision >= 1 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validIsoTimestampString(data.lastActivityAt) &&
        data.lastActivityByUid == request.auth.uid &&
        data.lastOperationId is string &&
        data.lastOperationId.size() > 0 &&
        data.lastOperationAction in ['payment', 'proof-approve', 'refund', 'void'] &&
        data.lastBookingId is string &&
        data.lastBookingId.size() > 0 &&
        data.lastLedgerEntryId is string &&
        data.lastProofId is string;
    }

    function financeActivityFenceUpdateAllowed(closingId) {
      let data = request.resource.data;
      let action = data.lastOperationAction;
      let fencePath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      return hasApprovedAdminPermission('billing') &&
        validFinanceActivityFence(data, closingId) &&
        (
          exists(fencePath)
            ? resource.data.status != 'closed' &&
              data.activityRevision == resource.data.get('activityRevision', 0) + 1
            : data.activityRevision == 1
        ) &&
        financeActivityBookingCompanionMatchesAfter(data, action);
    }

    function maintenanceCostFenceCompanionMatchesAfter(data, entryAfter) {
      let workOrderPath = /databases/$(database)/documents/maintenanceWorkOrders/$(entryAfter.sourceWorkOrderId);
      let workOrderExists = existsAfter(workOrderPath);
      let workOrder = workOrderExists ? getAfter(workOrderPath).data : {};
      let eventPath = /databases/$(database)/documents/maintenanceEvents/$(entryAfter.sourceEventId);
      let eventExists = existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      return workOrderExists && eventExists &&
        entryAfter.source == 'maintenance' &&
        entryAfter.operationId == data.lastOperationId &&
        entryAfter.date == data.businessDate &&
        workOrder.id == entryAfter.sourceWorkOrderId &&
        workOrder.costEntryId == data.lastLedgerEntryId &&
        workOrder.lastOperationId == data.lastOperationId &&
        workOrder.lastOperationAction == 'cost' &&
        workOrder.lastEventId == entryAfter.sourceEventId &&
        event.id == entryAfter.sourceEventId &&
        event.workOrderId == workOrder.id &&
        event.operationId == data.lastOperationId &&
        event.operationAction == 'cost' &&
        event.bookkeepingEntryId == data.lastLedgerEntryId;
    }

    function manualBookkeepingFenceCreateCompanionMatchesAfter(data) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let entryExists = existsAfter(entryPath);
      let entryAfter = entryExists ? getAfter(entryPath).data : {};
      return entryExists &&
        entryAfter.source == 'manual' &&
        entryAfter.operationId == data.lastOperationId &&
        entryAfter.date == data.businessDate;
    }

    function manualBookkeepingMaintenanceFenceCompanionMatchesAfter(data) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let entryExists = existsAfter(entryPath);
      let entryAfter = entryExists ? getAfter(entryPath).data : {};
      return entryExists && maintenanceCostFenceCompanionMatchesAfter(data, entryAfter);
    }

    function manualBookkeepingFenceUpdateCompanionMatchesAfter(data) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let entryExistsAfter = existsAfter(entryPath);
      let entryAfter = entryExistsAfter ? getAfter(entryPath).data : {};
      let entryExistsBefore = exists(entryPath);
      let entryBefore = entryExistsBefore ? get(entryPath).data : {};
      return entryExistsAfter &&
        entryAfter.source == 'manual' &&
        entryAfter.operationId == data.lastOperationId &&
        (entryAfter.date == data.businessDate ||
          (entryExistsBefore && entryBefore.date == data.businessDate));
    }

    function manualBookkeepingFenceDeleteCompanionMatchesAfter(data) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let entryExistsAfter = existsAfter(entryPath);
      let entryExistsBefore = exists(entryPath);
      let entryBefore = entryExistsBefore ? get(entryPath).data : {};
      return !entryExistsAfter && entryExistsBefore &&
        entryBefore.source in ['', 'manual'] &&
        entryBefore.date == data.businessDate;
    }

    function manualBookkeepingFenceCompanionMatchesAfter(data, action) {
      return action == 'maintenance-cost'
        ? manualBookkeepingMaintenanceFenceCompanionMatchesAfter(data)
        : action == 'manual-create'
          ? manualBookkeepingFenceCreateCompanionMatchesAfter(data)
          : action == 'manual-delete'
            ? manualBookkeepingFenceDeleteCompanionMatchesAfter(data)
            : manualBookkeepingFenceUpdateCompanionMatchesAfter(data);
    }
    function validManualBookkeepingActivityFence(data, closingId) {
      let fencePath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let allowedChanges = [
        'activityRevision', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
        'lastOperationId', 'lastOperationAction', 'lastBookingId',
        'lastLedgerEntryId', 'lastProofId'
      ];
      return data is map &&
        (
          exists(fencePath)
            ? data.diff(get(fencePath).data).affectedKeys().hasOnly(allowedChanges)
            : data.keys().hasOnly([
                'id', 'businessDate', 'registerId', 'status', 'activityRevision',
                'createdAt', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
                'lastOperationId', 'lastOperationAction', 'lastBookingId',
                'lastLedgerEntryId', 'lastProofId'
              ])
        ) &&
        data.id == closingId &&
        closingId == data.businessDate + '__main' &&
        validIsoDate(data.businessDate) &&
        data.registerId == 'main' &&
        data.status in ['open', 'reopened'] &&
        data.activityRevision is int &&
        data.activityRevision >= 1 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validIsoTimestampString(data.lastActivityAt) &&
        data.lastActivityByUid == request.auth.uid &&
        data.lastOperationId is string &&
        data.lastOperationId.size() > 0 &&
        data.lastOperationAction in ['manual-create', 'manual-update', 'manual-delete', 'maintenance-cost'] &&
        data.lastLedgerEntryId is string &&
        data.lastLedgerEntryId.size() > 0 &&
        data.lastBookingId == '' &&
        data.lastProofId == '';
    }

    function manualBookkeepingFenceUpdateAllowed(closingId) {
      let data = request.resource.data;
      return hasApprovedAdminPermission('bookkeeping') &&
        validManualBookkeepingActivityFence(data, closingId) &&
        activityRevisionIncrements(closingId, data) &&
        (!exists(/databases/$(database)/documents/cashClosingSessions/$(closingId)) ||
          get(/databases/$(database)/documents/cashClosingSessions/$(closingId)).data.status != 'closed') &&
        manualBookkeepingFenceCompanionMatchesAfter(data, data.lastOperationAction);
    }

    function validCashClosingEvent(data, eventId) {
      return data is map &&
        data.keys().hasOnly([
          'action', 'actorName', 'actorUid', 'businessDate', 'closingId',
          'createdAt', 'id', 'reason', 'registerId', 'revision',
          'sourceFingerprint', 'snapshot', 'summary', 'type', 'operationId'
        ]) &&
        data.id == eventId &&
        data.action in ['closed', 'reopened'] &&
        validString(data.actorName, 1, 120) &&
        data.actorUid == request.auth.uid &&
        validIsoDate(data.businessDate) &&
        validString(data.closingId, 1, 80) &&
        data.closingId == data.businessDate + '__main' &&
        validIsoTimestampString(data.createdAt) &&
        validString(data.reason, 0, 600) &&
        data.registerId == 'main' &&
        data.revision is int &&
        data.revision >= 1 &&
        validString(data.get('sourceFingerprint', ''), 0, 64) &&
        data.type == 'cash-closing-event' &&
        validString(data.operationId, 8, 80) &&
        (!data.keys().hasAny(['snapshot']) || data.snapshot is map) &&
        (!data.keys().hasAny(['summary']) || data.summary is map);
    }

    function cashClosingEventReferencesSessionAfter(eventId) {
      let event = request.resource.data;
      let sessionPath = /databases/$(database)/documents/cashClosingSessions/$(event.closingId);
      let sessionAfter = getAfter(sessionPath).data;
      let expectedAction = event.action == 'closed' ? 'daily-close' : 'daily-reopen';
      return existsAfter(sessionPath) &&
        sessionAfter.lastEventId == eventId &&
        sessionAfter.lastEventType == event.action &&
        sessionAfter.lastOperationId == event.operationId &&
        sessionAfter.lastOperationAction == expectedAction &&
        sessionAfter.businessDate == event.businessDate &&
        sessionAfter.revision == event.revision &&
        sessionAfter.status == (event.action == 'closed' ? 'closed' : 'reopened');
    }

    function dailyClosingSessionTransitionCompanionsMatchAfter(closingId, data) {
      let sessionPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let hasPrevious = exists(sessionPath);
      let previous = hasPrevious ? get(sessionPath).data : {};
      let eventId = data.lastEventId;
      let eventPath = /databases/$(database)/documents/cashClosingEvents/$(eventId);
      let eventAfter = existsAfter(eventPath) ? getAfter(eventPath).data : {};
      let action = data.lastOperationAction;
      return (
        (
          action == 'daily-close' &&
          data.status == 'closed' &&
          (!hasPrevious || previous.status in ['open', 'reopened']) &&
          data.revision == previous.get('revision', 0) + 1 &&
          data.activityRevision == previous.get('activityRevision', 0) &&
          data.lastEventType == 'closed' &&
          existsAfter(eventPath) &&
          eventAfter.action == 'closed' &&
          eventAfter.operationId == data.lastOperationId &&
          eventAfter.closingId == closingId
        ) ||
        (
          action == 'daily-reopen' &&
          isOwner() &&
          hasPrevious &&
          previous.status == 'closed' &&
          data.status == 'reopened' &&
          data.revision == previous.revision &&
          data.activityRevision == previous.get('activityRevision', 0) + 1 &&
          data.lastEventType == 'reopened' &&
          existsAfter(eventPath) &&
          eventAfter.action == 'reopened' &&
          eventAfter.operationId == data.lastOperationId &&
          eventAfter.closingId == closingId
        )
      );
    }

    function dailyClosingSessionTransitionAllowed(closingId) {
      let data = request.resource.data;
      let action = data.lastOperationAction;
      return hasApprovedAdminPermission('bookkeeping') &&
        validCashClosingSession(data, closingId) &&
        action in ['daily-close', 'daily-reopen'] &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'finance',
          action,
          'cashClosingSessions',
          closingId
        ) &&
        dailyClosingSessionTransitionCompanionsMatchAfter(closingId, data);
    }

    function cashClosingSessionWriteAllowed(closingId, data) {
      let action = data.get('lastOperationAction', '');
      return action in ['payment', 'proof-approve', 'refund', 'void']
        ? financeActivityFenceUpdateAllowed(closingId)
        : action == 'procurement-payment'
          ? procurementPaymentFenceUpdateAllowed(closingId)
          : action in ['manual-create', 'manual-update', 'manual-delete', 'maintenance-cost']
            ? manualBookkeepingFenceUpdateAllowed(closingId)
            : action in ['daily-close', 'daily-reopen']
              ? dailyClosingSessionTransitionAllowed(closingId)
              : false;
    }

    match /cashClosingSessions/{closingId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create, update: if cashClosingSessionWriteAllowed(closingId, request.resource.data);
      allow delete: if false;
    }

    match /cashClosingEvents/{eventId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create: if hasApprovedAdminPermission('bookkeeping') &&
        validCashClosingEvent(request.resource.data, eventId) &&
        cashClosingEventReferencesSessionAfter(eventId);
      allow update, delete: if false;
    }

    function validInventoryItem(data, itemId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'name', 'category', 'type', 'quantity', 'unit', 'minStock',
          'condition', 'status', 'location', 'note', 'createdAt', 'updatedAt',
          'lastOperationId', 'lastOperationAction', 'lastMovementId',
          'lastMovementSnapshot', 'activeMaintenanceWorkOrderId',
          'lastMaintenanceWorkOrderId'
        ]) &&
        data.id == itemId &&
        validString(data.name, 1, 160) &&
        validString(data.category, 1, 80) &&
        validString(data.type, 1, 40) &&
        validNumber(data.quantity, 0, 1000000) &&
        validString(data.unit, 1, 40) &&
        validNumber(data.minStock, 0, 1000000) &&
        validString(data.condition, 1, 40) &&
        validString(data.status, 1, 40) &&
        validString(data.location, 0, 240) &&
        validString(data.note, 0, 2000) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'activeMaintenanceWorkOrderId', 160) &&
        validOptionalString(data, 'lastMaintenanceWorkOrderId', 160) &&
        data.lastOperationId.size() == 67 &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}') &&
        data.lastOperationAction in [
          'create', 'update', 'archive', 'adjust', 'receive',
          'maintenance-report', 'maintenance-action', 'maintenance-reopen'
        ] &&
        validString(data.lastMovementId, 1, 160) &&
        data.lastMovementSnapshot is map &&
        data.lastMovementSnapshot.id == data.lastMovementId &&
        data.lastMovementSnapshot.itemId == data.id &&
        data.lastMovementSnapshot.operationId == data.lastOperationId &&
        data.lastMovementSnapshot.operationAction == data.lastOperationAction &&
        data.lastMovementSnapshot.actorUid == request.auth.uid &&
        data.lastMovementSnapshot.nextQuantity == data.quantity;
    }

    function validInventoryMovement(data, movementId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'itemId', 'itemName', 'type', 'quantity', 'previousQuantity',
          'nextQuantity', 'unit', 'note', 'reason', 'actorUid', 'actorName',
          'createdAt', 'metadataSnapshot', 'previousMetadata', 'nextMetadata',
          'adjustmentKey', 'operationId', 'operationAction',
          'sourcePurchaseOrderId', 'sourceGoodsReceiptId', 'sourceLineId'
        ]) &&
        data.id == movementId &&
        validString(data.itemId, 1, 160) &&
        validString(data.itemName, 1, 160) &&
        data.type in [
          'create', 'edit', 'inactive', 'stock-in', 'stock-out',
          'goods-receipt', 'maintenance'
        ] &&
        validNumber(data.quantity, 0, 1000000) &&
        validNumber(data.previousQuantity, 0, 1000000) &&
        validNumber(data.nextQuantity, 0, 1000000) &&
        validString(data.unit, 1, 40) &&
        validString(data.note, 0, 600) &&
        validString(data.reason, 0, 600) &&
        data.actorUid == request.auth.uid &&
        validString(data.actorName, 1, 120) &&
        validIsoTimestampString(data.createdAt) &&
        (!data.keys().hasAny(['metadataSnapshot']) || data.metadataSnapshot is map) &&
        (!data.keys().hasAny(['previousMetadata']) || data.previousMetadata is map) &&
        (!data.keys().hasAny(['nextMetadata']) || data.nextMetadata is map) &&
        (!data.keys().hasAny(['adjustmentKey']) || validString(data.adjustmentKey, 1, 128)) &&
        validOptionalString(data, 'sourcePurchaseOrderId', 160) &&
        validOptionalString(data, 'sourceGoodsReceiptId', 160) &&
        validOptionalString(data, 'sourceLineId', 160) &&
        data.operationId.size() == 67 &&
        data.operationId.matches('^v1_[a-f0-9]{64}') &&
        data.operationAction in [
          'create', 'update', 'archive', 'adjust', 'receive',
          'maintenance-report', 'maintenance-action', 'maintenance-reopen'
        ];
    }

    function inventoryPreviousMovementRecorded() {
      let movementId = resource.data.get('lastMovementId', '');
      let movementPath = /databases/$(database)/documents/inventoryMovements/$(movementId);
      return movementId == '' || exists(movementPath);
    }

    function inventoryItemCreateAllowed(itemId) {
      let data = request.resource.data;
      return hasApprovedAdminPermission('inventory') &&
        validInventoryItem(data, itemId) &&
        data.lastOperationAction == 'create' &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'inventory',
          'create',
          'inventoryItems',
          itemId
        );
    }

    function procurementGoodsReceiptMovementMatchesAfter(data) {
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(data.sourceGoodsReceiptId);
      let receiptExists = existsAfter(receiptPath);
      let receipt = receiptExists ? getAfter(receiptPath).data : {};
      return receiptExists &&
        receipt.operationId == data.operationId &&
        receipt.purchaseOrderId == data.sourcePurchaseOrderId &&
        receipt.receivedByUid == request.auth.uid &&
        receipt.items.hasAny([{
          'lineId': data.sourceLineId,
          'inventoryItemId': data.itemId,
          'itemName': data.itemName,
          'quantity': data.quantity,
          'movementId': data.id
        }]);
    }

    function validGoodsReceiptInventoryItem(data, itemId, changed) {
      let movement = data.lastMovementSnapshot;
      return data is map &&
        data.id == itemId &&
        data.quantity is number &&
        data.quantity > resource.data.quantity &&
        data.quantity <= 1000000 &&
        data.createdAt == resource.data.createdAt &&
        validIsoTimestampString(data.updatedAt) &&
        data.lastOperationId is string &&
        data.lastOperationId.size() == 67 &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.lastOperationAction == 'receive' &&
        validString(data.lastMovementId, 1, 160) &&
        movement is map &&
        movement.id == data.lastMovementId &&
        movement.itemId == itemId &&
        movement.type == 'stock-in' &&
        movement.operationAction == 'receive' &&
        movement.operationId == data.lastOperationId &&
        movement.actorUid == request.auth.uid &&
        movement.previousQuantity == resource.data.quantity &&
        movement.nextQuantity == data.quantity &&
        movement.nextQuantity == movement.previousQuantity + movement.quantity &&
        movement.sourcePurchaseOrderId is string &&
        movement.sourceGoodsReceiptId is string &&
        movement.sourceLineId is string &&
        data.name == resource.data.name &&
        data.category == resource.data.category &&
        data.type == resource.data.type &&
        data.unit == resource.data.unit &&
        data.minStock == resource.data.minStock &&
        data.condition == resource.data.condition &&
        data.status == resource.data.status &&
        data.location == resource.data.location &&
        data.note == resource.data.note &&
        changed.hasOnly([
          'quantity', 'updatedAt', 'lastOperationId', 'lastOperationAction',
          'lastMovementId', 'lastMovementSnapshot'
        ]);
    }

    function procurementGoodsReceiptMovementCreateAllowed(data, movementId) {
      let itemPath = /databases/$(database)/documents/inventoryItems/$(data.itemId);
      let itemExists = existsAfter(itemPath);
      let item = itemExists ? getAfter(itemPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        data is map &&
        data.id == movementId &&
        data.type == 'stock-in' &&
        data.operationAction == 'receive' &&
        data.operationId is string &&
        data.operationId.size() == 67 &&
        data.operationId.matches('^v1_[a-f0-9]{64}$') &&
        data.actorUid == request.auth.uid &&
        validString(data.actorName, 1, 120) &&
        validString(data.itemId, 1, 160) &&
        validString(data.itemName, 1, 160) &&
        validNumber(data.quantity, 1, 1000000) &&
        validNumber(data.previousQuantity, 0, 1000000) &&
        validNumber(data.nextQuantity, 0, 1000000) &&
        data.nextQuantity == data.previousQuantity + data.quantity &&
        validString(data.unit, 1, 40) &&
        validString(data.note, 0, 600) &&
        validString(data.reason, 0, 600) &&
        validString(data.sourcePurchaseOrderId, 1, 160) &&
        validString(data.sourceGoodsReceiptId, 1, 160) &&
        validString(data.sourceLineId, 1, 160) &&
        validIsoTimestampString(data.createdAt) &&
        itemExists &&
        item.lastMovementId == movementId &&
        item.lastMovementSnapshot == data &&
        item.lastOperationId == data.operationId &&
        item.lastOperationAction == 'receive' &&
        item.quantity == data.nextQuantity &&
        item.updatedAt == data.createdAt &&
        procurementGoodsReceiptMovementMatchesAfter(data);
    }

    function validMaintenanceWorkOrder(data, workOrderId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'inventoryItemId', 'itemName', 'itemCategory', 'itemLocation',
          'title', 'description', 'priority', 'status', 'reportedAt',
          'reportedByUid', 'reportedByName', 'assignedToUid', 'assignedToName',
          'plannedAt', 'dueAt', 'diagnosis', 'repairNotes', 'verificationNote',
          'verificationCondition', 'vendor', 'estimatedCost', 'actualCost',
          'costEntryId', 'attachments', 'priorItemStatus', 'priorItemCondition',
          'revision', 'createdAt', 'updatedAt', 'updatedByUid', 'updatedByName',
          'triagedAt', 'triagedByUid', 'triagedByName',
          'approvedAt', 'approvedByUid', 'approvedByName', 'approvalNote',
          'assignedAt', 'assignedByUid', 'startedAt', 'startedByUid',
          'waitingPartsAt', 'waitingPartsReason', 'resumedAt', 'resumeNote',
          'completedAt', 'completedByUid', 'completedByName',
          'verifiedAt', 'verifiedByUid', 'verifiedByName',
          'cancelledAt', 'cancelledByUid', 'cancelReason',
          'reopenPriorItemStatus', 'reopenPriorItemCondition',
          'reopenedAt', 'reopenedByUid', 'reopenedByName', 'reopenReason',
          'costRecordedAt', 'costRecordedByUid', 'costRecordedByName',
          'lastOperationId', 'lastOperationAction', 'lastEventId'
        ]) &&
        data.keys().hasAll([
          'id', 'inventoryItemId', 'itemName', 'itemCategory', 'itemLocation',
          'title', 'description', 'priority', 'status', 'reportedAt',
          'reportedByUid', 'reportedByName', 'assignedToUid', 'assignedToName',
          'plannedAt', 'dueAt', 'diagnosis', 'repairNotes', 'verificationNote',
          'verificationCondition', 'vendor', 'estimatedCost', 'actualCost',
          'costEntryId', 'attachments', 'priorItemStatus', 'priorItemCondition',
          'revision', 'createdAt', 'updatedAt', 'updatedByUid', 'updatedByName',
          'lastOperationId', 'lastOperationAction', 'lastEventId'
        ]) &&
        data.id == workOrderId &&
        validString(data.inventoryItemId, 1, 160) &&
        validString(data.itemName, 1, 160) &&
        validString(data.itemCategory, 0, 80) &&
        validString(data.itemLocation, 0, 240) &&
        validString(data.title, 3, 160) &&
        validString(data.description, 4, 2000) &&
        data.priority in ['low', 'normal', 'high', 'urgent'] &&
        data.status in [
          'reported', 'triaged', 'approved', 'assigned', 'in_progress',
          'waiting_parts', 'completed', 'verified', 'cancelled'
        ] &&
        validIsoTimestampString(data.reportedAt) &&
        validString(data.reportedByUid, 1, 128) &&
        validString(data.reportedByName, 1, 120) &&
        validString(data.assignedToUid, 0, 128) &&
        validString(data.assignedToName, 0, 120) &&
        validString(data.plannedAt, 0, 40) &&
        validString(data.dueAt, 0, 40) &&
        validString(data.diagnosis, 0, 2000) &&
        validString(data.repairNotes, 0, 2000) &&
        validString(data.verificationNote, 0, 1000) &&
        validString(data.verificationCondition, 0, 20) &&
        validString(data.vendor, 0, 160) &&
        validNumber(data.estimatedCost, 0, 1000000000) &&
        validNumber(data.actualCost, 0, 1000000000) &&
        validString(data.costEntryId, 0, 160) &&
        data.attachments is list &&
        data.attachments.size() <= 10 &&
        validString(data.priorItemStatus, 1, 40) &&
        validString(data.priorItemCondition, 1, 40) &&
        data.revision is int &&
        data.revision >= 1 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.updatedByUid, 1, 128) &&
        validString(data.updatedByName, 1, 120) &&
        validString(data.lastOperationId, 67, 67) &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.lastOperationAction in [
          'report', 'triage', 'approve', 'assign', 'start', 'waiting_parts',
          'resume', 'complete', 'verify', 'cancel', 'reopen', 'cost'
        ] &&
        validString(data.lastEventId, 1, 160) &&
        validOptionalString(data, 'triagedByUid', 128) &&
        validOptionalString(data, 'triagedByName', 120) &&
        validOptionalString(data, 'approvedByUid', 128) &&
        validOptionalString(data, 'approvedByName', 120) &&
        validOptionalString(data, 'assignedByUid', 128) &&
        validOptionalString(data, 'startedByUid', 128) &&
        validOptionalString(data, 'completedByUid', 128) &&
        validOptionalString(data, 'completedByName', 120) &&
        validOptionalString(data, 'verifiedByUid', 128) &&
        validOptionalString(data, 'verifiedByName', 120) &&
        validOptionalString(data, 'cancelledByUid', 128) &&
        validOptionalString(data, 'reopenPriorItemStatus', 40) &&
        validOptionalString(data, 'reopenPriorItemCondition', 40) &&
        validOptionalString(data, 'reopenedByUid', 128) &&
        validOptionalString(data, 'reopenedByName', 120) &&
        validOptionalString(data, 'costRecordedByUid', 128) &&
        validOptionalString(data, 'costRecordedByName', 120);
    }

    function validMaintenanceEvent(data, eventId) {
      return data is map &&
        data.keys().hasOnly([
          'action', 'actorName', 'actorUid', 'createdAt', 'details',
          'fromStatus', 'id', 'inventoryItemId', 'operationAction',
          'operationId', 'reason', 'revision', 'toStatus', 'workOrderId',
          'actualCost', 'bookkeepingEntryId'
        ]) &&
        data.id == eventId &&
        data.action in [
          'reported', 'triage', 'approve', 'assign', 'start', 'waiting_parts',
          'resume', 'complete', 'verify', 'cancel', 'reopen', 'cost_recorded'
        ] &&
        validString(data.actorName, 1, 120) &&
        data.actorUid == request.auth.uid &&
        validIsoTimestampString(data.createdAt) &&
        data.details is map &&
        validString(data.fromStatus, 0, 40) &&
        validString(data.inventoryItemId, 1, 160) &&
        data.operationAction in [
          'report', 'triage', 'approve', 'assign', 'start', 'waiting_parts',
          'resume', 'complete', 'verify', 'cancel', 'reopen', 'cost'
        ] &&
        validString(data.operationId, 67, 67) &&
        data.operationId.matches('^v1_[a-f0-9]{64}$') &&
        validString(data.reason, 0, 600) &&
        data.revision is int &&
        data.revision >= 1 &&
        validString(data.toStatus, 1, 40) &&
        validString(data.workOrderId, 1, 160) &&
        (!data.keys().hasAny(['actualCost']) || validNumber(data.actualCost, 1, 1000000000)) &&
        validOptionalString(data, 'bookkeepingEntryId', 160);
    }

    function maintenanceWorkOrderEventMatchesAfter(data) {
      let eventPath = /databases/$(database)/documents/maintenanceEvents/$(data.lastEventId);
      let eventExists = existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      return eventExists &&
        event.id == data.lastEventId &&
        event.workOrderId == data.id &&
        event.inventoryItemId == data.inventoryItemId &&
        event.operationId == data.lastOperationId &&
        event.operationAction == data.lastOperationAction &&
        event.revision == data.revision &&
        event.toStatus == data.status &&
        event.createdAt == data.updatedAt &&
        event.actorUid == request.auth.uid &&
        event.actorName == data.updatedByName &&
        event.action == (data.lastOperationAction == 'report'
          ? 'reported'
          : data.lastOperationAction == 'cost' ? 'cost_recorded' : data.lastOperationAction);
    }

    function maintenanceWorkOrderInventoryMatchesAfter(data) {
      let itemPath = /databases/$(database)/documents/inventoryItems/$(data.inventoryItemId);
      let itemExists = existsAfter(itemPath);
      let item = itemExists ? getAfter(itemPath).data : {};
      return itemExists &&
        item.id == data.inventoryItemId &&
        item.lastMaintenanceWorkOrderId == data.id &&
        item.updatedAt == data.updatedAt &&
        (
          data.status in [
            'reported', 'triaged', 'approved', 'assigned',
            'in_progress', 'waiting_parts', 'completed'
          ]
            ? item.activeMaintenanceWorkOrderId == data.id &&
              item.status == 'maintenance' &&
              item.condition == 'maintenance'
            : data.status == 'verified'
              ? item.activeMaintenanceWorkOrderId == '' &&
                item.condition == data.verificationCondition &&
                item.status == (data.verificationCondition == 'broken' ? 'broken' : 'active')
              : data.status == 'cancelled' &&
                item.activeMaintenanceWorkOrderId == '' &&
                item.status == data.get('reopenPriorItemStatus', data.priorItemStatus) &&
                item.condition == data.get('reopenPriorItemCondition', data.priorItemCondition)
        );
    }

    function maintenanceWorkOrderCreateAllowed(workOrderId) {
      let data = request.resource.data;
      let itemPath = /databases/$(database)/documents/inventoryItems/$(data.inventoryItemId);
      let itemBeforeExists = exists(itemPath);
      let itemBefore = itemBeforeExists ? get(itemPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        validMaintenanceWorkOrder(data, workOrderId) &&
        data.status == 'reported' &&
        data.revision == 1 &&
        data.reportedByUid == request.auth.uid &&
        data.updatedByUid == request.auth.uid &&
        data.lastOperationAction == 'report' &&
        data.createdAt == data.updatedAt &&
        itemBeforeExists &&
        itemBefore.get('activeMaintenanceWorkOrderId', '') == '' &&
        itemBefore.status != 'maintenance' &&
        itemBefore.condition != 'maintenance' &&
        itemBefore.status != 'inactive' &&
        itemBefore.status != 'lost' &&
        data.itemName == itemBefore.name &&
        data.itemCategory == itemBefore.category &&
        data.itemLocation == itemBefore.location &&
        data.priorItemStatus == itemBefore.get('status', 'active') &&
        data.priorItemCondition == itemBefore.get('condition', 'good') &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'maintenance',
          'report',
          'maintenanceWorkOrders',
          workOrderId
        ) &&
        maintenanceWorkOrderEventMatchesAfter(data) &&
        maintenanceWorkOrderInventoryMatchesAfter(data);
    }

    function maintenanceWorkOrderTransitionAllowed(workOrderId, data) {
      let action = data.lastOperationAction;
      let changed = data.diff(resource.data).affectedKeys();
      let transitionAllowed = (
        action == 'triage' && resource.data.status == 'reported' && data.status == 'triaged'
      ) || (
        action == 'approve' && resource.data.status == 'triaged' && data.status == 'approved'
      ) || (
        action == 'assign' && resource.data.status == 'approved' && data.status == 'assigned'
      ) || (
        action == 'start' && resource.data.status == 'assigned' && data.status == 'in_progress'
      ) || (
        action == 'waiting_parts' && resource.data.status == 'in_progress' && data.status == 'waiting_parts'
      ) || (
        action == 'resume' && resource.data.status == 'waiting_parts' && data.status == 'in_progress'
      ) || (
        action == 'complete' && resource.data.status == 'in_progress' && data.status == 'completed'
      ) || (
        action == 'verify' && resource.data.status == 'completed' && data.status == 'verified'
      ) || (
        action == 'cancel' &&
        resource.data.status in ['reported', 'triaged', 'approved', 'assigned', 'in_progress', 'waiting_parts'] &&
        data.status == 'cancelled'
      ) || (
        action == 'reopen' && resource.data.status == 'verified' && data.status == 'in_progress' && isOwner()
      );
      return hasApprovedAdminPermission('inventory') &&
        validMaintenanceWorkOrder(data, workOrderId) &&
        resource.data.inventoryItemId == data.inventoryItemId &&
        resource.data.createdAt == data.createdAt &&
        resource.data.reportedByUid == data.reportedByUid &&
        data.revision == resource.data.revision + 1 &&
        data.updatedAt != resource.data.updatedAt &&
        data.lastOperationId != resource.data.get('lastOperationId', '') &&
        data.updatedByUid == request.auth.uid &&
        validString(data.updatedByName, 1, 120) &&
        changed.hasOnly([
          'status', 'updatedAt', 'updatedByUid', 'updatedByName',
          'revision', 'lastOperationId', 'lastOperationAction', 'lastEventId',
          'diagnosis', 'priority', 'triagedAt', 'triagedByUid', 'triagedByName',
          'approvedAt', 'approvedByUid', 'approvedByName', 'approvalNote',
          'assignedToUid', 'assignedToName', 'plannedAt', 'dueAt', 'assignedAt', 'assignedByUid',
          'startedAt', 'startedByUid', 'waitingPartsAt', 'waitingPartsReason',
          'resumedAt', 'resumeNote', 'repairNotes', 'completedAt', 'completedByUid',
          'completedByName', 'verificationCondition', 'verificationNote',
          'verifiedAt', 'verifiedByUid', 'verifiedByName', 'cancelledAt',
          'cancelledByUid', 'cancelReason', 'reopenPriorItemStatus',
          'reopenPriorItemCondition', 'reopenedAt', 'reopenedByUid',
          'reopenedByName', 'reopenReason'
        ]) &&
        transitionAllowed &&
        (
          action != 'triage' ||
          (
            validString(data.diagnosis, 4, 2000) &&
            data.triagedAt == data.updatedAt &&
            data.triagedByUid == request.auth.uid &&
            validString(data.triagedByName, 1, 120)
          )
        ) &&
        (
          action != 'approve' ||
          (
            data.approvedAt == data.updatedAt &&
            data.approvedByUid == request.auth.uid &&
            validString(data.approvedByName, 1, 120)
          )
        ) &&
        (
          action != 'assign' ||
          (
            validString(data.assignedToName, 1, 120) &&
            data.assignedAt == data.updatedAt &&
            data.assignedByUid == request.auth.uid
          )
        ) &&
        (
          action != 'start' ||
          (
            data.startedAt == data.updatedAt &&
            data.startedByUid == request.auth.uid
          )
        ) &&
        (
          action != 'waiting_parts' ||
          (
            data.waitingPartsAt == data.updatedAt &&
            validString(data.waitingPartsReason, 4, 600)
          )
        ) &&
        (
          action != 'resume' ||
          data.resumedAt == data.updatedAt
        ) &&
        (
          action != 'complete' ||
          (
            validString(data.repairNotes, 4, 2000) &&
            data.completedAt == data.updatedAt &&
            data.completedByUid == request.auth.uid &&
            validString(data.completedByName, 1, 120)
          )
        ) &&
        (
          action != 'verify' ||
          (
            data.verificationCondition in ['good', 'fair', 'broken'] &&
            (data.verificationCondition != 'broken' || validString(data.verificationNote, 4, 1000)) &&
            data.verifiedAt == data.updatedAt &&
            data.verifiedByUid == request.auth.uid &&
            validString(data.verifiedByName, 1, 120)
          )
        ) &&
        (
          action != 'cancel' ||
          (
            validString(data.cancelReason, 4, 600) &&
            data.cancelledAt == data.updatedAt &&
            data.cancelledByUid == request.auth.uid
          )
        ) &&
        (
          action != 'reopen' ||
          (
            validString(data.reopenReason, 4, 600) &&
            data.reopenedAt == data.updatedAt &&
            data.reopenedByUid == request.auth.uid &&
            validString(data.reopenedByName, 1, 120)
          )
        ) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'maintenance',
          action == 'waiting_parts' ? 'waiting-parts' : action,
          'maintenanceWorkOrders',
          workOrderId
        ) &&
        maintenanceWorkOrderEventMatchesAfter(data) &&
        maintenanceWorkOrderInventoryMatchesAfter(data);
    }

    function maintenanceWorkOrderCostCompanionsMatchAfter(workOrderId, data) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.costEntryId);
      let entryExists = existsAfter(entryPath);
      let entry = entryExists ? getAfter(entryPath).data : {};
      let eventPath = /databases/$(database)/documents/maintenanceEvents/$(data.lastEventId);
      let eventExists = existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      let closingId = entry.get('date', '') + '__main';
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let closingExists = existsAfter(closingPath);
      let closing = closingExists ? getAfter(closingPath).data : {};
      return entryExists && eventExists && closingExists &&
        entry.id == data.costEntryId &&
        entry.source == 'maintenance' &&
        entry.sourceWorkOrderId == workOrderId &&
        entry.sourceEventId == data.lastEventId &&
        entry.operationId == data.lastOperationId &&
        entry.amount == data.actualCost &&
        entry.actorUid == request.auth.uid &&
        event.id == data.lastEventId &&
        event.workOrderId == workOrderId &&
        event.bookkeepingEntryId == data.costEntryId &&
        event.operationId == data.lastOperationId &&
        event.action == 'cost_recorded' &&
        event.operationAction == 'cost' &&
        closing.id == closingId &&
        closing.status in ['open', 'reopened'] &&
        closing.lastOperationAction == 'maintenance-cost' &&
        closing.lastOperationId == data.lastOperationId &&
        closing.lastLedgerEntryId == data.costEntryId &&
        closing.lastActivityByUid == request.auth.uid &&
        closing.updatedAt == data.updatedAt;
    }

    function maintenanceWorkOrderCostUpdateAllowed(workOrderId, data) {
      return hasApprovedAdminPermission('bookkeeping') &&
        validMaintenanceWorkOrder(data, workOrderId) &&
        resource.data.status in ['completed', 'verified'] &&
        resource.data.get('costEntryId', '') == '' &&
        data.status == resource.data.status &&
        data.revision == resource.data.revision + 1 &&
        data.actualCost > 0 &&
        validString(data.costEntryId, 1, 160) &&
        data.lastOperationAction == 'cost' &&
        data.updatedAt != resource.data.updatedAt &&
        data.costRecordedAt == data.updatedAt &&
        data.costRecordedByUid == request.auth.uid &&
        validString(data.costRecordedByName, 1, 120) &&
        data.updatedByUid == request.auth.uid &&
        validString(data.updatedByName, 1, 120) &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'actualCost', 'costEntryId', 'costRecordedAt', 'costRecordedByUid',
          'costRecordedByName', 'revision', 'updatedAt', 'updatedByUid',
          'updatedByName', 'lastOperationId', 'lastOperationAction', 'lastEventId'
        ]) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'maintenance',
          'cost',
          'maintenanceWorkOrders',
          workOrderId
        ) &&
        maintenanceWorkOrderEventMatchesAfter(data) &&
        maintenanceWorkOrderCostCompanionsMatchAfter(workOrderId, data);
    }

    function maintenanceWorkOrderUpdateAllowed(workOrderId) {
      let data = request.resource.data;
      return data.lastOperationAction == 'cost'
        ? maintenanceWorkOrderCostUpdateAllowed(workOrderId, data)
        : maintenanceWorkOrderTransitionAllowed(workOrderId, data);
    }

    function maintenanceEventCreateAllowed(eventId) {
      let data = request.resource.data;
      let workOrderPath = /databases/$(database)/documents/maintenanceWorkOrders/$(data.workOrderId);
      let workOrderExists = existsAfter(workOrderPath);
      let workOrder = workOrderExists ? getAfter(workOrderPath).data : {};
      return validMaintenanceEvent(data, eventId) &&
        workOrderExists &&
        workOrder.lastEventId == eventId &&
        workOrder.lastOperationId == data.operationId &&
        workOrder.lastOperationAction == data.operationAction &&
        workOrder.revision == data.revision &&
        workOrder.status == data.toStatus &&
        workOrder.updatedAt == data.createdAt &&
        workOrder.inventoryItemId == data.inventoryItemId &&
        (
          data.operationAction == 'cost'
            ? hasApprovedAdminPermission('bookkeeping') &&
              data.action == 'cost_recorded' &&
              workOrder.costEntryId == data.bookkeepingEntryId
            : data.operationAction == 'reopen'
              ? isOwner()
              : hasApprovedAdminPermission('inventory') &&
                data.action == (data.operationAction == 'report' ? 'reported' : data.operationAction)
        );
    }

    function maintenanceInventoryItemUpdateAllowed(itemId, data, changed) {
      let workOrderId = data.get('lastMaintenanceWorkOrderId', '');
      let workOrderPath = /databases/$(database)/documents/maintenanceWorkOrders/$(workOrderId);
      let workOrderExists = workOrderId != '' && existsAfter(workOrderPath);
      let workOrder = workOrderExists ? getAfter(workOrderPath).data : {};
      let eventPath = /databases/$(database)/documents/maintenanceEvents/$(workOrder.get('lastEventId', ''));
      let eventExists = workOrderExists && existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        data.id == itemId &&
        workOrderExists &&
        eventExists &&
        workOrder.inventoryItemId == itemId &&
        data.lastMaintenanceWorkOrderId == workOrder.id &&
        workOrder.updatedAt == data.updatedAt &&
        workOrder.lastOperationId == event.operationId &&
        workOrder.lastEventId == event.id &&
        event.workOrderId == workOrder.id &&
        event.inventoryItemId == itemId &&
        event.actorUid == request.auth.uid &&
        changed.hasOnly([
          'status', 'condition', 'updatedAt',
          'activeMaintenanceWorkOrderId', 'lastMaintenanceWorkOrderId'
        ]) &&
        (
          workOrder.status in [
            'reported', 'triaged', 'approved', 'assigned',
            'in_progress', 'waiting_parts', 'completed'
          ]
            ? data.activeMaintenanceWorkOrderId == workOrder.id &&
              data.status == 'maintenance' &&
              data.condition == 'maintenance'
            : workOrder.status == 'verified'
              ? data.activeMaintenanceWorkOrderId == '' &&
                data.status == (workOrder.verificationCondition == 'broken' ? 'broken' : 'active') &&
                data.condition == workOrder.verificationCondition
              : workOrder.status == 'cancelled' &&
                data.activeMaintenanceWorkOrderId == '' &&
                data.status == workOrder.get('reopenPriorItemStatus', workOrder.priorItemStatus) &&
                data.condition == workOrder.get('reopenPriorItemCondition', workOrder.priorItemCondition)
        );
    }

    function inventoryItemUpdateAllowed(itemId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let maintenanceActive =
        resource.data.get('activeMaintenanceWorkOrderId', '') != '' ||
        data.get('activeMaintenanceWorkOrderId', '') != '' ||
        resource.data.status == 'maintenance' ||
        resource.data.condition == 'maintenance';
      return hasApprovedAdminPermission('inventory') &&
        (
          data.lastOperationAction == 'receive'
            ? validGoodsReceiptInventoryItem(data, itemId, changed)
            : maintenanceActive
              ? maintenanceInventoryItemUpdateAllowed(itemId, data, changed)
              : inventoryPreviousMovementRecorded() &&
                validInventoryItem(data, itemId) &&
                data.createdAt == resource.data.createdAt &&
                data.lastOperationId != resource.data.get('lastOperationId', '') &&
                repositoryOperationMatchesAfter(
                  data.lastOperationId,
                  'inventory',
                  data.lastOperationAction,
                  'inventoryItems',
                  itemId
                ) &&
                (
                  (
                    data.lastOperationAction == 'update' &&
                    data.quantity == resource.data.quantity &&
                    changed.hasOnly([
                      'name', 'category', 'type', 'unit', 'minStock', 'condition',
                      'status', 'location', 'note', 'updatedAt',
                      'lastOperationId', 'lastOperationAction', 'lastMovementId',
                      'lastMovementSnapshot'
                    ])
                  ) ||
                  (
                    data.lastOperationAction == 'archive' &&
                    resource.data.get('activeMaintenanceWorkOrderId', '') == '' &&
                    data.status == 'inactive' &&
                    data.quantity == resource.data.quantity &&
                    data.name == resource.data.name &&
                    data.category == resource.data.category &&
                    data.type == resource.data.type &&
                    data.unit == resource.data.unit &&
                    data.minStock == resource.data.minStock &&
                    data.condition == resource.data.condition &&
                    data.location == resource.data.location &&
                    data.note == resource.data.note &&
                    changed.hasOnly([
                      'status', 'lastOperationId', 'lastOperationAction',
                      'lastMovementId', 'lastMovementSnapshot', 'updatedAt'
                    ])
                  ) ||
                  (
                    data.lastOperationAction == 'adjust' &&
                    data.quantity != resource.data.quantity &&
                    data.name == resource.data.name &&
                    data.category == resource.data.category &&
                    data.type == resource.data.type &&
                    data.unit == resource.data.unit &&
                    data.minStock == resource.data.minStock &&
                    data.condition == resource.data.condition &&
                    data.status == resource.data.status &&
                    data.location == resource.data.location &&
                    data.note == resource.data.note &&
                    changed.hasOnly([
                      'quantity', 'lastOperationId', 'lastOperationAction',
                      'lastMovementId', 'lastMovementSnapshot', 'updatedAt'
                    ])
                  )
                )
        );
    }



    function inventoryMovementCreateAllowed(movementId) {
      let data = request.resource.data;
      return data.type == 'stock-in' && data.operationAction == 'receive'
        ? procurementGoodsReceiptMovementCreateAllowed(data, movementId)
        : inventoryStandardMovementCreateAllowed(data, movementId);
    }

    function inventoryStandardMovementCreateAllowed(data, movementId) {
      let itemPath = /databases/$(database)/documents/inventoryItems/$(data.itemId);
      let itemExists = exists(itemPath);
      let item = itemExists ? get(itemPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        validInventoryMovement(data, movementId) &&
        itemExists &&
        item.lastMovementId == movementId &&
        item.lastMovementSnapshot == data &&
        item.lastOperationId == data.operationId &&
        item.lastOperationAction == data.operationAction &&
        item.quantity == data.nextQuantity &&
        item.updatedAt == data.createdAt &&
        (
          (
            data.type == 'create' &&
            data.operationAction == 'create' &&
            data.previousQuantity == 0 &&
            data.quantity == data.nextQuantity &&
            item.createdAt == data.createdAt
          ) ||
          (
            data.type == 'edit' &&
            data.operationAction == 'update' &&
            data.previousQuantity == data.nextQuantity &&
            data.nextQuantity == item.quantity &&
            data.quantity == 0
          ) ||
          (
            data.type == 'inactive' &&
            data.operationAction == 'archive' &&
            item.status == 'inactive' &&
            data.previousQuantity == data.nextQuantity &&
            data.nextQuantity == item.quantity &&
            data.quantity == 0
          ) ||
          (
            data.type == 'stock-in' &&
            data.operationAction == 'adjust' &&
            data.nextQuantity == data.previousQuantity + data.quantity
          ) ||
          (
            data.type == 'stock-out' &&
            data.operationAction == 'adjust' &&
            data.previousQuantity == data.nextQuantity + data.quantity
          )
        );
    }
