    function validNotificationEvent(data, eventId) {
      return data.keys().hasOnly([
          'actorEmail', 'actorRole', 'actorUid', 'attempts',
          'bookingId', 'channel', 'createdAt', 'errorMessage',
          'id', 'message', 'metadata', 'paymentProofId',
          'priority', 'provider', 'sentAt', 'source', 'status',
          'targetMode', 'targetRole', 'targetUid', 'title',
          'type', 'updatedAt', 'url', 'lastAction', 'lastActionAt',
          'lastActionByEmail', 'lastActionByRole', 'lastActionByUid',
          'lastActionReason', 'lastActionRequestId', 'leaseExpiresAt',
          'leaseId', 'providerNotificationId'
        ]) &&
        data.id == eventId &&
        data.actorRole in ['admin', 'client', 'guard', 'system'] &&
        validString(data.actorUid, 1, 128) &&
        validString(data.actorEmail, 0, 254) &&
        validNumber(data.attempts, 0, 20) &&
        validString(data.bookingId, 0, 160) &&
        data.channel == 'in_app' &&
        validIsoTimestampString(data.createdAt) &&
        validString(data.errorMessage, 0, 1000) &&
        validString(data.message, 1, 600) &&
        data.metadata is map &&
        validString(data.paymentProofId, 0, 160) &&
        data.priority in ['low', 'normal', 'high'] &&
        data.provider == 'firestore' &&
        validOptionalString(data, 'sentAt', 40) &&
        validString(data.source, 1, 80) &&
        data.status in ['pending', 'processing', 'sent', 'failed', 'cancelled'] &&
        data.targetMode in ['role', 'user'] &&
        data.targetRole in ['admin', 'client', 'none'] &&
        validString(data.targetUid, 0, 128) &&
        validString(data.title, 1, 180) &&
        data.type in [
          'booking_confirmed',
          'booking_message_created',
          'booking_rejected',
          'booking_request_created',
          'guard_attendance_submitted',
          'payment_proof_approved',
          'payment_proof_rejected',
          'payment_proof_submitted'
        ] &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.url, 0, 700) &&
        validOptionalString(data, 'lastAction', 80) &&
        validOptionalString(data, 'lastActionAt', 40) &&
        validOptionalString(data, 'lastActionByEmail', 254) &&
        validOptionalString(data, 'lastActionByRole', 40) &&
        validOptionalString(data, 'lastActionByUid', 128) &&
        validOptionalString(data, 'lastActionReason', 500) &&
        validOptionalString(data, 'lastActionRequestId', 160) &&
        validOptionalString(data, 'leaseExpiresAt', 40) &&
        validOptionalString(data, 'leaseId', 160) &&
        validOptionalString(data, 'providerNotificationId', 240);
    }

    function notificationEventActorMatches(data) {
      return data.actorUid == request.auth.uid &&
        (
          (data.actorRole == 'client' && isClientAccount()) ||
          (data.actorRole == 'admin' && isApprovedAdmin()) ||
          (data.actorRole == 'guard' && isStudioGuardAccount())
        );
    }

    function notificationEventCreateIsRecorded(data) {
      return data.status == 'sent' &&
        data.attempts == 0 &&
        data.errorMessage == '' &&
        validIsoTimestampString(data.sentAt) &&
        !data.keys().hasAny([
          'lastAction', 'lastActionAt', 'lastActionByEmail',
          'lastActionByRole', 'lastActionByUid', 'lastActionReason',
          'lastActionRequestId', 'leaseExpiresAt', 'leaseId',
          'providerNotificationId'
        ]);
    }

    function notificationEventTargetIsSafe(data) {
      return (
          data.targetMode == 'role' &&
          data.targetRole == 'admin' &&
          data.targetUid == '' &&
          data.actorRole in ['admin', 'client', 'guard']
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'client' &&
          data.targetUid.size() > 0 &&
          data.actorRole == 'admin'
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'admin' &&
          data.targetUid.size() > 0 &&
          data.actorRole == 'admin'
        );
    }

    match /notificationEvents/{eventId} {
      allow read: if isSignedIn() && (
        canAccessNotifications() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );

      allow create: if isSignedIn() &&
        validNotificationEvent(request.resource.data, eventId) &&
        notificationEventActorMatches(request.resource.data) &&
        notificationEventCreateIsRecorded(request.resource.data) &&
        notificationEventTargetIsSafe(request.resource.data);

      // Activity events are immutable after creation.
      allow update, delete: if false;
    }
    // <<< STUDIO37 NOTIFICATION EVENT RULES END

    function validProcurementSupplier(data, supplierId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'name', 'contactName', 'phone', 'email', 'address', 'notes',
          'status', 'createdAt', 'updatedAt', 'createdByUid', 'createdByName',
          'lastOperationId', 'lastOperationAction', 'lastEventId'
        ]) &&
        data.id == supplierId &&
        validString(data.name, 2, 160) &&
        validString(data.contactName, 0, 120) &&
        validString(data.phone, 0, 40) &&
        validString(data.email, 0, 160) &&
        validString(data.address, 0, 500) &&
        validString(data.notes, 0, 1000) &&
        data.status == 'active' &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        data.createdByUid == request.auth.uid &&
        validString(data.createdByName, 1, 120) &&
        validString(data.lastOperationId, 67, 67) &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.lastOperationAction == 'create' &&
        validString(data.lastEventId, 1, 160);
    }

    function validProcurementPurchaseOrder(data, purchaseOrderId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'poNumber', 'supplierId', 'supplierName', 'items',
          'totalAmount', 'paidAmount', 'status', 'orderDate', 'expectedAt',
          'notes', 'createdAt', 'updatedAt', 'createdByUid', 'createdByName',
          'approvedAt', 'approvedByUid', 'approvedByName', 'orderedAt',
          'cancelledAt', 'cancelReason', 'cancelledByUid', 'receivedAt',
          'lastOperationId', 'lastOperationAction', 'lastEventId', 'lastPaymentId', 'lastReceiptId'
        ]) &&
        data.id == purchaseOrderId &&
        validString(data.poNumber, 12, 64) &&
        validString(data.supplierId, 1, 160) &&
        validString(data.supplierName, 1, 160) &&
        data.items is list &&
        data.items.size() >= 1 &&
        data.items.size() <= 100 &&
        validNumber(data.totalAmount, 1, 1000000000000) &&
        validNumber(data.paidAmount, 0, 1000000000000) &&
        data.paidAmount <= data.totalAmount &&
        data.status in [
          'draft', 'submitted', 'approved', 'ordered',
          'partially_received', 'received', 'cancelled'
        ] &&
        validIsoDate(data.orderDate) &&
        (data.expectedAt == '' || validIsoDate(data.expectedAt)) &&
        validString(data.notes, 0, 1200) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.createdByUid, 1, 128) &&
        validString(data.createdByName, 1, 120) &&
        validOptionalString(data, 'approvedAt', 40) &&
        validOptionalString(data, 'approvedByUid', 128) &&
        validOptionalString(data, 'approvedByName', 120) &&
        validOptionalString(data, 'orderedAt', 40) &&
        validOptionalString(data, 'cancelledAt', 40) &&
        validOptionalString(data, 'cancelReason', 600) &&
        validOptionalString(data, 'cancelledByUid', 128) &&
        validOptionalString(data, 'receivedAt', 40) &&
        validString(data.lastOperationId, 67, 67) &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.lastOperationAction in ['create', 'transition', 'payment', 'receipt'] &&
        validString(data.lastEventId, 1, 160) &&
        validOptionalString(data, 'lastPaymentId', 160) &&
        validOptionalString(data, 'lastReceiptId', 160);
    }

    function validProcurementPayment(data, paymentId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'purchaseOrderId', 'poNumber', 'supplierId', 'supplierName',
          'amount', 'paymentMethod', 'date', 'reference', 'note',
          'actorUid', 'actorName', 'createdAt', 'operationId'
        ]) &&
        data.id == paymentId &&
        validString(data.purchaseOrderId, 1, 160) &&
        validString(data.poNumber, 12, 64) &&
        validString(data.supplierId, 1, 160) &&
        validString(data.supplierName, 1, 160) &&
        validNumber(data.amount, 1, 1000000000) &&
        data.paymentMethod in ['cash', 'transfer', 'qris'] &&
        validIsoDate(data.date) &&
        validString(data.reference, 0, 120) &&
        validString(data.note, 0, 800) &&
        data.actorUid == request.auth.uid &&
        validString(data.actorName, 1, 120) &&
        validIsoTimestampString(data.createdAt) &&
        data.operationId is string &&
        data.operationId.size() == 67 &&
        data.operationId.matches('^v1_[a-f0-9]{64}$');
    }

    function procurementPaymentEventMatchesAfter(data) {
      let poPath = /databases/$(database)/documents/purchaseOrders/$(data.entityId);
      let poExists = existsAfter(poPath);
      let po = poExists ? getAfter(poPath).data : {};
      let paymentPath = /databases/$(database)/documents/procurementPayments/$(data.paymentId);
      let paymentExists = existsAfter(paymentPath);
      let payment = paymentExists ? getAfter(paymentPath).data : {};
      return poExists && paymentExists &&
        po.lastEventId == data.id &&
        po.lastPaymentId == data.paymentId &&
        po.lastOperationId == data.operationId &&
        po.lastOperationAction == 'payment' &&
        po.updatedAt == data.createdAt &&
        payment.id == data.paymentId &&
        payment.purchaseOrderId == data.entityId &&
        payment.amount == data.amount &&
        payment.operationId == data.operationId &&
        payment.actorUid == request.auth.uid;
    }

    function procurementPaymentCreateAllowed(paymentId) {
      let data = request.resource.data;
      let poPath = /databases/$(database)/documents/purchaseOrders/$(data.purchaseOrderId);
      let poExists = existsAfter(poPath);
      let po = poExists ? getAfter(poPath).data : {};
      let expensePath = /databases/$(database)/documents/bookkeepingEntries/$(paymentId);
      let expenseExists = existsAfter(expensePath);
      let expense = expenseExists ? getAfter(expensePath).data : {};
      return hasProcurementBookkeepingPermission() &&
        validProcurementPayment(data, paymentId) &&
        poExists &&
        po.status in ['submitted', 'approved', 'ordered', 'partially_received', 'received'] &&
        po.lastPaymentId == paymentId &&
        po.lastOperationId == data.operationId &&
        po.lastOperationAction == 'payment' &&
        po.updatedAt == data.createdAt &&
        po.paidAmount >= data.amount &&
        expenseExists &&
        expense.id == paymentId &&
        expense.source == 'procurement-payment' &&
        expense.sourceProcurementPaymentId == paymentId &&
        expense.amount == data.amount &&
        expense.operationId == data.operationId;
    }

    function validProcurementEvent(data, eventId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'entityType', 'entityId', 'action', 'fromStatus', 'toStatus',
          'reason', 'actorUid', 'actorName', 'createdAt', 'amount', 'paymentId',
          'operationId', 'purchaseOrderId', 'items'
        ]) &&
        data.id == eventId &&
        data.entityType in ['supplier', 'purchase_order', 'goods_receipt'] &&
        validString(data.entityId, 1, 160) &&
        data.action in ['created', 'status_changed', 'payment_recorded', 'received'] &&
        validOptionalString(data, 'paymentId', 160) &&
        validOptionalString(data, 'purchaseOrderId', 160) &&
        (!data.keys().hasAny(['items']) || data.items is list) &&
        validString(data.get('fromStatus', ''), 0, 40) &&
        validString(data.get('toStatus', ''), 0, 40) &&
        validString(data.get('reason', ''), 0, 600) &&
        data.actorUid == request.auth.uid &&
        validString(data.actorName, 1, 120) &&
        validIsoTimestampString(data.createdAt) &&
        (!data.keys().hasAny(['amount']) || validNumber(data.amount, 1, 1000000000000)) &&
        validString(data.operationId, 67, 67) &&
        data.operationId.matches('^v1_[a-f0-9]{64}$');
    }

    function procurementSupplierEventMatchesAfter(data) {
      let eventPath = /databases/$(database)/documents/procurementEvents/$(data.lastEventId);
      let eventExists = existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      return eventExists &&
        event.id == data.lastEventId &&
        event.entityType == 'supplier' &&
        event.entityId == data.id &&
        event.action == 'created' &&
        event.actorUid == request.auth.uid &&
        event.operationId == data.lastOperationId &&
        event.createdAt == data.createdAt;
    }

    function procurementPurchaseOrderEventMatchesAfter(data) {
      let eventPath = /databases/$(database)/documents/procurementEvents/$(data.lastEventId);
      let eventExists = existsAfter(eventPath);
      let event = eventExists ? getAfter(eventPath).data : {};
      return eventExists &&
        event.id == data.lastEventId &&
        event.entityType == 'purchase_order' &&
        event.entityId == data.id &&
        event.actorUid == request.auth.uid &&
        event.operationId == data.lastOperationId &&
        event.createdAt == data.updatedAt &&
        (
          (
            data.lastOperationAction == 'create' &&
            event.action == 'created' &&
            event.fromStatus == '' &&
            event.toStatus == 'draft'
          ) ||
          (
            data.lastOperationAction == 'transition' &&
            event.action == 'status_changed' &&
            event.fromStatus == resource.data.status &&
            event.toStatus == data.status &&
            (data.status != 'cancelled' || event.reason == data.cancelReason)
          )
        );
    }

    function procurementSupplierCreateAllowed(supplierId) {
      let data = request.resource.data;
      return hasApprovedAdminPermission('inventory') &&
        validProcurementSupplier(data, supplierId) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'procurement',
          'supplier-create',
          'suppliers',
          supplierId
        ) &&
        procurementSupplierEventMatchesAfter(data);
    }

    function procurementPurchaseOrderCreateAllowed(purchaseOrderId) {
      let data = request.resource.data;
      let supplierPath = /databases/$(database)/documents/suppliers/$(data.supplierId);
      let supplierExists = exists(supplierPath);
      let supplier = supplierExists ? get(supplierPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        validProcurementPurchaseOrder(data, purchaseOrderId) &&
        data.status == 'draft' &&
        data.paidAmount == 0 &&
        data.createdByUid == request.auth.uid &&
        validString(data.createdByName, 1, 120) &&
        data.lastOperationAction == 'create' &&
        supplierExists &&
        supplier.status == 'active' &&
        supplier.name == data.supplierName &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'procurement',
          'purchase-order-create',
          'purchaseOrders',
          purchaseOrderId
        ) &&
        procurementPurchaseOrderEventMatchesAfter(data);
    }

    function procurementPurchaseOrderTransitionUpdateAllowed(purchaseOrderId, data) {
      let nextStatusAllowed = (
        resource.data.status == 'draft' && data.status in ['submitted', 'cancelled']
      ) || (
        resource.data.status == 'submitted' && data.status in ['approved', 'cancelled']
      ) || (
        resource.data.status == 'approved' && data.status in ['ordered', 'cancelled']
      );
      return hasApprovedAdminPermission('inventory') &&
        data.id == purchaseOrderId &&
        nextStatusAllowed &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'updatedAt', 'approvedAt', 'approvedByUid', 'approvedByName',
          'orderedAt', 'cancelledAt', 'cancelReason', 'cancelledByUid',
          'lastOperationId', 'lastOperationAction', 'lastEventId'
        ]) &&
        validIsoTimestampString(data.updatedAt) &&
        data.updatedAt != resource.data.updatedAt &&
        data.lastOperationId is string &&
        data.lastOperationId.size() == 67 &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.lastOperationId != resource.data.lastOperationId &&
        data.lastOperationAction == 'transition' &&
        validString(data.lastEventId, 1, 160) &&
        (
          data.status != 'approved' ||
          (
            data.approvedAt == data.updatedAt &&
            data.approvedByUid == request.auth.uid &&
            validString(data.approvedByName, 1, 120)
          )
        ) &&
        (
          data.status != 'ordered' ||
          data.orderedAt == data.updatedAt
        ) &&
        (
          data.status != 'cancelled' ||
          (
            resource.data.paidAmount == 0 &&
            data.cancelReason is string &&
            data.cancelReason.size() >= 4 &&
            data.cancelReason.size() <= 600 &&
            data.cancelledByUid == request.auth.uid &&
            data.cancelledAt == data.updatedAt
          )
        ) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'procurement',
          'purchase-order-transition',
          'purchaseOrders',
          purchaseOrderId
        ) &&
        procurementPurchaseOrderEventMatchesAfter(data);
    }

    function procurementPurchaseOrderPaymentUpdateAllowed(purchaseOrderId, data) {
      let paymentId = data.get('lastPaymentId', '');
      let paymentPath = /databases/$(database)/documents/procurementPayments/$(paymentId);
      let paymentExists = paymentId != '' && existsAfter(paymentPath);
      let payment = paymentExists ? getAfter(paymentPath).data : {};
      let eventPath = /databases/$(database)/documents/procurementEvents/$(data.lastEventId);
      let eventExists = existsAfter(eventPath);
      return hasProcurementBookkeepingPermission() &&
        data.id == purchaseOrderId &&
        data.totalAmount is number &&
        data.paidAmount is number &&
        resource.data.status in ['submitted', 'approved', 'ordered', 'partially_received', 'received'] &&
        data.status == resource.data.status &&
        data.diff(resource.data).affectedKeys().hasOnly([
          'paidAmount', 'updatedAt', 'lastOperationId', 'lastOperationAction',
          'lastEventId', 'lastPaymentId'
        ]) &&
        validIsoTimestampString(data.updatedAt) &&
        data.updatedAt != resource.data.updatedAt &&
        paymentExists &&
        payment.id == data.lastPaymentId &&
        payment.purchaseOrderId == purchaseOrderId &&
        payment.actorUid == request.auth.uid &&
        payment.operationId == data.lastOperationId &&
        payment.createdAt == data.updatedAt &&
        payment.amount > 0 &&
        data.paidAmount == resource.data.paidAmount + payment.amount &&
        data.paidAmount <= data.totalAmount &&
        eventExists &&
        data.lastOperationId != resource.data.lastOperationId &&
        data.lastOperationAction == 'payment' &&
        validString(data.lastEventId, 1, 160) &&
        validString(data.lastPaymentId, 1, 160) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'procurement',
          'procurement-payment',
          'purchaseOrders',
          purchaseOrderId
        );
    }

    function procurementPurchaseOrderUpdateAllowed(purchaseOrderId) {
      let data = request.resource.data;
      return data.lastOperationAction == 'transition'
        ? procurementPurchaseOrderTransitionUpdateAllowed(purchaseOrderId, data)
        : data.lastOperationAction == 'payment'
          ? procurementPurchaseOrderPaymentUpdateAllowed(purchaseOrderId, data)
          : data.lastOperationAction == 'receipt'
            ? procurementPurchaseOrderReceiptUpdateAllowed(purchaseOrderId, data)
            : false;
    }

    function procurementEventSupplierMatchesAfter(data) {
      let supplierPath = /databases/$(database)/documents/suppliers/$(data.entityId);
      let supplierExists = existsAfter(supplierPath);
      let supplier = supplierExists ? getAfter(supplierPath).data : {};
      return supplierExists &&
        supplier.lastEventId == data.id &&
        supplier.lastOperationId == data.operationId &&
        supplier.id == data.entityId &&
        supplier.status == 'active' &&
        supplier.createdAt == data.createdAt;
    }

    function procurementEventPurchaseOrderMatchesAfter(data) {
      let poPath = /databases/$(database)/documents/purchaseOrders/$(data.entityId);
      let poExists = existsAfter(poPath);
      let po = poExists ? getAfter(poPath).data : {};
      return poExists &&
        po.lastEventId == data.id &&
        po.lastOperationId == data.operationId &&
        po.id == data.entityId &&
        po.status == data.get('toStatus', '') &&
        po.updatedAt == data.createdAt &&
        po.lastOperationAction == (data.action == 'created' ? 'create' : 'transition');
    }

    function procurementGoodsReceiptEventMatchesAfter(data) {
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(data.entityId);
      let receiptExists = existsAfter(receiptPath);
      let receipt = receiptExists ? getAfter(receiptPath).data : {};
      return receiptExists &&
        receipt.id == data.entityId &&
        receipt.eventId == data.id &&
        receipt.operationId == data.operationId &&
        receipt.purchaseOrderId == data.purchaseOrderId &&
        receipt.items == data.items &&
        receipt.receivedByUid == request.auth.uid &&
        receipt.receivedAt == data.createdAt;
    }

    function procurementGoodsReceiptCreateAllowed(receiptId) {
      let data = request.resource.data;
      let poPath = /databases/$(database)/documents/purchaseOrders/$(data.purchaseOrderId);
      let poExists = existsAfter(poPath);
      let po = poExists ? getAfter(poPath).data : {};
      return hasApprovedAdminPermission('inventory') &&
        data is map &&
        data.keys().hasOnly([
          'id', 'purchaseOrderId', 'poNumber', 'supplierId', 'supplierName',
          'items', 'note', 'receivedAt', 'receivedByUid', 'receivedByName',
          'createdAt', 'operationId', 'eventId', 'payloadHash'
        ]) &&
        data.id == receiptId &&
        validString(data.purchaseOrderId, 1, 160) &&
        validString(data.poNumber, 12, 64) &&
        validString(data.supplierId, 1, 160) &&
        validString(data.supplierName, 1, 160) &&
        data.items is list &&
        data.items.size() >= 1 &&
        data.items.size() <= 5 &&
        validString(data.note, 0, 800) &&
        validIsoTimestampString(data.receivedAt) &&
        data.receivedByUid == request.auth.uid &&
        validString(data.receivedByName, 1, 120) &&
        data.createdAt == data.receivedAt &&
        data.operationId is string &&
        data.operationId.matches('^v1_[a-f0-9]{64}$') &&
        data.payloadHash is string &&
        data.payloadHash.matches('^[a-f0-9]{64}$') &&
        validString(data.eventId, 1, 160) &&
        poExists &&
        po.lastReceiptId == receiptId &&
        po.lastEventId == data.eventId &&
        po.lastOperationId == data.operationId &&
        po.lastOperationAction == 'receipt' &&
        po.updatedAt == data.receivedAt &&
        po.status in ['partially_received', 'received'];
    }

    function procurementPurchaseOrderReceiptUpdateAllowed(purchaseOrderId, data) {
      let receiptId = data.get('lastReceiptId', '');
      let receiptPath = /databases/$(database)/documents/goodsReceipts/$(receiptId);
      let receiptExists = receiptId != '' && existsAfter(receiptPath);
      let receipt = receiptExists ? getAfter(receiptPath).data : {};
      let changed = data.diff(resource.data).affectedKeys();
      return hasApprovedAdminPermission('inventory') &&
        data.id == purchaseOrderId &&
        resource.data.status in ['ordered', 'partially_received'] &&
        data.status in ['partially_received', 'received'] &&
        data.items is list &&
        data.items.size() == resource.data.items.size() &&
        data.totalAmount == resource.data.totalAmount &&
        data.paidAmount == resource.data.paidAmount &&
        data.supplierId == resource.data.supplierId &&
        data.supplierName == resource.data.supplierName &&
        data.lastOperationAction == 'receipt' &&
        validString(data.lastOperationId, 67, 67) &&
        data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
        data.updatedAt != resource.data.updatedAt &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.lastEventId, 1, 160) &&
        changed.hasOnly([
          'items', 'status', 'updatedAt', 'receivedAt',
          'lastOperationId', 'lastOperationAction', 'lastEventId', 'lastReceiptId'
        ]) &&
        receiptExists &&
        receipt.id == receiptId &&
        receipt.purchaseOrderId == purchaseOrderId &&
        receipt.operationId == data.lastOperationId &&
        receipt.eventId == data.lastEventId &&
        receipt.receivedAt == data.updatedAt;
    }

    function procurementEventCreateAllowed(eventId) {
      let data = request.resource.data;
      return data.action == 'payment_recorded'
        ? hasProcurementBookkeepingPermission() &&
          validProcurementEvent(data, eventId) &&
          data.entityType == 'purchase_order' &&
          procurementPaymentEventMatchesAfter(data)
        : data.action == 'received'
          ? hasApprovedAdminPermission('inventory') &&
            validProcurementEvent(data, eventId) &&
            data.entityType == 'goods_receipt' &&
            procurementGoodsReceiptEventMatchesAfter(data)
          : hasApprovedAdminPermission('inventory') &&
            validProcurementEvent(data, eventId) &&
            (
              (
                data.entityType == 'supplier' &&
                data.action == 'created' &&
                procurementEventSupplierMatchesAfter(data)
              ) ||
              (
                data.entityType == 'purchase_order' &&
                data.action in ['created', 'status_changed'] &&
                procurementEventPurchaseOrderMatchesAfter(data)
              )
            );
    }

    // Supplier, PO, Goods Receipt, and payment lifecycle writes use direct Firestore transactions.
