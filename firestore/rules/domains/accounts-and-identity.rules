match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        validUser(request.resource.data, userId) &&
        authIdentityMatches(request.resource.data) &&
        isSafeAccountSelfCreate(request.resource.data);
      allow update: if validUser(request.resource.data, userId) && (
        (
          isOwner() &&
          request.resource.data.role == resource.data.role
        ) || (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'preferences', 'updatedAt'])
        ) || isSafeAdminRequestToClientTransition(userId)
      );
      // Account deletion and ownership transitions are protected server jobs.
      allow delete: if false;
    }


    function canAccessOwnRepositoryOperations(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let profileExists = exists(userPath);
      let profile = profileExists ? get(userPath).data : {};
      return isSignedIn() &&
        request.auth.uid == userId &&
        profileExists &&
        (
          (profile.role == 'owner' && isOwner()) ||
          (profile.role == 'admin' && profile.status == 'approved') ||
          (profile.role == 'client' && profile.status == 'active') ||
          (profile.role == 'studio_guard' && profile.status == 'approved')
        );
    }

    function validRepositoryOperation(data, operationId) {
      return data is map &&
        data.keys().hasOnly([
          'operationId', 'actorUid', 'scope', 'action', 'requestId',
          'payloadHash', 'resultCollection', 'resultId', 'createdAt'
        ]) &&
        data.operationId == operationId &&
        operationId.matches('^v1_[a-f0-9]{64}$') &&
        data.actorUid == request.auth.uid &&
        data.scope.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.action.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.requestId.matches('^[A-Za-z0-9._:-]{8,128}$') &&
        data.payloadHash.matches('^[a-f0-9]{64}$') &&
        data.resultCollection is string &&
        data.resultId is string &&
        (
          (data.resultCollection == '' && data.resultId == '') ||
          (
            data.resultCollection.matches('^[A-Za-z][A-Za-z0-9_]{0,63}$') &&
            data.resultId.matches('^[^/]{1,160}$')
          )
        ) &&
        data.createdAt == request.time;
    }

    function maintenanceOperationMarkerMatches(data) {
      let workOrderPath = /databases/$(database)/documents/maintenanceWorkOrders/$(data.resultId);
      let workOrderExists = existsAfter(workOrderPath);
      let workOrder = workOrderExists ? getAfter(workOrderPath).data : {};
      let expectedAction = data.action == 'waiting-parts' ? 'waiting_parts' : data.action;
      return data.resultCollection == 'maintenanceWorkOrders' &&
        data.action in [
          'report', 'triage', 'approve', 'assign', 'start', 'waiting-parts',
          'resume', 'complete', 'verify', 'cancel', 'reopen', 'cost'
        ] &&
        workOrderExists &&
        workOrder.id == data.resultId &&
        workOrder.lastOperationId == data.operationId &&
        workOrder.lastOperationAction == expectedAction &&
        validString(workOrder.lastEventId, 1, 160);
    }

    function repositoryOperationDomainMatches(data) {
      return (
        data.scope != 'customer-follow-up' ||
        customerFollowUpOperationMarkerMatches(data)
      ) && (
        data.scope != 'maintenance' ||
        maintenanceOperationMarkerMatches(data)
      );
    }

    function customerFollowUpOperationMarkerMatches(data) {
      let taskPath = /databases/$(database)/documents/customerFollowUpTasks/$(data.resultId);
      let taskExists = exists(taskPath);
      let task = taskExists ? get(taskPath).data : {};
      return data.action in ['create', 'update'] &&
        data.resultCollection == 'customerFollowUpTasks' &&
        taskExists &&
        task.id == data.resultId &&
        task.lastOperationId == data.operationId &&
        task.lastOperationAction == data.action &&
        task.lastOperationPayloadHash == data.payloadHash;
    }

    match /users/{userId}/repositoryOperations/{operationId} {
      allow read: if canAccessOwnRepositoryOperations(userId);
      allow create: if canAccessOwnRepositoryOperations(userId) &&
        validRepositoryOperation(request.resource.data, operationId) &&
        repositoryOperationDomainMatches(request.resource.data);
      allow update, delete: if false;
    }

    match /adminControl/ownership {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !ownershipControlExists() &&
        request.resource.data.keys().hasOnly(['currentOwnerUid', 'initializedAt', 'updatedAt']) &&
        request.resource.data.currentOwnerUid == request.auth.uid &&
        validIsoTimestampString(request.resource.data.initializedAt) &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved' &&
        (
          isBootstrapOwnerEmail() ||
          (userDocExists() && getUserData().role == 'owner' && getUserData().status == 'approved')
        );
      allow update, delete: if false;
    }

    function isClientBookingOwner(data) {
      return isClientAccount() && (
        (data.clientUid is string && data.clientUid == request.auth.uid) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) ||
        (
          'phone_number' in request.auth.token &&
          request.auth.token.phone_number is string &&
          (
            (data.phone is string && (
              data.phone == request.auth.token.phone_number ||
              ('+' + data.phone) == request.auth.token.phone_number
            )) ||
            (data.customerPhoneKey is string && (
              data.customerPhoneKey == request.auth.token.phone_number ||
              ('+' + data.customerPhoneKey) == request.auth.token.phone_number
            ))
          )
        )
      );
    }

    function validBooking(data) {
      return validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.total, 0, 100000000) &&
        data.paymentStatus in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        data.status in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        validOptionalString(data, 'email', 254) &&
        validOptionalString(data, 'clientUid', 128) &&
        validOptionalString(data, 'title', 160) &&
        validOptionalString(data, 'sessionLabel', 160) &&
        validOptionalString(data, 'clientRequestNote', 600) &&
        validOptionalString(data, 'clientRequestUpdatedAt', 40) &&
        validOptionalString(data, 'adminResponseNote', 600) &&
        validOptionalString(data, 'adminResponseAt', 40) &&
        validOptionalString(data, 'lastMessageId', 128) &&
        validOptionalString(data, 'lastMessageAt', 40) &&
        validOptionalString(data, 'lastMessagePreview', 180) &&
        (!data.keys().hasAny(['bookingRequestStatus']) || data.bookingRequestStatus in ['submitted', 'confirmed', 'rejected', 'cancellation_requested', 'cancelled']) &&
        (!data.keys().hasAny(['lastMessageSenderRole']) || data.lastMessageSenderRole in ['admin', 'client']) &&
        (!data.keys().hasAny(['lastMessageReadByAdmin']) || data.lastMessageReadByAdmin is bool) &&
        (!data.keys().hasAny(['lastMessageReadByClient']) || data.lastMessageReadByClient is bool) &&
        (!data.keys().hasAny(['paymentHistory']) || (data.paymentHistory is list && data.paymentHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundHistory']) || (data.refundHistory is list && data.refundHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundedAmount']) || validNumber(data.refundedAmount, 0, 100000000)) &&
        (!data.keys().hasAny(['refundStatus']) || data.refundStatus in ['partial', 'full']) &&
        validOptionalString(data, 'lastRefundAt', 40) &&
        validOptionalString(data, 'lastRefundMethod', 40) &&
        validOptionalString(data, 'lastRefundReason', 600) &&
        validOptionalString(data, 'refundCompletedAt', 40) &&
        validOptionalString(data, 'paymentStatusBeforeRefund', 40) &&
        validOptionalString(data, 'invoiceStatus', 40) &&
        validOptionalString(data, 'paymentStatusCanonical', 40) &&
        validOptionalString(data, 'lastFinanceAction', 40) &&
        validOptionalString(data, 'lastFinanceBusinessDate', 10) &&
        validOptionalString(data, 'lastFinanceEventId', 180) &&
        validOptionalString(data, 'lastFinanceLedgerEntryId', 160) &&
        validOptionalString(data, 'lastFinanceOperationId', 80) &&
        validOptionalString(data, 'lastFinanceProofId', 160) &&
        validOptionalString(data, 'voidedAt', 40) &&
        validOptionalString(data, 'voidedByName', 120) &&
        validOptionalString(data, 'voidedByUid', 128) &&
        validOptionalString(data, 'voidReason', 600) &&
        (!data.keys().hasAny(['appliedDiscounts']) || (data.appliedDiscounts is list && data.appliedDiscounts.size() <= 50));
    }

    function adminBookingFinanceFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paymentHistory', 'refundHistory', 'paymentStatus', 'status',
          'paymentStatusCanonical', 'invoiceStatus', 'invoiceAmount',
          'paidAmount', 'dpAmount', 'refundedAmount', 'refundStatus',
          'lastPaymentAt', 'lastPaymentMethod', 'lastRefundAt',
          'lastRefundMethod', 'lastRefundReason', 'refundCompletedAt',
          'paymentStatusBeforeRefund', 'voidReason', 'voidedAt',
          'lastFinanceAction', 'lastFinanceBusinessDate', 'lastFinanceEventId',
          'lastFinanceLedgerEntryId', 'lastFinanceOperationId', 'lastFinanceProofId',
          'voidedByName', 'voidedByUid', 'paymentMethod', 'total',
          'subtotal', 'discountAmount', 'appliedDiscounts',
          'bookingCode', 'bookingId', 'invoiceNumber'
        ]);
    }

    function validClientMessageSummary(data) {
      return validString(data.lastMessageId, 1, 128) &&
        validIsoTimestampString(data.lastMessageAt) &&
        validString(data.lastMessagePreview, 1, 180) &&
        data.lastMessageSenderRole == 'client' &&
        data.lastMessageReadByAdmin == false &&
        data.lastMessageReadByClient == true;
    }

    function clientMessageExistsAfter(bookingId) {
      let messageId = request.resource.data.lastMessageId;
      let messagePath = /databases/$(database)/documents/bookingMessages/$(messageId);
      return existsAfter(messagePath) &&
        getAfter(messagePath).data.bookingId == bookingId &&
        getAfter(messagePath).data.clientUid == request.auth.uid &&
        getAfter(messagePath).data.senderUid == request.auth.uid &&
        getAfter(messagePath).data.senderRole == 'client';
    }

    function clientSendsBookingMessage(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId);
    }

    function clientRequestsBookingCancellation(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bookingRequestStatus', 'clientRequestNote', 'clientRequestUpdatedAt',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        resource.data.bookingRequestStatus in ['submitted', 'confirmed'] &&
        request.resource.data.bookingRequestStatus == 'cancellation_requested' &&
        validString(request.resource.data.clientRequestNote, 1, 600) &&
        validIsoTimestampString(request.resource.data.clientRequestUpdatedAt) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId) &&
        getAfter(/databases/$(database)/documents/bookingMessages/$(request.resource.data.lastMessageId)).data.type == 'cancellation';
    }

    function clientMarksLatestMessageRead() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageReadByClient']) &&
        resource.data.lastMessageSenderRole == 'admin' &&
        request.resource.data.lastMessageReadByClient == true;
    }

    function clientCreateIdentityMatches(data) {
      return isSignedIn() &&
        data.clientUid is string &&
        data.clientUid == request.auth.uid &&
        data.customerId is string &&
        data.customerId == ('auth_' + request.auth.uid) &&
        (
          !data.keys().hasAny(['email']) ||
          data.email == '' ||
          (
            request.auth.token.email is string &&
            data.email is string &&
            data.email.lower() == request.auth.token.email.lower()
          )
        );
    }

    function isSafeClientBookingRequestCreate(data, documentId) {
      return data.keys().hasOnly([
          'id', 'customer', 'phone', 'customerPhoneKey', 'email', 'clientUid',
          'customerId', 'source', 'bookingRequestStatus', 'clientRequestUpdatedAt',
          'packageId', 'packageLabel', 'pricingMode', 'sessionType', 'sessionLabel',
          'recordingTypeId', 'recordingTypeLabel', 'title', 'date', 'startHour',
          'startTimeLabel', 'durationHours', 'paymentMethod', 'paymentHistory',
          'paidAmount', 'lastPaymentAt', 'lastPaymentMethod', 'paymentStatus',
          'status', 'subtotal', 'discountAmount', 'appliedDiscounts', 'total',
          'dpAmount', 'invoiceAmount', 'createdAt', 'updatedAt', 'bookingCode',
          'bookingId', 'invoiceNumber'
        ]) &&
        data.id == documentId &&
        clientCreateIdentityMatches(data) &&
        data.source == 'clientPortal' &&
        data.bookingRequestStatus == 'submitted' &&
        data.paymentStatus == 'pending' &&
        data.status == 'pending' &&
        validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.customerPhoneKey, 0, 32) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.customerId, 1, 160) &&
        validString(data.bookingId, 1, 120) &&
        validString(data.bookingCode, 1, 120) &&
        validString(data.invoiceNumber, 1, 120) &&
        validString(data.title, 1, 160) &&
        validString(data.sessionLabel, 1, 160) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.subtotal, 0, 100000000) &&
        validNumber(data.discountAmount, 0, 100000000) &&
        validNumber(data.total, 0, 100000000) &&
        data.invoiceAmount == data.total &&
        data.paidAmount == 0 &&
        data.dpAmount == 0 &&
        data.paymentHistory is list &&
        data.paymentHistory.size() == 0 &&
        (!data.keys().hasAny(['appliedDiscounts']) || data.appliedDiscounts is list) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        (
          !data.keys().hasAny(['clientRequestUpdatedAt']) ||
          validIsoTimestampString(data.clientRequestUpdatedAt)
        );
    }

    function bookingScheduleDayMatchesAfter(dateId, bookingId, updatedAt) {
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(dateId);
      let dayAfter = getAfter(dayPath).data;
      return existsAfter(dayPath) &&
        dayAfter.date == dateId &&
        dayAfter.lastBookingId == bookingId &&
        dayAfter.updatedAt == updatedAt;
    }

    function validBookingScheduleDay(data, dateId) {
      return data.keys().hasOnly(['date', 'lastBookingId', 'revision', 'updatedAt']) &&
        data.date == dateId &&
        validIsoDate(data.date) &&
        validString(data.lastBookingId, 1, 160) &&
        data.revision is int &&
        data.revision >= 1 &&
        validIsoTimestampString(data.updatedAt);
    }

    function validCalendarSlot(data) {
      return data.keys().hasOnly([
          'bookingId', 'date', 'durationHours', 'sessionLabel',
          'startHour', 'status', 'title', 'updatedAt'
        ]) &&
        validString(data.title, 1, 80);
    }

    function bookingIsScheduleBlocking(data) {
      return (
          !data.keys().hasAny(['bookingRequestStatus']) ||
          !(data.bookingRequestStatus in ['submitted', 'rejected', 'cancelled', 'void'])
        ) &&
        (
          !data.keys().hasAny(['requestStatus']) ||
          !(data.requestStatus in ['submitted', 'rejected', 'cancelled', 'canceled', 'deleted', 'void'])
        ) &&
        (
          !data.keys().hasAny(['sessionStatus']) ||
          !(data.sessionStatus in ['cancelled', 'canceled', 'rejected', 'deleted', 'void'])
        ) &&
        !(data.status in ['cancelled', 'canceled', 'rejected', 'deleted', 'void']) &&
        !(data.paymentStatus in ['cancelled', 'canceled', 'rejected', 'deleted', 'void']);
    }

    function bookingRequiresPublicSlot(data) {
      return data.durationHours is number &&
        data.durationHours > 0 &&
        bookingIsScheduleBlocking(data);
    }

    function bookingCalendarSlotFieldsMatchAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let slotAfter = getAfter(slotPath).data;
      return existsAfter(slotPath) &&
        validCalendarSlot(slotAfter) &&
        slotAfter.bookingId == bookingId &&
        slotAfter.date == data.date &&
        slotAfter.durationHours == data.durationHours &&
        slotAfter.startHour == data.startHour &&
        slotAfter.sessionLabel == data.sessionLabel &&
        (
          slotAfter.title == 'Terisi' ||
          slotAfter.title == data.sessionLabel
        ) &&
        slotAfter.status == data.paymentStatus &&
        slotAfter.updatedAt == data.updatedAt;
    }

    function bookingCalendarSlotMatchesAfter(bookingId, data) {
      return bookingCalendarSlotFieldsMatchAfter(bookingId, data) &&
        bookingScheduleDayMatchesAfter(data.date, bookingId, data.updatedAt);
    }

    function bookingSlotStateMatchesAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      return bookingRequiresPublicSlot(data)
        ? bookingCalendarSlotFieldsMatchAfter(bookingId, data)
        : !existsAfter(slotPath);
    }

    function validManualInitialPaymentRecord(payment, bookingData) {
      return payment is map &&
        payment.keys().hasOnly([
          'actorName', 'actorUid', 'amount', 'createdAt', 'date',
          'id', 'idempotencyKey', 'method', 'note', 'source'
        ]) &&
        validString(payment.actorName, 1, 120) &&
        payment.actorName == bookingData.initialPaymentIntent.actorName &&
        payment.actorUid == bookingData.initialPaymentIntent.actorUid &&
        validNumber(payment.amount, 1, bookingData.total) &&
        payment.createdAt == bookingData.createdAt &&
        payment.date == bookingData.createdAt[0:10] &&
        validString(payment.id, 1, 80) &&
        validString(payment.idempotencyKey, 8, 128) &&
        payment.method in ['cash', 'transfer', 'qris', 'other'] &&
        validString(payment.note, 0, 600) &&
        payment.source == 'manual-booking-create';
    }

    function validManualBookingCreate(data, bookingId) {
      return data.keys().hasAll(['initialPaymentLedgerStatus', 'initialPaymentIntent']) &&
        data.keys().hasOnly([
          'appliedDiscounts', 'bandName', 'bookingCode', 'bookingId',
          'bookingRequestStatus', 'clientUid', 'createdAt', 'customer',
          'customerId', 'customerIdentityMode', 'customerPhoneKey', 'date',
          'discountAmount', 'dpAmount', 'durationHours', 'email', 'id',
          'initialPaymentIntent', 'initialPaymentLedgerStatus', 'invoiceAmount',
          'invoiceNumber', 'lastPaymentAt', 'lastPaymentMethod', 'packageId',
          'packageLabel', 'paidAmount', 'paymentHistory', 'paymentMethod',
          'paymentStatus', 'paymentStatusCanonical', 'phone', 'pricingMode',
          'recordingTypeId', 'recordingTypeLabel', 'refundHistory', 'refundedAmount',
          'sessionLabel', 'sessionStatus', 'sessionType', 'source', 'startHour',
          'startTimeLabel', 'status', 'subtotal', 'title', 'total', 'updatedAt'
        ]) &&
        data.id == bookingId &&
        validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0.5, 24) &&
        validNumber(data.total, 0, 100000000) &&
        (!data.keys().hasAny(['email']) || validString(data.email, 0, 254)) &&
        (!data.keys().hasAny(['clientUid']) || validString(data.clientUid, 0, 128)) &&
        (!data.keys().hasAny(['title']) || validString(data.title, 0, 160)) &&
        data.source == 'admin' &&
        data.bookingRequestStatus == 'confirmed' &&
        data.sessionStatus == 'scheduled' &&
        data.status == 'pending' &&
        data.bookingRequestStatus == 'confirmed' &&
        validString(data.bookingCode, 1, 120) &&
        data.bookingId == data.bookingCode &&
        validString(data.invoiceNumber, 1, 120) &&
        validString(data.pricingMode, 1, 40) &&
        validString(data.sessionType, 1, 80) &&
        validString(data.sessionLabel, 1, 160) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validNumber(data.subtotal, 0, 100000000) &&
        validNumber(data.discountAmount, 0, 100000000) &&
        data.invoiceAmount == data.total &&
        data.refundHistory is list &&
        data.refundHistory.size() == 0 &&
        data.refundedAmount == 0 &&
        data.paymentHistory is list &&
        data.paymentHistory.size() == 0 &&
        data.paymentStatus == 'pending' &&
        data.paymentStatusCanonical == 'unpaid' &&
        data.paymentMethod == '' &&
        data.lastPaymentAt == '' &&
        data.lastPaymentMethod == '' &&
        data.paidAmount == 0 &&
        data.dpAmount == 0 &&
        (
          (
            data.initialPaymentIntent == null &&
            data.initialPaymentLedgerStatus == 'not_required'
          ) ||
          (
            data.initialPaymentIntent is map &&
            data.initialPaymentIntent.keys().hasOnly([
              'actorName', 'actorUid', 'amount', 'createdAt', 'date',
              'id', 'idempotencyKey', 'method', 'note', 'source'
            ]) &&
            data.initialPaymentIntent.actorUid == request.auth.uid &&
            data.initialPaymentIntent.actorName is string &&
            data.initialPaymentIntent.amount is number &&
            data.initialPaymentIntent.amount > 0 &&
            data.initialPaymentIntent.amount <= data.total &&
            data.initialPaymentIntent.method in ['cash', 'transfer', 'qris', 'other'] &&
            data.initialPaymentIntent.createdAt == data.createdAt &&
            data.initialPaymentIntent.date == data.createdAt[0:10] &&
            data.initialPaymentLedgerStatus == 'pending'
          )
        );
    }

    function bookingManualCreateCompanionsAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(data.date);
      let slotAfter = getAfter(slotPath).data;
      let dayAfter = getAfter(dayPath).data;
      return data.durationHours > 0
        ? (
            existsAfter(slotPath) &&
            slotAfter.bookingId == bookingId &&
            slotAfter.date == data.date &&
            slotAfter.updatedAt == data.updatedAt &&
            existsAfter(dayPath) &&
            dayAfter.date == data.date &&
            dayAfter.lastBookingId == bookingId &&
            dayAfter.updatedAt == data.updatedAt
          )
        : !existsAfter(slotPath);
    }

    function adminBookingManualUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let scheduleChanged = changed.hasAny([
        'date', 'startHour', 'durationHours', 'duration', 'sessionLabel'
      ]);
      return changed.hasOnly([
          'bandName', 'clientUid', 'customer', 'customerId',
          'customerIdentityMode', 'customerPhoneKey', 'date', 'duration',
          'durationHours', 'email', 'internalNotes', 'notes', 'packageId',
          'packageLabel', 'pricingMode', 'recordingTypeId', 'recordingTypeLabel',
          'sessionLabel', 'sessionType', 'startHour', 'startTimeLabel',
          'title', 'updatedAt'
        ]) &&
        validString(request.resource.data.customer, 1, 120) &&
        validString(request.resource.data.phone, 0, 32) &&
        validIsoDate(request.resource.data.date) &&
        validNumber(request.resource.data.startHour, 0, 23) &&
        validNumber(request.resource.data.durationHours, 0, 24) &&
        validOptionalString(request.resource.data, 'clientUid', 128) &&
        validOptionalString(request.resource.data, 'email', 254) &&
        validOptionalString(request.resource.data, 'title', 160) &&
        validOptionalString(request.resource.data, 'sessionLabel', 160) &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        (
          !scheduleChanged ||
          (
            (
              resource.data.date == request.resource.data.date
                ? bookingScheduleDayMatchesAfter(request.resource.data.date, bookingId, request.resource.data.updatedAt)
                : (
                    bookingScheduleDayMatchesAfter(resource.data.date, bookingId, request.resource.data.updatedAt) &&
                    bookingScheduleDayMatchesAfter(request.resource.data.date, bookingId, request.resource.data.updatedAt)
                  )
            ) &&
            bookingSlotStateMatchesAfter(bookingId, request.resource.data)
          )
        );
    }


    function repositoryOperationMatchesAfter(operationId, scope, action, resultCollection, resultId) {
      let markerPath = /databases/$(database)/documents/users/$(request.auth.uid)/repositoryOperations/$(operationId);
      let markerExists = existsAfter(markerPath);
      let markerAfter = markerExists ? getAfter(markerPath).data : {};
      return markerExists &&
        markerAfter.operationId == operationId &&
        markerAfter.actorUid == request.auth.uid &&
        markerAfter.scope == scope &&
        markerAfter.action == action &&
        markerAfter.resultCollection == resultCollection &&
        markerAfter.resultId == resultId;
    }

    function financeBookingNetPaid(data) {
      let status = data.get('paymentStatusCanonical', data.get('paymentStatus', ''));
      let paid = data.get('paidAmount', 0);
      let deposit = data.get('dpAmount', 0);
      let projectionPaid = paid is number && paid > 0
        ? paid
        : (deposit is number && deposit > 0 ? deposit : 0);
      let total = data.get('total', data.get('subtotal', 0));
      return status in ['void', 'refunded']
        ? 0
        : (status in ['paid', 'lunas'] && total is number && total > projectionPaid
          ? total
          : projectionPaid);
    }

    function financeBookingOutstanding(data, netPaid) {
      let total = data.get('total', -1);
      let subtotal = data.get('subtotal', -1);
      let invoiceTotal = total is number ? total : subtotal;
      return invoiceTotal is number && invoiceTotal >= 0
        ? (invoiceTotal > netPaid ? invoiceTotal - netPaid : 0)
        : data.get('invoiceAmount', 0);
    }

    function financeBookingPaymentUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let history = bookingAfter.paymentHistory;
      let event = history[history.size() - 1];
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(bookingAfter.lastFinanceLedgerEntryId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(bookingAfter.lastFinanceBusinessDate + '__main');
      let closingAfter = getAfter(closingPath).data;
      let currentPaid = financeBookingNetPaid(resource.data);
      let currentOutstanding = financeBookingOutstanding(resource.data, currentPaid);
      return changed.hasOnly([
          'paymentHistory', 'invoiceAmount', 'paidAmount', 'paymentStatus',
          'paymentStatusCanonical', 'dpAmount', 'lastPaymentAt',
          'lastPaymentMethod', 'updatedAt', 'lastFinanceAction',
          'lastFinanceBusinessDate', 'lastFinanceEventId',
          'lastFinanceLedgerEntryId', 'lastFinanceOperationId',
          'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.paymentStatus in ['dp', 'lunas'] &&
        bookingAfter.paymentStatusCanonical in ['partial', 'paid'] &&
        bookingAfter.paymentStatus == (bookingAfter.paymentStatusCanonical == 'paid' ? 'lunas' : 'dp') &&
        bookingAfter.dpAmount == (bookingAfter.paymentStatusCanonical == 'paid' ? 0 : bookingAfter.paidAmount) &&
        validIsoTimestampString(bookingAfter.updatedAt) &&
        bookingAfter.lastFinanceAction in ['payment', 'proof-approve'] &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        bookingAfter.lastFinanceOperationId is string &&
        bookingAfter.lastFinanceEventId is string &&
        bookingAfter.lastFinanceLedgerEntryId is string &&
        bookingAfter.lastFinanceProofId is string &&
        history is list &&
        history.size() == resource.data.get('paymentHistory', []).size() + 1 &&
        event.id == bookingAfter.lastFinanceEventId &&
        event.operationId == bookingAfter.lastFinanceOperationId &&
        event.ledgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        event.actorUid == request.auth.uid &&
        event.amount is number &&
        event.amount > 0 &&
        event.amount <= currentOutstanding &&
        bookingAfter.paidAmount == currentPaid + event.amount &&
        bookingAfter.invoiceAmount == currentOutstanding - event.amount &&
        event.date == bookingAfter.lastFinanceBusinessDate &&
        event.method in ['cash', 'transfer', 'qris', 'other'] &&
        existsAfter(ledgerPath) &&
        ledgerAfter.id == bookingAfter.lastFinanceLedgerEntryId &&
        ledgerAfter.operationId == bookingAfter.lastFinanceOperationId &&
        ledgerAfter.source == 'booking-payment' &&
        ledgerAfter.sourceAction == 'payment' &&
        ledgerAfter.sourceBookingId == bookingId &&
        ledgerAfter.sourceEventId == event.id &&
        ledgerAfter.amount == event.amount &&
        ledgerAfter.paymentMethod == event.method &&
        ledgerAfter.sourceProofId == bookingAfter.lastFinanceProofId &&
        ledgerAfter.actorUid == request.auth.uid &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == bookingAfter.lastFinanceAction &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == bookingId &&
        closingAfter.lastLedgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        closingAfter.lastProofId == bookingAfter.lastFinanceProofId &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          bookingAfter.lastFinanceAction,
          'bookings',
          bookingId
        );
    }

    function financeBookingRefundUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let history = bookingAfter.refundHistory;
      let event = history[history.size() - 1];
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(bookingAfter.lastFinanceLedgerEntryId);
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(bookingAfter.lastFinanceBusinessDate + '__main');
      let currentPaid = financeBookingNetPaid(resource.data);
      let currentOutstanding = financeBookingOutstanding(resource.data, currentPaid);
      return changed.hasOnly([
          'refundHistory', 'invoiceAmount', 'paidAmount', 'paymentStatus',
          'paymentStatusCanonical', 'refundedAmount', 'lastRefundAt',
          'lastRefundMethod', 'lastRefundReason', 'refundStatus',
          'updatedAt', 'lastFinanceAction', 'lastFinanceBusinessDate',
          'lastFinanceEventId', 'lastFinanceLedgerEntryId',
          'lastFinanceOperationId', 'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.paymentStatus in ['dp', 'refunded'] &&
        bookingAfter.paymentStatusCanonical in ['partial', 'refunded'] &&
        bookingAfter.paymentStatus == (bookingAfter.paymentStatusCanonical == 'refunded' ? 'refunded' : 'dp') &&
        bookingAfter.refundStatus == (bookingAfter.paymentStatusCanonical == 'refunded' ? 'full' : 'partial') &&
        bookingAfter.refundedAmount is number &&
        bookingAfter.refundedAmount == resource.data.get('refundedAmount', 0) + event.amount &&
        validString(bookingAfter.lastRefundReason, 4, 600) &&
        validIsoTimestampString(bookingAfter.updatedAt) &&
        bookingAfter.lastFinanceAction == 'refund' &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        bookingAfter.lastFinanceOperationId is string &&
        bookingAfter.lastFinanceEventId is string &&
        bookingAfter.lastFinanceLedgerEntryId is string &&
        bookingAfter.lastFinanceProofId == '' &&
        history is list &&
        history.size() == resource.data.get('refundHistory', []).size() + 1 &&
        event.id == bookingAfter.lastFinanceEventId &&
        event.operationId == bookingAfter.lastFinanceOperationId &&
        event.ledgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        event.actorUid == request.auth.uid &&
        event.amount is number &&
        event.amount > 0 &&
        event.amount <= currentPaid &&
        bookingAfter.paidAmount == currentPaid - event.amount &&
        bookingAfter.invoiceAmount == currentOutstanding + event.amount &&
        event.date == bookingAfter.lastFinanceBusinessDate &&
        event.method in ['cash', 'transfer', 'qris', 'other'] &&
        existsAfter(ledgerPath) &&
        existsAfter(closingPath) &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          'refund',
          'bookings',
          bookingId
        );
    }

    function financeBookingVoidScheduleMatchesAfter(bookingId, bookingAfter) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(bookingAfter.date);
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let dayAfter = getAfter(dayPath).data;
      let bookingBefore = get(bookingPath).data;
      return exists(bookingPath) &&
        existsAfter(dayPath) &&
        validBookingScheduleDay(dayAfter, bookingAfter.date) &&
        dayAfter.lastBookingId == bookingId &&
        dayAfter.updatedAt == bookingAfter.updatedAt &&
        bookingBefore.updatedAt != bookingAfter.updatedAt &&
        !existsAfter(slotPath);
    }

    function financeBookingVoidUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let closingId = bookingAfter.lastFinanceBusinessDate + '__main';
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let closingAfter = getAfter(closingPath).data;
      return changed.hasOnly([
          'invoiceAmount', 'invoiceStatus', 'paymentStatus',
          'paymentStatusCanonical', 'updatedAt', 'voidReason',
          'voidedAt', 'voidedByName', 'voidedByUid',
          'lastFinanceAction', 'lastFinanceBusinessDate',
          'lastFinanceEventId', 'lastFinanceLedgerEntryId',
          'lastFinanceOperationId', 'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.lastFinanceAction == 'void' &&
        financeBookingNetPaid(resource.data) == 0 &&
        bookingAfter.lastFinanceLedgerEntryId == '' &&
        bookingAfter.lastFinanceProofId == '' &&
        bookingAfter.paymentStatus == 'void' &&
        bookingAfter.paymentStatusCanonical == 'void' &&
        validString(bookingAfter.voidReason, 4, 600) &&
        validIsoTimestampString(bookingAfter.voidedAt) &&
        bookingAfter.voidedByUid == request.auth.uid &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == 'void' &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == bookingId &&
        closingAfter.lastLedgerEntryId == '' &&
        closingAfter.lastProofId == '' &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          'void',
          'bookings',
          bookingId
        ) &&
        financeBookingVoidScheduleMatchesAfter(bookingId, bookingAfter);
    }

    function adminBookingFinanceUpdateAllowed(bookingId) {
      let action = request.resource.data.get('lastFinanceAction', '');
      return hasApprovedAdminPermission('billing') &&
        (
          action in ['payment', 'proof-approve']
            ? financeBookingPaymentUpdateAllowed(bookingId)
            : action == 'refund'
              ? financeBookingRefundUpdateAllowed(bookingId)
              : action == 'void'
                ? financeBookingVoidUpdateAllowed(bookingId)
                : false
        );
    }

    function validBookingSessionEvent(data, eventId) {
      return data.keys().hasOnly([
          'action', 'actorName', 'actorUid', 'bookingId', 'createdAt',
          'fromStatus', 'id', 'reason', 'toStatus', 'type'
        ]) &&
        data.id == eventId &&
        data.action in ['check_in', 'start', 'complete', 'no_show', 'cancelled'] &&
        validString(data.actorName, 1, 120) &&
        data.actorUid == request.auth.uid &&
        validString(data.bookingId, 1, 160) &&
        validIsoTimestampString(data.createdAt) &&
        data.fromStatus in ['upcoming', 'in_progress'] &&
        validString(data.reason, 0, 600) &&
        data.toStatus in ['upcoming', 'in_progress', 'completed', 'no_show', 'cancelled'] &&
        data.type == 'booking-session-event';
    }

    function bookingSessionEventMatchesAfter(eventId, bookingId, eventTimestamp, action, toStatus) {
      let eventPath = /databases/$(database)/documents/bookingSessionEvents/$(eventId);
      let eventAfter = getAfter(eventPath).data;
      return existsAfter(eventPath) &&
        eventAfter.id == eventId &&
        eventAfter.bookingId == bookingId &&
        eventAfter.createdAt == eventTimestamp &&
        eventAfter.action == action &&
        eventAfter.toStatus == toStatus;
    }

    function bookingSessionEventReferencesBookingAfter(eventId) {
      let bookingId = request.resource.data.bookingId;
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return existsAfter(bookingPath) &&
        bookingAfter.keys().hasAll([
          'lastSessionEventId', 'lastSessionEventType', 'lastSessionEventAt', 'updatedAt'
        ]) &&
        bookingAfter.lastSessionEventId == eventId &&
        bookingAfter.lastSessionEventType == request.resource.data.action &&
        bookingAfter.lastSessionEventAt == request.resource.data.createdAt &&
        bookingAfter.updatedAt == request.resource.data.createdAt;
    }

    function bookingRequestAllowsSession(data) {
      return (
          !data.keys().hasAny(['bookingRequestStatus']) ||
          !(data.bookingRequestStatus in ['submitted', 'rejected', 'cancelled', 'canceled'])
        ) &&
        (
          !data.keys().hasAny(['requestStatus']) ||
          !(data.requestStatus in ['submitted', 'rejected', 'cancelled', 'canceled', 'deleted'])
        );
    }

    function bookingSessionIsUpcoming(data) {
      return bookingRequestAllowsSession(data) && (
        (
          data.keys().hasAny(['sessionStatus']) &&
          data.sessionStatus in ['upcoming', 'scheduled']
        ) ||
        (
          !data.keys().hasAny(['sessionStatus']) &&
          (
            !data.keys().hasAny(['sessionState']) ||
            data.sessionState in ['upcoming', 'scheduled']
          )
        )
      );
    }

    function bookingSessionIsInProgress(data) {
      return bookingRequestAllowsSession(data) && (
        (
          data.keys().hasAny(['sessionStatus']) &&
          data.sessionStatus in ['in_progress', 'active', 'ongoing']
        ) ||
        (
          !data.keys().hasAny(['sessionStatus']) &&
          data.keys().hasAny(['sessionState']) &&
          data.sessionState in ['in_progress', 'active', 'ongoing']
        )
      );
    }

    function bookingNoShowGraceElapsed(data) {
      let localNow = request.time + duration.value(7, 'h');
      let scheduledDate = timestamp.date(
        int(data.date[0:4]),
        int(data.date[5:7]),
        int(data.date[8:10])
      );
      return data.startHour is int &&
        (
          localNow.date() > scheduledDate ||
          (
            localNow.date() == scheduledDate &&
            localNow.time() >= duration.time(data.startHour, 15, 0, 0)
          )
        );
    }

    function adminBookingSessionActionUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let eventId = request.resource.data.lastSessionEventId;
      let eventPath = /databases/$(database)/documents/bookingSessionEvents/$(eventId);
      let eventAfter = getAfter(eventPath).data;
      return changed.hasOnly([
          'checkedInAt', 'checkedInByUid', 'checkedInByName',
          'sessionStatus', 'actualStartAt', 'actualStartByUid',
          'actualStartByName', 'actualEndAt', 'actualEndByUid',
          'actualEndByName', 'actualDurationMinutes', 'noShowAt',
          'noShowByUid', 'noShowByName', 'noShowReason', 'updatedAt',
          'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
        ]) &&
        existsAfter(eventPath) &&
        validBookingSessionEvent(eventAfter, eventId) &&
        eventAfter.bookingId == bookingId &&
        eventAfter.actorUid == request.auth.uid &&
        request.resource.data.updatedAt == eventAfter.createdAt &&
        request.resource.data.lastSessionEventAt == eventAfter.createdAt &&
        request.resource.data.lastSessionEventType == eventAfter.action &&
        eventAfter.id == eventId &&
        (
          (
            eventAfter.action == 'check_in' &&
            changed.hasOnly([
              'checkedInAt', 'checkedInByUid', 'checkedInByName', 'updatedAt',
              'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            (
              !resource.data.keys().hasAny(['checkedInAt']) ||
              resource.data.checkedInAt == ''
            ) &&
            request.resource.data.checkedInAt == eventAfter.createdAt &&
            request.resource.data.checkedInByUid == request.auth.uid &&
            request.resource.data.checkedInByName is string &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'upcoming' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'start' &&
            changed.hasOnly([
              'sessionStatus', 'actualStartAt', 'actualStartByUid', 'actualStartByName',
              'updatedAt', 'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            request.resource.data.sessionStatus == 'in_progress' &&
            request.resource.data.actualStartAt == eventAfter.createdAt &&
            request.resource.data.actualStartByUid == request.auth.uid &&
            request.resource.data.actualStartByName is string &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'in_progress' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'complete' &&
            changed.hasOnly([
              'sessionStatus', 'actualEndAt', 'actualEndByUid', 'actualEndByName',
              'actualDurationMinutes', 'updatedAt', 'lastSessionEventAt',
              'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsInProgress(resource.data) &&
            request.resource.data.sessionStatus == 'completed' &&
            request.resource.data.actualEndAt == eventAfter.createdAt &&
            request.resource.data.actualEndByUid == request.auth.uid &&
            request.resource.data.actualEndByName is string &&
            request.resource.data.actualDurationMinutes is int &&
            request.resource.data.actualDurationMinutes >= 1 &&
            request.resource.data.actualDurationMinutes <= 1440 &&
            eventAfter.fromStatus == 'in_progress' &&
            eventAfter.toStatus == 'completed' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'no_show' &&
            changed.hasOnly([
              'sessionStatus', 'noShowAt', 'noShowByUid', 'noShowByName',
              'noShowReason', 'updatedAt', 'lastSessionEventAt',
              'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            (
              !resource.data.keys().hasAny(['checkedInAt']) ||
              resource.data.checkedInAt == ''
            ) &&
            request.resource.data.sessionStatus == 'no_show' &&
            request.resource.data.noShowAt == eventAfter.createdAt &&
            request.resource.data.noShowByUid == request.auth.uid &&
            request.resource.data.noShowByName is string &&
            validString(request.resource.data.noShowReason, 4, 600) &&
            request.resource.data.noShowReason == eventAfter.reason &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'no_show' &&
            bookingNoShowGraceElapsed(resource.data)
          )
        );
    }

    function bookingMessagePreview(messageText) {
      return messageText.size() > 180
        ? messageText[0:180]
        : messageText;
    }

    function bookingDecisionMessageMatchesAfter(bookingId, messageId) {
      let messagePath = /databases/$(database)/documents/bookingMessages/$(messageId);
      let messageAfter = getAfter(messagePath).data;
      return existsAfter(messagePath) &&
        messageAfter.id == messageId &&
        messageAfter.bookingId == bookingId &&
        messageAfter.clientUid == request.resource.data.clientUid &&
        messageAfter.senderUid == request.auth.uid &&
        messageAfter.senderRole == 'admin' &&
        messageAfter.type == 'status' &&
        messageAfter.text == request.resource.data.adminResponseNote &&
        messageAfter.createdAt == request.resource.data.adminResponseAt &&
        messageAfter.readByAdmin == true &&
        messageAfter.readByClient == false &&
        request.resource.data.lastMessageId == messageId &&
        request.resource.data.lastMessageAt == messageAfter.createdAt &&
        request.resource.data.lastMessagePreview == bookingMessagePreview(messageAfter.text) &&
        request.resource.data.lastMessageSenderRole == 'admin' &&
        request.resource.data.lastMessageReadByAdmin == true &&
        request.resource.data.lastMessageReadByClient == false;
    }


    function bookingMessageDecisionReferencesBookingAfter(bookingId, messageId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      return exists(bookingPath) &&
        existsAfter(bookingPath) &&
        bookingAfter.lastMessageId == messageId &&
        bookingAfter.lastMessageAt == request.resource.data.createdAt &&
        bookingAfter.lastMessagePreview == bookingMessagePreview(request.resource.data.text) &&
        bookingAfter.lastMessageSenderRole == 'admin' &&
        bookingAfter.lastMessageReadByAdmin == true &&
        bookingAfter.lastMessageReadByClient == false &&
        bookingAfter.adminResponseNote == request.resource.data.text &&
        bookingAfter.adminResponseAt == request.resource.data.createdAt &&
        bookingAfter.clientUid == request.resource.data.clientUid &&
        bookingAfter.bookingRequestStatus in ['confirmed', 'rejected', 'cancelled'] &&
        bookingAfter.updatedAt == request.resource.data.createdAt &&
        (
          !bookingBefore.keys().hasAny(['lastMessageId']) ||
          bookingBefore.lastMessageId != messageId
        );
    }

    function adminBookingDecisionUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.bookingRequestStatus;
      let messageId = request.resource.data.lastMessageId;
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      return changed.hasOnly([
          'adminResponseAt', 'adminResponseBy', 'adminResponseNote',
          'bookingRequestStatus', 'requestStatus', 'lastRequestDecisionKey',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin',
          'lastMessageReadByClient', 'updatedAt', 'sessionStatus',
          'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
        ]) &&
        (
          nextStatus == 'cancelled' ||
          !changed.hasAny([
            'sessionStatus', 'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
          ])
        ) &&
        validString(request.resource.data.lastRequestDecisionKey, 8, 128) &&
        messageId == 'request-' + request.resource.data.lastRequestDecisionKey &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        request.resource.data.adminResponseAt == request.resource.data.updatedAt &&
        request.resource.data.adminResponseBy == request.auth.uid &&
        validString(request.resource.data.adminResponseNote, 0, 600) &&
        request.resource.data.requestStatus == nextStatus &&
        (
          (
            resource.data.bookingRequestStatus == 'submitted' &&
            nextStatus in ['confirmed', 'rejected']
          ) ||
          (
            resource.data.bookingRequestStatus == 'cancellation_requested' &&
            nextStatus in ['cancelled', 'confirmed']
          )
        ) &&
        bookingDecisionMessageMatchesAfter(bookingId, messageId) &&
        bookingScheduleDayMatchesAfter(resource.data.date, bookingId, request.resource.data.updatedAt) &&
        (
          nextStatus == 'confirmed'
            ? bookingSlotStateMatchesAfter(bookingId, request.resource.data)
            : !existsAfter(slotPath)
        ) &&
        (
          nextStatus != 'cancelled' ||
          (
            request.resource.data.sessionStatus == 'cancelled' &&
            bookingSessionEventMatchesAfter(
              request.resource.data.lastSessionEventId,
              bookingId,
              request.resource.data.updatedAt,
              'cancelled',
              'cancelled'
            ) &&
            getAfter(/databases/$(database)/documents/bookingSessionEvents/$(request.resource.data.lastSessionEventId)).data.fromStatus == 'upcoming' &&
            getAfter(/databases/$(database)/documents/bookingSessionEvents/$(request.resource.data.lastSessionEventId)).data.reason == request.resource.data.adminResponseNote
          )
        );
    }

    function adminBookingInitialPaymentLedgerUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let paymentHistory = request.resource.data.paymentHistory;
      let payment = paymentHistory is list && paymentHistory.size() == 1
        ? paymentHistory[0]
        : {};
      let ledgerId = paymentHistory is list && paymentHistory.size() == 1
        ? 'booking-payment-' + bookingId + '-' + payment.id
        : 'invalid-initial-payment-ledger';
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(ledgerId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let slotAfter = getAfter(slotPath).data;
      let total = resource.data.total;
      let amount = payment.amount;
      let isPaid = total > 0 && amount >= total;
      return changed.hasOnly([
          'dpAmount', 'initialPaymentLedgerStatus', 'invoiceAmount',
          'lastPaymentAt', 'lastPaymentMethod', 'paidAmount', 'paymentHistory',
          'paymentMethod', 'paymentStatus', 'paymentStatusCanonical', 'status'
        ]) &&
        resource.data.source == 'admin' &&
        resource.data.initialPaymentLedgerStatus == 'pending' &&
        resource.data.paymentHistory is list &&
        resource.data.paymentHistory.size() == 0 &&
        request.resource.data.initialPaymentLedgerStatus == 'recorded' &&
        paymentHistory is list &&
        paymentHistory.size() == 1 &&
        payment == resource.data.initialPaymentIntent &&
        validManualInitialPaymentRecord(payment, resource.data) &&
        request.resource.data.paidAmount == amount &&
        request.resource.data.paymentMethod == payment.method &&
        request.resource.data.lastPaymentAt == payment.createdAt &&
        request.resource.data.lastPaymentMethod == payment.method &&
        request.resource.data.invoiceAmount == total - amount &&
        request.resource.data.status == request.resource.data.paymentStatus &&
        (
          (
            isPaid &&
            request.resource.data.dpAmount == 0 &&
            request.resource.data.paymentStatus == 'lunas' &&
            request.resource.data.paymentStatusCanonical == 'paid'
          ) ||
          (
            total > 0 &&
            amount < total &&
            request.resource.data.dpAmount == amount &&
            request.resource.data.paymentStatus == 'dp' &&
            request.resource.data.paymentStatusCanonical == 'partial'
          )
        ) &&
        !exists(ledgerPath) &&
        existsAfter(ledgerPath) &&
        ledgerAfter.id == ledgerId &&
        ledgerAfter.source == 'booking-payment' &&
        ledgerAfter.sourceAction == 'payment' &&
        ledgerAfter.category == 'booking' &&
        ledgerAfter.type == 'income' &&
        ledgerAfter.immutable == true &&
        ledgerAfter.reversalOf == '' &&
        ledgerAfter.sourceBookingId == bookingId &&
        ledgerAfter.sourceEventId == payment.id &&
        ledgerAfter.actorUid == payment.actorUid &&
        ledgerAfter.actorName == payment.actorName &&
        ledgerAfter.amount == amount &&
        ledgerAfter.paymentMethod == payment.method &&
        ledgerAfter.date == payment.date &&
        ledgerAfter.createdAt == payment.createdAt &&
        ledgerAfter.updatedAt == payment.createdAt &&
        ledgerAfter.idempotencyKey == payment.idempotencyKey &&
        ledgerAfter.note == payment.note &&
        ledgerAfter.title == 'Pembayaran ' + resource.data.invoiceNumber &&
        (
          bookingRequiresPublicSlot(request.resource.data)
            ? existsAfter(slotPath) &&
              slotAfter.bookingId == bookingId &&
              slotAfter.date == request.resource.data.date &&
              slotAfter.status == request.resource.data.paymentStatus
            : !existsAfter(slotPath)
        );
    }

    function adminBookingOperationalUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return adminBookingFinanceFieldsUnchanged() && (
        changed.hasAny([
          'bookingRequestStatus', 'adminResponseAt', 'lastRequestDecisionKey'
        ])
          ? adminBookingDecisionUpdate(bookingId)
          : changed.hasAny(['lastSessionEventId'])
            ? adminBookingSessionActionUpdate(bookingId)
            : adminBookingManualUpdate(bookingId)
      );
    }

    function adminBookingUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['initialPaymentLedgerStatus'])
        ? isApprovedScheduleAdmin() && adminBookingInitialPaymentLedgerUpdate(bookingId)
        : changed.hasAny([
            'lastFinanceAction', 'paymentHistory', 'refundHistory'
          ])
          ? adminBookingFinanceUpdateAllowed(bookingId)
          : isApprovedScheduleAdmin() && adminBookingOperationalUpdate(bookingId);
    }

