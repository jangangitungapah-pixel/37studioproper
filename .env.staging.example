# Copy to .env.staging (or .env.staging.local) before running staging builds or verification.
# Keep all secrets in Cloudflare Worker secrets / .dev.vars.staging; never commit real keys.

# Isolated Firebase Spark staging project (separate from production "studio-proper")
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firebase App Check (reCAPTCHA Enterprise site key for staging Hosting origin)
# Never commit a real debug token.
VITE_FIREBASE_APPCHECK_SITE_KEY=
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Staging Admin Operations Worker URL (deployed via: npx wrangler deploy --env staging)
VITE_ADMIN_OPERATIONS_URL=

# Studio Owner bootstrap email & branding
VITE_OWNER_EMAIL=
VITE_STUDIO_NAME=37 Music Studio (Staging)

# Cloudinary Image Upload (use an isolated staging upload preset / asset folder)
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
