        msg.senderUid == request.auth.uid &&
        msg.senderRole == 'client';
    }
    function clientBookingUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let d = request.resource.data;
      let msgKeys = [
        'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
        'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
      ];
      return isClientBookingOwner(resource.data) &&
        d.clientUid == resource.data.clientUid && (
          (
            changed.hasOnly(['lastMessageReadByClient']) &&
            resource.data.lastMessageSenderRole == 'admin' &&
            d.lastMessageReadByClient == true
          ) || (
            validClientMessageSummary(d) &&
            clientMessageExistsAfter(bookingId) && (
              changed.hasOnly(msgKeys) || (
                changed.hasOnly(msgKeys.concat(['bookingRequestStatus', 'clientRequestNote', 'clientRequestUpdatedAt'])) &&
                resource.data.bookingRequestStatus in ['submitted', 'confirmed'] &&
                d.bookingRequestStatus == 'cancellation_requested' &&
                d.clientRequestNote is string && d.clientRequestNote.size() > 0 &&
