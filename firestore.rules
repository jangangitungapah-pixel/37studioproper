      let notCheckedIn = !resource.data.keys().hasAny(['checkedInAt']) || resource.data.checkedInAt == '';
      let p = action == 'check_in' ? 'checkedIn' : action == 'start' ? 'actualStart' : action == 'complete' ? 'actualEnd' : 'noShow';
