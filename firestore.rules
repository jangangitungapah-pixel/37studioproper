rules_version = '2';

// ===============================================================
// Assumed data model and authority boundaries
// ===============================================================
// bookings/{bookingId}: existing booking fields plus optional request status,
// response notes, immutable last-message summary, payment/refund histories.
// Browser Admins may manage operational fields, but finance fields are changed
// only by the authenticated Admin Operations Worker.
// bookingMessages/{messageId}: id, bookingId, clientUid, senderUid,
// senderRole, senderName, text, type, createdAt, readByAdmin, readByClient.
// Messages are private to the owning client and approved booking admins.
// users/{uid}: one authoritative account role. Valid states are owner/approved,
// admin/pending|approved|rejected, client/active, and studio_guard/approved.
// Client accounts always have every admin permission disabled.
// Studio guard does not use admin-page permissions and may only access
// its own guard attendance records through the dedicated guard rules.
// bookkeepingEntries canonical payment/refund rows and inventoryMovements are
// immutable server records. adminOperation* documents are server-only.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapOwnerEmail() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'marsicprod@gmail.com';
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function ownershipControlExists() {
      return exists(/databases/$(database)/documents/adminControl/ownership);
    }

    function ownershipControlMatches() {
      return ownershipControlExists() &&
        get(/databases/$(database)/documents/adminControl/ownership).data.currentOwnerUid == request.auth.uid;
    }

    function isOwner() {
      // The configured email is a bootstrap path only. Once its canonical user
      // document exists, ownership is governed exclusively by that document so
      // a completed ownership transfer cannot leave the bootstrap account with
      // permanent Owner authority.
      return (!ownershipControlExists() && !userDocExists() && isBootstrapOwnerEmail()) ||
        (userDocExists() &&
          getUserData().role == 'owner' &&
          getUserData().status == 'approved' &&
          (!ownershipControlExists() || ownershipControlMatches()));
    }

    function isApproved() {
      return isOwner() ||
        (userDocExists() &&
          getUserData().role in ['admin', 'studio_guard'] &&
          getUserData().status == 'approved');
    }

    function isApprovedAdmin() {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      // The common admin path uses one profile read. Owner authority remains
      // bound to the canonical ownership control.
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved'
      ) || isOwner();
    }

    function isClientAccount() {
      return userDocExists() &&
        getUserData().role == 'client' &&
        getUserData().status == 'active';
    }

    function isStudioGuardAccount() {
      return userDocExists() &&
        getUserData().role == 'studio_guard' &&
        getUserData().status == 'approved';
    }

    function hasCanonicalGuardId(data) {
      return 'guardId' in data &&
        data.guardId is string &&
        data.guardId.size() > 0 &&
        data.guardId.size() <= 160;
    }

    function hasPermission(page) {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved' &&
        profile.permissions is map &&
        profile.permissions[page] == true
      ) || isOwner();
    }

    function canAccessNotifications() {
      return isOwner() || (
        isApprovedAdmin() &&
        getUserData().permissions is map &&
        (
          (
            getUserData().permissions.keys().hasAny(['notifications']) &&
            getUserData().permissions.notifications == true
          ) || (
            !getUserData().permissions.keys().hasAny(['notifications']) &&
            getUserData().permissions.settings == true
          )
        )
      );
    }

    function canManageOperatorFees() {
      return isOwner() || (
        isApprovedAdmin() &&
        hasPermission('operator-fee')
      );
    }

    function canManageGuardAttendance() {
      return isOwner() || (
        isApprovedAdmin() &&
        getUserData().permissions is map &&
        (
          (
            getUserData().permissions.keys().hasAny(['guard-attendance']) &&
            getUserData().permissions['guard-attendance'] == true
          ) || (
            !getUserData().permissions.keys().hasAny(['guard-attendance']) &&
            getUserData().permissions['operator-fee'] == true
          )
        )
      );
    }

    function canAccessBookingData() {
      return hasPermission('dashboard') ||
        hasPermission('schedule') ||
        hasPermission('customers') ||
        hasPermission('billing');
    }

    function canManageBookingData() {
      return hasPermission('schedule');
    }

    function isApprovedScheduleAdmin() {
      let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
      let ownershipPath = /databases/$(database)/documents/adminControl/ownership;
      let signedIn = isSignedIn();
      let userExists = signedIn && exists(userPath);
      let ownershipExists = signedIn && exists(ownershipPath);
      let userData = userExists ? get(userPath).data : {};
      let bootstrapOwner = signedIn &&
        !ownershipExists &&
        !userExists &&
        isBootstrapOwnerEmail();
      let approvedOwner = userExists &&
        userData.role == 'owner' &&
        userData.status == 'approved' &&
        (
          !ownershipExists ||
          get(ownershipPath).data.currentOwnerUid == request.auth.uid
        );
      let approvedScheduleAdmin = userExists &&
        userData.role == 'admin' &&
        userData.status == 'approved' &&
        userData.permissions is map &&
        userData.permissions.schedule == true;
      return bootstrapOwner || approvedOwner || approvedScheduleAdmin;
    }

    function canAccessCustomerData() {
      return hasPermission('dashboard') || hasPermission('customers');
    }

    function canManageCustomerData() {
      return hasPermission('customers');
    }

    function canAccessBookkeepingData() {
      return hasPermission('dashboard') || hasPermission('bookkeeping');
    }

    function canManageBookkeepingData() {
      return hasPermission('bookkeeping');
    }

    function canAccessInventoryData() {
      return hasPermission('dashboard') || hasPermission('inventory') || canManageInventoryData();
    }

    function canManageInventoryData() {
      return hasPermission('inventory');
    }

    function validString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function validOptionalString(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function validNumber(value, minValue, maxValue) {
      return value is number && float(value) >= float(minValue) && float(value) <= float(maxValue);
    }

    function validIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validIsoTimestampString(value) {
      return value is string && value.size() >= 10 && value.size() <= 40;
    }

    function validPermissions(data) {
      return data is map &&
        data.keys().hasOnly([
          'dashboard', 'schedule', 'customers', 'billing', 'bookkeeping',
          'operator-fee', 'guard-attendance', 'inventory', 'gallery', 'settings',
          'notifications'
        ]) &&
        data.dashboard is bool && data.schedule is bool &&
        data.customers is bool && data.billing is bool &&
        (!data.keys().hasAny(['operator-fee']) || data['operator-fee'] is bool) &&
        (!data.keys().hasAny(['guard-attendance']) || data['guard-attendance'] is bool) &&
        (!data.keys().hasAny(['notifications']) || data.notifications is bool) &&
        data.bookkeeping is bool && data.inventory is bool &&
        data.gallery is bool && data.settings is bool;
    }

    function hasNoAdminPermissions(data) {
      return validPermissions(data) &&
        data.dashboard == false && data.schedule == false &&
        data.customers == false && data.billing == false &&
        data.bookkeeping == false &&
        (!data.keys().hasAny(['operator-fee']) || data['operator-fee'] == false) &&
        (!data.keys().hasAny(['guard-attendance']) || data['guard-attendance'] == false) &&
        (!data.keys().hasAny(['notifications']) || data.notifications == false) &&
        data.inventory == false &&
        data.gallery == false && data.settings == false;
    }

    function hasOnlyGuardPortalPermissions(data) {
      return hasNoAdminPermissions(data);
    }

    function validPreferences(data) {
      return data is map &&
        data.keys().hasOnly(['accountNote', 'defaultLandingKey', 'notificationLevel', 'preferredContact', 'theme']) &&
        validString(data.accountNote, 0, 240) &&
        data.defaultLandingKey in [
          'dashboard', 'schedule', 'billing', 'bookkeeping', 'operator-fee',
          'guard-attendance', 'inventory', 'settings'
        ] &&
        data.notificationLevel in ['important', 'standard', 'proactive'] &&
        data.preferredContact in ['email', 'phone', 'none'] &&
        (!data.keys().hasAny(['theme']) || data.theme in ['light', 'dark', 'system']);
    }

    function validUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'provider', 'permissions',
          'preferences', 'role', 'status', 'createdAt', 'updatedAt',
          'ownershipTransferredInAt', 'ownershipTransferredOutAt',
          'adminRequestCancelledAt', 'isGuard', 'guardId'
        ]) &&
        data.uid == userId &&
        validString(data.email, 0, 254) &&
        validString(data.phoneNumber, 0, 32) &&
        validString(data.displayName, 1, 120) &&
        validString(data.provider, 1, 80) &&
        data.role in ['owner', 'admin', 'client', 'studio_guard'] &&
        data.status in ['active', 'pending', 'approved', 'rejected'] &&
        validPermissions(data.permissions) &&
        (
          (data.role == 'owner' && data.status == 'approved') ||
          (data.role == 'admin' && data.status in ['pending', 'approved', 'rejected']) ||
          (data.role == 'client' && data.status == 'active' && hasNoAdminPermissions(data.permissions)) ||
          (data.role == 'studio_guard' && data.status == 'approved' && hasOnlyGuardPortalPermissions(data.permissions) && hasCanonicalGuardId(data))
        ) &&
        (!data.keys().hasAny(['preferences']) || validPreferences(data.preferences)) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'ownershipTransferredInAt', 40) &&
        validOptionalString(data, 'ownershipTransferredOutAt', 40) &&
        validOptionalString(data, 'adminRequestCancelledAt', 40) &&
        (!data.keys().hasAny(['isGuard']) || data.isGuard == null || data.isGuard == false) &&
        (!data.keys().hasAny(['guardId']) || data.guardId == null || (data.guardId is string && data.guardId.size() <= 160));
    }

    function authIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phoneNumber == request.auth.token.phone_number
        );
    }

    function isSafeAccountSelfCreate(data) {
      return (
          isBootstrapOwnerEmail() &&
          data.role == 'owner' &&
          data.status == 'approved'
        ) || (
          !isBootstrapOwnerEmail() &&
          data.role == 'admin' &&
          data.status == 'pending'
        ) || (
          !isBootstrapOwnerEmail() &&
          data.role == 'client' &&
          data.status == 'active' &&
          hasNoAdminPermissions(data.permissions)
        );
    }

    function isSafeAdminRequestToClientTransition(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'admin' &&
        resource.data.status in ['pending', 'rejected'] &&
        request.resource.data.role == 'client' &&
        request.resource.data.status == 'active' &&
        hasNoAdminPermissions(request.resource.data.permissions) &&
        validIsoTimestampString(request.resource.data.adminRequestCancelledAt) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'permissions', 'adminRequestCancelledAt', 'updatedAt'
        ]);
    }
    // >>> STUDIO37 GUARD ATTENDANCE RULES START
    function validGuardAttendanceSession(data, attendanceId) {
      return data.keys().hasOnly([
          'id', 'approvalStatus', 'approvedAt', 'approvedByName', 'approvedByUid',
          'closedAt', 'clockInAt', 'clockInByUid', 'clockOutAt',
          'clockOutByUid', 'createdAt', 'date',
          'durationHours', 'guardEmail', 'guardName', 'guardPersonId',
          'guardUid', 'mealAmount', 'mealEligible',
          'mealBookkeepingEntryId', 'mealBookkeepingStatus',
          'mealPostedAt', 'mealPostedByUid', 'note',
          'ownerActionRequired', 'rejectedAt', 'rejectedByName',
          'rejectedByUid', 'rejectionReason', 'source', 'status',
          'updatedAt', 'voidedAt', 'voidedByUid', 'voidReason'
        ]) &&
        data.id == attendanceId &&
        data.approvalStatus in ['pending', 'approved', 'rejected'] &&
        validString(data.approvedAt, 0, 40) &&
        validString(data.approvedByName, 0, 120) &&
        validString(data.approvedByUid, 0, 128) &&
        (data.closedAt == '' || validIsoTimestampString(data.closedAt)) &&
        validIsoTimestampString(data.clockInAt) &&
        validOptionalString(data, 'clockInByUid', 128) &&
        (data.clockOutAt == '' || validIsoTimestampString(data.clockOutAt)) &&
        validOptionalString(data, 'clockOutByUid', 128) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoDate(data.date) &&
        validNumber(data.durationHours, 0, 48) &&
        validString(data.guardEmail, 0, 254) &&
        validString(data.guardName, 1, 120) &&
        validString(data.guardPersonId, 1, 160) &&
        validString(data.guardUid, 1, 128) &&
        validNumber(data.mealAmount, 0, 1000000) &&
        data.mealEligible is bool &&
        (
          !data.keys().hasAny(['mealBookkeepingEntryId']) ||
          validString(data.mealBookkeepingEntryId, 0, 200)
        ) &&
        (
          !data.keys().hasAny(['mealBookkeepingStatus']) ||
          data.mealBookkeepingStatus in ['not_posted', 'posted']
        ) &&
        (
          !data.keys().hasAny(['mealPostedAt']) ||
          validString(data.mealPostedAt, 0, 40)
        ) &&
        (
          !data.keys().hasAny(['mealPostedByUid']) ||
          validString(data.mealPostedByUid, 0, 128)
        ) &&
        validString(data.note, 0, 1000) &&
        data.ownerActionRequired is bool &&
        validString(data.rejectedAt, 0, 40) &&
        validString(data.rejectedByName, 0, 120) &&
        validString(data.rejectedByUid, 0, 128) &&
        validString(data.rejectionReason, 0, 1000) &&
        data.source == 'guardAttendance' &&
        data.status in ['pending_approval', 'active', 'closed', 'rejected', 'void'] &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.voidedAt, 0, 40) &&
        validString(data.voidedByUid, 0, 128) &&
        validString(data.voidReason, 0, 1000);
    }

    function getCurrentGuardPersonId() {
      return getUserData().guardId;
    }
    function guardMealStartsUnposted(data) {
      return (
          !data.keys().hasAny(['mealBookkeepingStatus']) ||
          data.mealBookkeepingStatus == 'not_posted'
        ) &&
        (
          !data.keys().hasAny(['mealBookkeepingEntryId']) ||
          data.mealBookkeepingEntryId == ''
        ) &&
        (
          !data.keys().hasAny(['mealPostedAt']) ||
          data.mealPostedAt == ''
        ) &&
        (
          !data.keys().hasAny(['mealPostedByUid']) ||
          data.mealPostedByUid == ''
        );
    }

    function guardMealNotPosted(data) {
      return !data.keys().hasAny(['mealBookkeepingStatus']) ||
        data.mealBookkeepingStatus != 'posted';
    }

    function guardCreatesOwnAttendance(data, attendanceId) {
      return isStudioGuardAccount() &&
        hasCanonicalGuardId(getUserData()) &&
        attendanceId == 'att__' + request.auth.uid + '__' + data.date &&
        data.guardUid == request.auth.uid &&
        data.clockInByUid == request.auth.uid &&
        data.clockOutByUid == '' &&
        data.guardPersonId == getCurrentGuardPersonId() &&
        data.status == 'pending_approval' &&
        data.approvalStatus == 'pending' &&
        data.mealEligible == false &&
        guardMealStartsUnposted(data) &&
        data.ownerActionRequired == true &&
        data.approvedAt == '' &&
        data.approvedByUid == '' &&
        data.rejectedAt == '' &&
        data.rejectedByUid == '' &&
        data.voidedAt == '' &&
        data.voidedByUid == '';
    }

    function validGuardSelfCheckoutPatch() {
      return validIsoTimestampString(
          request.resource.data.clockOutAt
        ) &&
        validIsoTimestampString(
          request.resource.data.closedAt
        ) &&
        request.resource.data.closedAt ==
          request.resource.data.clockOutAt &&
        validString(
          request.resource.data.clockOutByUid,
          1,
          128
        ) &&
        validNumber(
          request.resource.data.durationHours,
          0,
          48
        ) &&
        validIsoTimestampString(
          request.resource.data.updatedAt
        );
    }

    function guardClosesOwnAttendance() {
      return isStudioGuardAccount() &&
        validGuardSelfCheckoutPatch() &&
        resource.data.guardUid == request.auth.uid &&
        request.resource.data.guardUid == resource.data.guardUid &&
        request.resource.data.guardPersonId == resource.data.guardPersonId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        resource.data.clockOutAt == '' &&
        resource.data.status in ['active', 'pending_approval'] &&
        request.resource.data.status == 'closed' &&
        request.resource.data.clockOutAt != '' &&
        request.resource.data.closedAt == request.resource.data.clockOutAt &&
        request.resource.data.clockOutByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clockOutAt',
          'clockOutByUid',
          'closedAt',
          'durationHours',
          'status',
          'updatedAt'
        ]);
    }

    function guardAttendanceCoreIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.guardUid == resource.data.guardUid &&
        request.resource.data.guardPersonId == resource.data.guardPersonId &&
        request.resource.data.guardEmail == resource.data.guardEmail &&
        request.resource.data.guardName == resource.data.guardName &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.clockInAt == resource.data.clockInAt &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.source == resource.data.source;
    }

    function validGuardAttendanceOwnerReviewAuditFields() {
      return validIsoTimestampString(
          request.resource.data.updatedAt
        ) &&
        request.resource.data.ownerActionRequired is bool &&
        request.resource.data.mealEligible is bool;
    }

    function validGuardAttendanceOwnerApprovePatch() {
      return validGuardAttendanceOwnerReviewAuditFields() &&
        validIsoTimestampString(
          request.resource.data.approvedAt
        ) &&
        validString(
          request.resource.data.approvedByName,
          0,
          120
        ) &&
        validString(
          request.resource.data.approvedByUid,
          1,
          128
        ) &&
        validString(
          request.resource.data.rejectedAt,
          0,
          40
        ) &&
        validString(
          request.resource.data.rejectedByName,
          0,
          120
        ) &&
        validString(
          request.resource.data.rejectedByUid,
          0,
          128
        ) &&
        validString(
          request.resource.data.rejectionReason,
          0,
          1000
        );
    }

    function validGuardAttendanceOwnerRejectPatch() {
      return validGuardAttendanceOwnerReviewAuditFields() &&
        validIsoTimestampString(
          request.resource.data.rejectedAt
        ) &&
        validString(
          request.resource.data.rejectedByName,
          0,
          120
        ) &&
        validString(
          request.resource.data.rejectedByUid,
          1,
          128
        ) &&
        validString(
          request.resource.data.rejectionReason,
          1,
          1000
        );
    }

    function validGuardAttendanceOwnerVoidPatch() {
      return validGuardAttendanceOwnerReviewAuditFields() &&
        validIsoTimestampString(
          request.resource.data.voidedAt
        ) &&
        validString(
          request.resource.data.voidedByUid,
          1,
          128
        ) &&
        validString(
          request.resource.data.voidReason,
          1,
          1000
        );
    }

    function adminApprovesGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        validGuardAttendanceOwnerApprovePatch() &&
        resource.data.status != 'void' &&
        resource.data.approvalStatus in ['pending', 'rejected'] &&
        request.resource.data.approvalStatus == 'approved' &&
        request.resource.data.approvedAt != '' &&
        request.resource.data.approvedByUid != '' &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.rejectedAt == '' &&
        request.resource.data.rejectedByUid == '' &&
        request.resource.data.rejectionReason == '' &&
        (
          (
            resource.data.clockOutAt == '' &&
            request.resource.data.status == 'active'
          ) ||
          (
            resource.data.clockOutAt != '' &&
            request.resource.data.status == 'closed'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'approvedAt',
          'approvedByName',
          'approvedByUid',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }

    function adminRejectsGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        validGuardAttendanceOwnerRejectPatch() &&
        resource.data.status != 'void' &&
        guardMealNotPosted(resource.data) &&
        resource.data.approvalStatus in ['pending', 'approved'] &&
        request.resource.data.approvalStatus == 'rejected' &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.rejectedAt != '' &&
        request.resource.data.rejectedByUid != '' &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }

    function adminVoidsGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        validGuardAttendanceOwnerVoidPatch() &&
        resource.data.status != 'void' &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.status == 'void' &&
        request.resource.data.voidedAt != '' &&
        request.resource.data.voidedByUid != '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealEligible',
          'ownerActionRequired',
          'status',
          'updatedAt',
          'voidReason',
          'voidedAt',
          'voidedByUid'
        ]);
    }

    function guardMealBookkeepingExistsAfter() {
      let entryId =
        request.resource.data.mealBookkeepingEntryId;

      let entryPath =
        /databases/$(database)/documents/bookkeepingEntries/$(entryId);

      return entryId is string &&
        entryId.size() > 0 &&
        existsAfter(entryPath) &&
        getAfter(entryPath).data.id == entryId &&
        getAfter(entryPath).data.type == 'expense' &&
        getAfter(entryPath).data.source == 'guardAttendanceMeal' &&
        getAfter(entryPath).data.sourceAttendanceId == resource.data.id &&
        getAfter(entryPath).data.sourceAttendanceDate == resource.data.date &&
        getAfter(entryPath).data.sourceGuardPersonId == resource.data.guardPersonId &&
        getAfter(entryPath).data.amount == resource.data.mealAmount;
    }

    function adminPostsGuardMeal() {
      return isApprovedAdmin() &&
        (
          hasPermission('operator-fee') ||
          canManageGuardAttendance()
        ) &&
        guardAttendanceCoreIdentityUnchanged() &&
        resource.data.approvalStatus == 'approved' &&
        resource.data.status == 'closed' &&
        resource.data.mealEligible == true &&
        resource.data.mealAmount > 0 &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.mealEligible == resource.data.mealEligible &&
        request.resource.data.mealBookkeepingStatus == 'posted' &&
        request.resource.data.mealBookkeepingEntryId != '' &&
        request.resource.data.mealPostedAt != '' &&
        request.resource.data.mealPostedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealBookkeepingEntryId',
          'mealBookkeepingStatus',
          'mealPostedAt',
          'mealPostedByUid',
          'updatedAt'
        ]) &&
        guardMealBookkeepingExistsAfter();
    }

    function adminReviewsGuardAttendance() {
      // Put the terminal Void transition first. Each review validator is
      // intentionally strict and expensive; evaluating Approve + Reject before
      // Void can exceed Firestore's 1,000-expression request limit and surface
      // as a misleading missing-permission error.
      return adminVoidsGuardAttendance() ||
        adminRejectsGuardAttendance() ||
        adminApprovesGuardAttendance();
    }

    match /guardAttendanceSessions/{attendanceId} {
      allow read: if
        canManageGuardAttendance() ||
        canManageOperatorFees() ||
        (
          isStudioGuardAccount() &&
          resource.data.guardUid == request.auth.uid
        );

      allow create: if validGuardAttendanceSession(request.resource.data, attendanceId) &&
        guardCreatesOwnAttendance(
          request.resource.data,
          attendanceId
        );

      allow update: if guardClosesOwnAttendance() ||
        adminReviewsGuardAttendance() || (
          validGuardAttendanceSession(
            request.resource.data,
            attendanceId
          ) &&
          adminPostsGuardMeal()
        );

      allow delete: if isOwner();
    }
    // <<< STUDIO37 GUARD ATTENDANCE RULES END

match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        validUser(request.resource.data, userId) &&
        authIdentityMatches(request.resource.data) &&
        isSafeAccountSelfCreate(request.resource.data);
      allow update: if validUser(request.resource.data, userId) && (
        (
          isOwner() &&
          request.resource.data.role == resource.data.role
        ) || (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'preferences', 'updatedAt'])
        ) || isSafeAdminRequestToClientTransition(userId)
      );
      // Account deletion and ownership transitions are protected server jobs.
      allow delete: if false;
    }


    function canAccessOwnRepositoryOperations(userId) {
      let userPath = /databases/$(database)/documents/users/$(userId);
      let profileExists = exists(userPath);
      let profile = profileExists ? get(userPath).data : {};
      return isSignedIn() &&
        request.auth.uid == userId &&
        profileExists &&
        (
          (profile.role == 'owner' && isOwner()) ||
          (profile.role == 'admin' && profile.status == 'approved') ||
          (profile.role == 'client' && profile.status == 'active') ||
          (profile.role == 'studio_guard' && profile.status == 'approved')
        );
    }

    function validRepositoryOperation(data, operationId) {
      return data is map &&
        data.keys().hasOnly([
          'operationId', 'actorUid', 'scope', 'action', 'requestId',
          'payloadHash', 'resultCollection', 'resultId', 'createdAt'
        ]) &&
        data.operationId == operationId &&
        operationId.matches('^v1_[a-f0-9]{64}$') &&
        data.actorUid == request.auth.uid &&
        data.scope.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.action.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.requestId.matches('^[A-Za-z0-9._:-]{8,128}$') &&
        data.payloadHash.matches('^[a-f0-9]{64}$') &&
        data.resultCollection is string &&
        data.resultId is string &&
        (
          (data.resultCollection == '' && data.resultId == '') ||
          (
            data.resultCollection.matches('^[A-Za-z][A-Za-z0-9_]{0,63}$') &&
            data.resultId.matches('^[^/]{1,160}$')
          )
        ) &&
        data.createdAt == request.time;
    }

    match /users/{userId}/repositoryOperations/{operationId} {
      allow read: if canAccessOwnRepositoryOperations(userId);
      allow create: if canAccessOwnRepositoryOperations(userId) &&
        validRepositoryOperation(request.resource.data, operationId);
      allow update, delete: if false;
    }

    match /adminControl/ownership {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !ownershipControlExists() &&
        request.resource.data.keys().hasOnly(['currentOwnerUid', 'initializedAt', 'updatedAt']) &&
        request.resource.data.currentOwnerUid == request.auth.uid &&
        validIsoTimestampString(request.resource.data.initializedAt) &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'owner' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'approved' &&
        (
          isBootstrapOwnerEmail() ||
          (userDocExists() && getUserData().role == 'owner' && getUserData().status == 'approved')
        );
      allow update, delete: if false;
    }

    function isClientBookingOwner(data) {
      return isClientAccount() && (
        (data.clientUid is string && data.clientUid == request.auth.uid) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) ||
        (
          'phone_number' in request.auth.token &&
          request.auth.token.phone_number is string &&
          (
            (data.phone is string && (
              data.phone == request.auth.token.phone_number ||
              ('+' + data.phone) == request.auth.token.phone_number
            )) ||
            (data.customerPhoneKey is string && (
              data.customerPhoneKey == request.auth.token.phone_number ||
              ('+' + data.customerPhoneKey) == request.auth.token.phone_number
            ))
          )
        )
      );
    }

    function validBooking(data) {
      return validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.total, 0, 100000000) &&
        data.paymentStatus in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        data.status in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        validOptionalString(data, 'email', 254) &&
        validOptionalString(data, 'clientUid', 128) &&
        validOptionalString(data, 'title', 160) &&
        validOptionalString(data, 'sessionLabel', 160) &&
        validOptionalString(data, 'clientRequestNote', 600) &&
        validOptionalString(data, 'clientRequestUpdatedAt', 40) &&
        validOptionalString(data, 'adminResponseNote', 600) &&
        validOptionalString(data, 'adminResponseAt', 40) &&
        validOptionalString(data, 'lastMessageId', 128) &&
        validOptionalString(data, 'lastMessageAt', 40) &&
        validOptionalString(data, 'lastMessagePreview', 180) &&
        (!data.keys().hasAny(['bookingRequestStatus']) || data.bookingRequestStatus in ['submitted', 'confirmed', 'rejected', 'cancellation_requested', 'cancelled']) &&
        (!data.keys().hasAny(['lastMessageSenderRole']) || data.lastMessageSenderRole in ['admin', 'client']) &&
        (!data.keys().hasAny(['lastMessageReadByAdmin']) || data.lastMessageReadByAdmin is bool) &&
        (!data.keys().hasAny(['lastMessageReadByClient']) || data.lastMessageReadByClient is bool) &&
        (!data.keys().hasAny(['paymentHistory']) || (data.paymentHistory is list && data.paymentHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundHistory']) || (data.refundHistory is list && data.refundHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundedAmount']) || validNumber(data.refundedAmount, 0, 100000000)) &&
        (!data.keys().hasAny(['refundStatus']) || data.refundStatus in ['partial', 'full']) &&
        validOptionalString(data, 'lastRefundAt', 40) &&
        validOptionalString(data, 'lastRefundMethod', 40) &&
        validOptionalString(data, 'lastRefundReason', 600) &&
        validOptionalString(data, 'refundCompletedAt', 40) &&
        validOptionalString(data, 'paymentStatusBeforeRefund', 40) &&
        validOptionalString(data, 'invoiceStatus', 40) &&
        validOptionalString(data, 'paymentStatusCanonical', 40) &&
        validOptionalString(data, 'lastFinanceAction', 40) &&
        validOptionalString(data, 'lastFinanceBusinessDate', 10) &&
        validOptionalString(data, 'lastFinanceEventId', 180) &&
        validOptionalString(data, 'lastFinanceLedgerEntryId', 160) &&
        validOptionalString(data, 'lastFinanceOperationId', 80) &&
        validOptionalString(data, 'lastFinanceProofId', 160) &&
        validOptionalString(data, 'voidedAt', 40) &&
        validOptionalString(data, 'voidedByName', 120) &&
        validOptionalString(data, 'voidedByUid', 128) &&
        validOptionalString(data, 'voidReason', 600) &&
        (!data.keys().hasAny(['appliedDiscounts']) || (data.appliedDiscounts is list && data.appliedDiscounts.size() <= 50));
    }

    function adminBookingFinanceFieldsUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'paymentHistory', 'refundHistory', 'paymentStatus', 'status',
          'paymentStatusCanonical', 'invoiceStatus', 'invoiceAmount',
          'paidAmount', 'dpAmount', 'refundedAmount', 'refundStatus',
          'lastPaymentAt', 'lastPaymentMethod', 'lastRefundAt',
          'lastRefundMethod', 'lastRefundReason', 'refundCompletedAt',
          'paymentStatusBeforeRefund', 'voidReason', 'voidedAt',
          'lastFinanceAction', 'lastFinanceBusinessDate', 'lastFinanceEventId',
          'lastFinanceLedgerEntryId', 'lastFinanceOperationId', 'lastFinanceProofId',
          'voidedByName', 'voidedByUid', 'paymentMethod', 'total',
          'subtotal', 'discountAmount', 'appliedDiscounts',
          'bookingCode', 'bookingId', 'invoiceNumber'
        ]);
    }

    function validClientMessageSummary(data) {
      return validString(data.lastMessageId, 1, 128) &&
        validIsoTimestampString(data.lastMessageAt) &&
        validString(data.lastMessagePreview, 1, 180) &&
        data.lastMessageSenderRole == 'client' &&
        data.lastMessageReadByAdmin == false &&
        data.lastMessageReadByClient == true;
    }

    function clientMessageExistsAfter(bookingId) {
      let messageId = request.resource.data.lastMessageId;
      let messagePath = /databases/$(database)/documents/bookingMessages/$(messageId);
      return existsAfter(messagePath) &&
        getAfter(messagePath).data.bookingId == bookingId &&
        getAfter(messagePath).data.clientUid == request.auth.uid &&
        getAfter(messagePath).data.senderUid == request.auth.uid &&
        getAfter(messagePath).data.senderRole == 'client';
    }

    function clientSendsBookingMessage(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId);
    }

    function clientRequestsBookingCancellation(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bookingRequestStatus', 'clientRequestNote', 'clientRequestUpdatedAt',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        resource.data.bookingRequestStatus in ['submitted', 'confirmed'] &&
        request.resource.data.bookingRequestStatus == 'cancellation_requested' &&
        validString(request.resource.data.clientRequestNote, 1, 600) &&
        validIsoTimestampString(request.resource.data.clientRequestUpdatedAt) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId) &&
        getAfter(/databases/$(database)/documents/bookingMessages/$(request.resource.data.lastMessageId)).data.type == 'cancellation';
    }

    function clientMarksLatestMessageRead() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageReadByClient']) &&
        resource.data.lastMessageSenderRole == 'admin' &&
        request.resource.data.lastMessageReadByClient == true;
    }

    function clientCreateIdentityMatches(data) {
      return isSignedIn() &&
        data.clientUid is string &&
        data.clientUid == request.auth.uid &&
        data.customerId is string &&
        data.customerId == ('auth_' + request.auth.uid) &&
        (
          !data.keys().hasAny(['email']) ||
          data.email == '' ||
          (
            request.auth.token.email is string &&
            data.email is string &&
            data.email.lower() == request.auth.token.email.lower()
          )
        );
    }

    function isSafeClientBookingRequestCreate(data, documentId) {
      return data.keys().hasOnly([
          'id', 'customer', 'phone', 'customerPhoneKey', 'email', 'clientUid',
          'customerId', 'source', 'bookingRequestStatus', 'clientRequestUpdatedAt',
          'packageId', 'packageLabel', 'pricingMode', 'sessionType', 'sessionLabel',
          'recordingTypeId', 'recordingTypeLabel', 'title', 'date', 'startHour',
          'startTimeLabel', 'durationHours', 'paymentMethod', 'paymentHistory',
          'paidAmount', 'lastPaymentAt', 'lastPaymentMethod', 'paymentStatus',
          'status', 'subtotal', 'discountAmount', 'appliedDiscounts', 'total',
          'dpAmount', 'invoiceAmount', 'createdAt', 'updatedAt', 'bookingCode',
          'bookingId', 'invoiceNumber'
        ]) &&
        data.id == documentId &&
        clientCreateIdentityMatches(data) &&
        data.source == 'clientPortal' &&
        data.bookingRequestStatus == 'submitted' &&
        data.paymentStatus == 'pending' &&
        data.status == 'pending' &&
        validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.customerPhoneKey, 0, 32) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.customerId, 1, 160) &&
        validString(data.bookingId, 1, 120) &&
        validString(data.bookingCode, 1, 120) &&
        validString(data.invoiceNumber, 1, 120) &&
        validString(data.title, 1, 160) &&
        validString(data.sessionLabel, 1, 160) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.subtotal, 0, 100000000) &&
        validNumber(data.discountAmount, 0, 100000000) &&
        validNumber(data.total, 0, 100000000) &&
        data.invoiceAmount == data.total &&
        data.paidAmount == 0 &&
        data.dpAmount == 0 &&
        data.paymentHistory is list &&
        data.paymentHistory.size() == 0 &&
        (!data.keys().hasAny(['appliedDiscounts']) || data.appliedDiscounts is list) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        (
          !data.keys().hasAny(['clientRequestUpdatedAt']) ||
          validIsoTimestampString(data.clientRequestUpdatedAt)
        );
    }

    function bookingScheduleDayMatchesAfter(dateId, bookingId, updatedAt) {
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(dateId);
      let dayAfter = getAfter(dayPath).data;
      return existsAfter(dayPath) &&
        dayAfter.date == dateId &&
        dayAfter.lastBookingId == bookingId &&
        dayAfter.updatedAt == updatedAt;
    }

    function validBookingScheduleDay(data, dateId) {
      return data.keys().hasOnly(['date', 'lastBookingId', 'revision', 'updatedAt']) &&
        data.date == dateId &&
        validIsoDate(data.date) &&
        validString(data.lastBookingId, 1, 160) &&
        data.revision is int &&
        data.revision >= 1 &&
        validIsoTimestampString(data.updatedAt);
    }

    function validCalendarSlot(data) {
      return data.keys().hasOnly([
          'bookingId', 'date', 'durationHours', 'sessionLabel',
          'startHour', 'status', 'title', 'updatedAt'
        ]) &&
        validString(data.title, 1, 80);
    }

    function bookingIsScheduleBlocking(data) {
      return (
          !data.keys().hasAny(['bookingRequestStatus']) ||
          !(data.bookingRequestStatus in ['submitted', 'rejected', 'cancelled', 'void'])
        ) &&
        (
          !data.keys().hasAny(['requestStatus']) ||
          !(data.requestStatus in ['submitted', 'rejected', 'cancelled', 'canceled', 'deleted', 'void'])
        ) &&
        (
          !data.keys().hasAny(['sessionStatus']) ||
          !(data.sessionStatus in ['cancelled', 'canceled', 'rejected', 'deleted', 'void'])
        ) &&
        !(data.status in ['cancelled', 'canceled', 'rejected', 'deleted', 'void']) &&
        !(data.paymentStatus in ['cancelled', 'canceled', 'rejected', 'deleted', 'void']);
    }

    function bookingRequiresPublicSlot(data) {
      return data.durationHours is number &&
        data.durationHours > 0 &&
        bookingIsScheduleBlocking(data);
    }

    function bookingCalendarSlotFieldsMatchAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let slotAfter = getAfter(slotPath).data;
      return existsAfter(slotPath) &&
        validCalendarSlot(slotAfter) &&
        slotAfter.bookingId == bookingId &&
        slotAfter.date == data.date &&
        slotAfter.durationHours == data.durationHours &&
        slotAfter.startHour == data.startHour &&
        slotAfter.sessionLabel == data.sessionLabel &&
        (
          slotAfter.title == 'Terisi' ||
          slotAfter.title == data.sessionLabel
        ) &&
        slotAfter.status == data.paymentStatus &&
        slotAfter.updatedAt == data.updatedAt;
    }

    function bookingCalendarSlotMatchesAfter(bookingId, data) {
      return bookingCalendarSlotFieldsMatchAfter(bookingId, data) &&
        bookingScheduleDayMatchesAfter(data.date, bookingId, data.updatedAt);
    }

    function bookingSlotStateMatchesAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      return bookingRequiresPublicSlot(data)
        ? bookingCalendarSlotFieldsMatchAfter(bookingId, data)
        : !existsAfter(slotPath);
    }

    function validManualInitialPaymentRecord(payment, bookingData) {
      return payment is map &&
        payment.keys().hasOnly([
          'actorName', 'actorUid', 'amount', 'createdAt', 'date',
          'id', 'idempotencyKey', 'method', 'note', 'source'
        ]) &&
        validString(payment.actorName, 1, 120) &&
        payment.actorName == bookingData.initialPaymentIntent.actorName &&
        payment.actorUid == bookingData.initialPaymentIntent.actorUid &&
        validNumber(payment.amount, 1, bookingData.total) &&
        payment.createdAt == bookingData.createdAt &&
        payment.date == bookingData.createdAt[0:10] &&
        validString(payment.id, 1, 80) &&
        validString(payment.idempotencyKey, 8, 128) &&
        payment.method in ['cash', 'transfer', 'qris', 'other'] &&
        validString(payment.note, 0, 600) &&
        payment.source == 'manual-booking-create';
    }

    function validManualBookingCreate(data, bookingId) {
      return data.keys().hasAll(['initialPaymentLedgerStatus', 'initialPaymentIntent']) &&
        data.keys().hasOnly([
          'appliedDiscounts', 'bandName', 'bookingCode', 'bookingId',
          'bookingRequestStatus', 'clientUid', 'createdAt', 'customer',
          'customerId', 'customerIdentityMode', 'customerPhoneKey', 'date',
          'discountAmount', 'dpAmount', 'durationHours', 'email', 'id',
          'initialPaymentIntent', 'initialPaymentLedgerStatus', 'invoiceAmount',
          'invoiceNumber', 'lastPaymentAt', 'lastPaymentMethod', 'packageId',
          'packageLabel', 'paidAmount', 'paymentHistory', 'paymentMethod',
          'paymentStatus', 'paymentStatusCanonical', 'phone', 'pricingMode',
          'recordingTypeId', 'recordingTypeLabel', 'refundHistory', 'refundedAmount',
          'sessionLabel', 'sessionStatus', 'sessionType', 'source', 'startHour',
          'startTimeLabel', 'status', 'subtotal', 'title', 'total', 'updatedAt'
        ]) &&
        data.id == bookingId &&
        validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0.5, 24) &&
        validNumber(data.total, 0, 100000000) &&
        (!data.keys().hasAny(['email']) || validString(data.email, 0, 254)) &&
        (!data.keys().hasAny(['clientUid']) || validString(data.clientUid, 0, 128)) &&
        (!data.keys().hasAny(['title']) || validString(data.title, 0, 160)) &&
        data.source == 'admin' &&
        data.bookingRequestStatus == 'confirmed' &&
        data.sessionStatus == 'scheduled' &&
        data.status == 'pending' &&
        data.bookingRequestStatus == 'confirmed' &&
        validString(data.bookingCode, 1, 120) &&
        data.bookingId == data.bookingCode &&
        validString(data.invoiceNumber, 1, 120) &&
        validString(data.pricingMode, 1, 40) &&
        validString(data.sessionType, 1, 80) &&
        validString(data.sessionLabel, 1, 160) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validNumber(data.subtotal, 0, 100000000) &&
        validNumber(data.discountAmount, 0, 100000000) &&
        data.invoiceAmount == data.total &&
        data.refundHistory is list &&
        data.refundHistory.size() == 0 &&
        data.refundedAmount == 0 &&
        data.paymentHistory is list &&
        data.paymentHistory.size() == 0 &&
        data.paymentStatus == 'pending' &&
        data.paymentStatusCanonical == 'unpaid' &&
        data.paymentMethod == '' &&
        data.lastPaymentAt == '' &&
        data.lastPaymentMethod == '' &&
        data.paidAmount == 0 &&
        data.dpAmount == 0 &&
        (
          (
            data.initialPaymentIntent == null &&
            data.initialPaymentLedgerStatus == 'not_required'
          ) ||
          (
            data.initialPaymentIntent is map &&
            data.initialPaymentIntent.keys().hasOnly([
              'actorName', 'actorUid', 'amount', 'createdAt', 'date',
              'id', 'idempotencyKey', 'method', 'note', 'source'
            ]) &&
            data.initialPaymentIntent.actorUid == request.auth.uid &&
            data.initialPaymentIntent.actorName is string &&
            data.initialPaymentIntent.amount is number &&
            data.initialPaymentIntent.amount > 0 &&
            data.initialPaymentIntent.amount <= data.total &&
            data.initialPaymentIntent.method in ['cash', 'transfer', 'qris', 'other'] &&
            data.initialPaymentIntent.createdAt == data.createdAt &&
            data.initialPaymentIntent.date == data.createdAt[0:10] &&
            data.initialPaymentLedgerStatus == 'pending'
          )
        );
    }

    function bookingManualCreateCompanionsAfter(bookingId, data) {
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(data.date);
      let slotAfter = getAfter(slotPath).data;
      let dayAfter = getAfter(dayPath).data;
      return data.durationHours > 0
        ? (
            existsAfter(slotPath) &&
            slotAfter.bookingId == bookingId &&
            slotAfter.date == data.date &&
            slotAfter.updatedAt == data.updatedAt &&
            existsAfter(dayPath) &&
            dayAfter.date == data.date &&
            dayAfter.lastBookingId == bookingId &&
            dayAfter.updatedAt == data.updatedAt
          )
        : !existsAfter(slotPath);
    }

    function adminBookingManualUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let scheduleChanged = changed.hasAny([
        'date', 'startHour', 'durationHours', 'duration', 'sessionLabel'
      ]);
      return changed.hasOnly([
          'bandName', 'clientUid', 'customer', 'customerId',
          'customerIdentityMode', 'customerPhoneKey', 'date', 'duration',
          'durationHours', 'email', 'internalNotes', 'notes', 'packageId',
          'packageLabel', 'pricingMode', 'recordingTypeId', 'recordingTypeLabel',
          'sessionLabel', 'sessionType', 'startHour', 'startTimeLabel',
          'title', 'updatedAt'
        ]) &&
        validString(request.resource.data.customer, 1, 120) &&
        validString(request.resource.data.phone, 0, 32) &&
        validIsoDate(request.resource.data.date) &&
        validNumber(request.resource.data.startHour, 0, 23) &&
        validNumber(request.resource.data.durationHours, 0, 24) &&
        validOptionalString(request.resource.data, 'clientUid', 128) &&
        validOptionalString(request.resource.data, 'email', 254) &&
        validOptionalString(request.resource.data, 'title', 160) &&
        validOptionalString(request.resource.data, 'sessionLabel', 160) &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        (
          !scheduleChanged ||
          (
            (
              resource.data.date == request.resource.data.date
                ? bookingScheduleDayMatchesAfter(request.resource.data.date, bookingId, request.resource.data.updatedAt)
                : (
                    bookingScheduleDayMatchesAfter(resource.data.date, bookingId, request.resource.data.updatedAt) &&
                    bookingScheduleDayMatchesAfter(request.resource.data.date, bookingId, request.resource.data.updatedAt)
                  )
            ) &&
            bookingSlotStateMatchesAfter(bookingId, request.resource.data)
          )
        );
    }


    function repositoryOperationMatchesAfter(operationId, scope, action, resultCollection, resultId) {
      let markerPath = /databases/$(database)/documents/users/$(request.auth.uid)/repositoryOperations/$(operationId);
      let markerAfter = getAfter(markerPath).data;
      return existsAfter(markerPath) &&
        markerAfter.operationId == operationId &&
        markerAfter.actorUid == request.auth.uid &&
        markerAfter.scope == scope &&
        markerAfter.action == action &&
        markerAfter.resultCollection == resultCollection &&
        markerAfter.resultId == resultId;
    }

    function financeBookingNetPaid(data) {
      let status = data.get('paymentStatusCanonical', data.get('paymentStatus', ''));
      let paid = data.get('paidAmount', 0);
      let deposit = data.get('dpAmount', 0);
      let projectionPaid = paid is number && paid > 0
        ? paid
        : (deposit is number && deposit > 0 ? deposit : 0);
      let total = data.get('total', data.get('subtotal', 0));
      return status in ['void', 'refunded']
        ? 0
        : (status in ['paid', 'lunas'] && total is number && total > projectionPaid
          ? total
          : projectionPaid);
    }

    function financeBookingOutstanding(data) {
      let total = data.get('total', -1);
      let subtotal = data.get('subtotal', -1);
      let netPaid = financeBookingNetPaid(data);
      let invoiceTotal = total is number ? total : subtotal;
      return invoiceTotal is number && invoiceTotal >= 0
        ? (invoiceTotal > netPaid ? invoiceTotal - netPaid : 0)
        : data.get('invoiceAmount', 0);
    }

    function financeBookingPaymentUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let history = bookingAfter.paymentHistory;
      let event = history[history.size() - 1];
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(bookingAfter.lastFinanceLedgerEntryId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(bookingAfter.lastFinanceBusinessDate + '__main');
      let closingAfter = getAfter(closingPath).data;
      let currentPaid = financeBookingNetPaid(resource.data);
      let currentOutstanding = financeBookingOutstanding(resource.data);
      return changed.hasOnly([
          'paymentHistory', 'invoiceAmount', 'paidAmount', 'paymentStatus',
          'paymentStatusCanonical', 'dpAmount', 'lastPaymentAt',
          'lastPaymentMethod', 'updatedAt', 'lastFinanceAction',
          'lastFinanceBusinessDate', 'lastFinanceEventId',
          'lastFinanceLedgerEntryId', 'lastFinanceOperationId',
          'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.lastFinanceAction in ['payment', 'proof-approve'] &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        bookingAfter.lastFinanceOperationId is string &&
        bookingAfter.lastFinanceEventId is string &&
        bookingAfter.lastFinanceLedgerEntryId is string &&
        bookingAfter.lastFinanceProofId is string &&
        history is list &&
        history.size() == resource.data.get('paymentHistory', []).size() + 1 &&
        event.id == bookingAfter.lastFinanceEventId &&
        event.operationId == bookingAfter.lastFinanceOperationId &&
        event.ledgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        event.actorUid == request.auth.uid &&
        event.amount is number &&
        event.amount > 0 &&
        event.amount <= currentOutstanding &&
        bookingAfter.paidAmount == currentPaid + event.amount &&
        bookingAfter.invoiceAmount == currentOutstanding - event.amount &&
        event.date == bookingAfter.lastFinanceBusinessDate &&
        event.method in ['cash', 'transfer', 'qris', 'other'] &&
        existsAfter(ledgerPath) &&
        ledgerAfter.id == bookingAfter.lastFinanceLedgerEntryId &&
        ledgerAfter.operationId == bookingAfter.lastFinanceOperationId &&
        ledgerAfter.source == 'booking-payment' &&
        ledgerAfter.sourceAction == 'payment' &&
        ledgerAfter.sourceBookingId == bookingId &&
        ledgerAfter.sourceEventId == event.id &&
        ledgerAfter.amount == event.amount &&
        ledgerAfter.paymentMethod == event.method &&
        ledgerAfter.sourceProofId == bookingAfter.lastFinanceProofId &&
        ledgerAfter.actorUid == request.auth.uid &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == bookingAfter.lastFinanceAction &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == bookingId &&
        closingAfter.lastLedgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        closingAfter.lastProofId == bookingAfter.lastFinanceProofId &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          bookingAfter.lastFinanceAction,
          'bookings',
          bookingId
        );
    }

    function financeBookingRefundUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let history = bookingAfter.refundHistory;
      let event = history[history.size() - 1];
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(bookingAfter.lastFinanceLedgerEntryId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(bookingAfter.lastFinanceBusinessDate + '__main');
      let closingAfter = getAfter(closingPath).data;
      let currentPaid = financeBookingNetPaid(resource.data);
      let currentOutstanding = financeBookingOutstanding(resource.data);
      return changed.hasOnly([
          'refundHistory', 'invoiceAmount', 'paidAmount', 'paymentStatus',
          'paymentStatusCanonical', 'refundedAmount', 'lastRefundAt',
          'lastRefundMethod', 'lastRefundReason', 'refundStatus',
          'updatedAt', 'lastFinanceAction', 'lastFinanceBusinessDate',
          'lastFinanceEventId', 'lastFinanceLedgerEntryId',
          'lastFinanceOperationId', 'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.lastFinanceAction == 'refund' &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        bookingAfter.lastFinanceOperationId is string &&
        bookingAfter.lastFinanceEventId is string &&
        bookingAfter.lastFinanceLedgerEntryId is string &&
        bookingAfter.lastFinanceProofId == '' &&
        history is list &&
        history.size() == resource.data.get('refundHistory', []).size() + 1 &&
        event.id == bookingAfter.lastFinanceEventId &&
        event.operationId == bookingAfter.lastFinanceOperationId &&
        event.ledgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        event.actorUid == request.auth.uid &&
        event.amount is number &&
        event.amount > 0 &&
        event.amount <= currentPaid &&
        bookingAfter.paidAmount == currentPaid - event.amount &&
        bookingAfter.invoiceAmount == currentOutstanding + event.amount &&
        event.date == bookingAfter.lastFinanceBusinessDate &&
        event.method in ['cash', 'transfer', 'qris', 'other'] &&
        existsAfter(ledgerPath) &&
        ledgerAfter.id == bookingAfter.lastFinanceLedgerEntryId &&
        ledgerAfter.operationId == bookingAfter.lastFinanceOperationId &&
        ledgerAfter.source == 'booking-refund' &&
        ledgerAfter.sourceAction == 'refund' &&
        ledgerAfter.sourceBookingId == bookingId &&
        ledgerAfter.sourceEventId == event.id &&
        ledgerAfter.amount == event.amount &&
        ledgerAfter.paymentMethod == event.method &&
        ledgerAfter.sourceProofId == '' &&
        ledgerAfter.actorUid == request.auth.uid &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == 'refund' &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == bookingId &&
        closingAfter.lastLedgerEntryId == bookingAfter.lastFinanceLedgerEntryId &&
        closingAfter.lastProofId == '' &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          'refund',
          'bookings',
          bookingId
        );
    }

    function financeBookingVoidScheduleMatchesAfter(bookingId, bookingAfter) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let dayPath = /databases/$(database)/documents/bookingScheduleDays/$(bookingAfter.date);
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let dayAfter = getAfter(dayPath).data;
      let bookingBefore = get(bookingPath).data;
      return exists(bookingPath) &&
        existsAfter(dayPath) &&
        validBookingScheduleDay(dayAfter, bookingAfter.date) &&
        dayAfter.lastBookingId == bookingId &&
        dayAfter.updatedAt == bookingAfter.updatedAt &&
        bookingBefore.updatedAt != bookingAfter.updatedAt &&
        !existsAfter(slotPath);
    }

    function financeBookingVoidUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let bookingAfter = request.resource.data;
      let closingId = bookingAfter.lastFinanceBusinessDate + '__main';
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let closingAfter = getAfter(closingPath).data;
      return changed.hasOnly([
          'invoiceAmount', 'invoiceStatus', 'paymentStatus',
          'paymentStatusCanonical', 'updatedAt', 'voidReason',
          'voidedAt', 'voidedByName', 'voidedByUid',
          'lastFinanceAction', 'lastFinanceBusinessDate',
          'lastFinanceEventId', 'lastFinanceLedgerEntryId',
          'lastFinanceOperationId', 'lastFinanceProofId'
        ]) &&
        bookingAfter.id == bookingId &&
        bookingAfter.lastFinanceAction == 'void' &&
        financeBookingNetPaid(resource.data) == 0 &&
        bookingAfter.lastFinanceLedgerEntryId == '' &&
        bookingAfter.lastFinanceProofId == '' &&
        bookingAfter.paymentStatus == 'void' &&
        bookingAfter.paymentStatusCanonical == 'void' &&
        validString(bookingAfter.voidReason, 4, 600) &&
        validIsoTimestampString(bookingAfter.voidedAt) &&
        bookingAfter.voidedByUid == request.auth.uid &&
        validIsoDate(bookingAfter.lastFinanceBusinessDate) &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == 'void' &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == bookingId &&
        closingAfter.lastLedgerEntryId == '' &&
        closingAfter.lastProofId == '' &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          'void',
          'bookings',
          bookingId
        ) &&
        financeBookingVoidScheduleMatchesAfter(bookingId, bookingAfter);
    }

    function adminBookingFinanceUpdateAllowed(bookingId) {
      let action = request.resource.data.get('lastFinanceAction', '');
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        validBooking(request.resource.data) &&
        (
          action in ['payment', 'proof-approve']
            ? financeBookingPaymentUpdateAllowed(bookingId)
            : action == 'refund'
              ? financeBookingRefundUpdateAllowed(bookingId)
              : action == 'void'
                ? financeBookingVoidUpdateAllowed(bookingId)
                : false
        );
    }

    function validBookingSessionEvent(data, eventId) {
      return data.keys().hasOnly([
          'action', 'actorName', 'actorUid', 'bookingId', 'createdAt',
          'fromStatus', 'id', 'reason', 'toStatus', 'type'
        ]) &&
        data.id == eventId &&
        data.action in ['check_in', 'start', 'complete', 'no_show', 'cancelled'] &&
        validString(data.actorName, 1, 120) &&
        data.actorUid == request.auth.uid &&
        validString(data.bookingId, 1, 160) &&
        validIsoTimestampString(data.createdAt) &&
        data.fromStatus in ['upcoming', 'in_progress'] &&
        validString(data.reason, 0, 600) &&
        data.toStatus in ['upcoming', 'in_progress', 'completed', 'no_show', 'cancelled'] &&
        data.type == 'booking-session-event';
    }

    function bookingSessionEventMatchesAfter(eventId, bookingId, eventTimestamp, action, toStatus) {
      let eventPath = /databases/$(database)/documents/bookingSessionEvents/$(eventId);
      let eventAfter = getAfter(eventPath).data;
      return existsAfter(eventPath) &&
        eventAfter.id == eventId &&
        eventAfter.bookingId == bookingId &&
        eventAfter.createdAt == eventTimestamp &&
        eventAfter.action == action &&
        eventAfter.toStatus == toStatus;
    }

    function bookingSessionEventReferencesBookingAfter(eventId) {
      let bookingId = request.resource.data.bookingId;
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return existsAfter(bookingPath) &&
        bookingAfter.keys().hasAll([
          'lastSessionEventId', 'lastSessionEventType', 'lastSessionEventAt', 'updatedAt'
        ]) &&
        bookingAfter.lastSessionEventId == eventId &&
        bookingAfter.lastSessionEventType == request.resource.data.action &&
        bookingAfter.lastSessionEventAt == request.resource.data.createdAt &&
        bookingAfter.updatedAt == request.resource.data.createdAt;
    }

    function bookingRequestAllowsSession(data) {
      return (
          !data.keys().hasAny(['bookingRequestStatus']) ||
          !(data.bookingRequestStatus in ['submitted', 'rejected', 'cancelled', 'canceled'])
        ) &&
        (
          !data.keys().hasAny(['requestStatus']) ||
          !(data.requestStatus in ['submitted', 'rejected', 'cancelled', 'canceled', 'deleted'])
        );
    }

    function bookingSessionIsUpcoming(data) {
      return bookingRequestAllowsSession(data) && (
        (
          data.keys().hasAny(['sessionStatus']) &&
          data.sessionStatus in ['upcoming', 'scheduled']
        ) ||
        (
          !data.keys().hasAny(['sessionStatus']) &&
          (
            !data.keys().hasAny(['sessionState']) ||
            data.sessionState in ['upcoming', 'scheduled']
          )
        )
      );
    }

    function bookingSessionIsInProgress(data) {
      return bookingRequestAllowsSession(data) && (
        (
          data.keys().hasAny(['sessionStatus']) &&
          data.sessionStatus in ['in_progress', 'active', 'ongoing']
        ) ||
        (
          !data.keys().hasAny(['sessionStatus']) &&
          data.keys().hasAny(['sessionState']) &&
          data.sessionState in ['in_progress', 'active', 'ongoing']
        )
      );
    }

    function bookingNoShowGraceElapsed(data) {
      let localNow = request.time + duration.value(7, 'h');
      let scheduledDate = timestamp.date(
        int(data.date[0:4]),
        int(data.date[5:7]),
        int(data.date[8:10])
      );
      return data.startHour is int &&
        (
          localNow.date() > scheduledDate ||
          (
            localNow.date() == scheduledDate &&
            localNow.time() >= duration.time(data.startHour, 15, 0, 0)
          )
        );
    }

    function adminBookingSessionActionUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let eventId = request.resource.data.lastSessionEventId;
      let eventPath = /databases/$(database)/documents/bookingSessionEvents/$(eventId);
      let eventAfter = getAfter(eventPath).data;
      return changed.hasOnly([
          'checkedInAt', 'checkedInByUid', 'checkedInByName',
          'sessionStatus', 'actualStartAt', 'actualStartByUid',
          'actualStartByName', 'actualEndAt', 'actualEndByUid',
          'actualEndByName', 'actualDurationMinutes', 'noShowAt',
          'noShowByUid', 'noShowByName', 'noShowReason', 'updatedAt',
          'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
        ]) &&
        existsAfter(eventPath) &&
        validBookingSessionEvent(eventAfter, eventId) &&
        eventAfter.bookingId == bookingId &&
        eventAfter.actorUid == request.auth.uid &&
        request.resource.data.updatedAt == eventAfter.createdAt &&
        request.resource.data.lastSessionEventAt == eventAfter.createdAt &&
        request.resource.data.lastSessionEventType == eventAfter.action &&
        eventAfter.id == eventId &&
        (
          (
            eventAfter.action == 'check_in' &&
            changed.hasOnly([
              'checkedInAt', 'checkedInByUid', 'checkedInByName', 'updatedAt',
              'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            (
              !resource.data.keys().hasAny(['checkedInAt']) ||
              resource.data.checkedInAt == ''
            ) &&
            request.resource.data.checkedInAt == eventAfter.createdAt &&
            request.resource.data.checkedInByUid == request.auth.uid &&
            request.resource.data.checkedInByName is string &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'upcoming' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'start' &&
            changed.hasOnly([
              'sessionStatus', 'actualStartAt', 'actualStartByUid', 'actualStartByName',
              'updatedAt', 'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            request.resource.data.sessionStatus == 'in_progress' &&
            request.resource.data.actualStartAt == eventAfter.createdAt &&
            request.resource.data.actualStartByUid == request.auth.uid &&
            request.resource.data.actualStartByName is string &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'in_progress' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'complete' &&
            changed.hasOnly([
              'sessionStatus', 'actualEndAt', 'actualEndByUid', 'actualEndByName',
              'actualDurationMinutes', 'updatedAt', 'lastSessionEventAt',
              'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsInProgress(resource.data) &&
            request.resource.data.sessionStatus == 'completed' &&
            request.resource.data.actualEndAt == eventAfter.createdAt &&
            request.resource.data.actualEndByUid == request.auth.uid &&
            request.resource.data.actualEndByName is string &&
            request.resource.data.actualDurationMinutes is int &&
            request.resource.data.actualDurationMinutes >= 1 &&
            request.resource.data.actualDurationMinutes <= 1440 &&
            eventAfter.fromStatus == 'in_progress' &&
            eventAfter.toStatus == 'completed' &&
            eventAfter.reason == ''
          ) ||
          (
            eventAfter.action == 'no_show' &&
            changed.hasOnly([
              'sessionStatus', 'noShowAt', 'noShowByUid', 'noShowByName',
              'noShowReason', 'updatedAt', 'lastSessionEventAt',
              'lastSessionEventType', 'lastSessionEventId'
            ]) &&
            bookingSessionIsUpcoming(resource.data) &&
            (
              !resource.data.keys().hasAny(['checkedInAt']) ||
              resource.data.checkedInAt == ''
            ) &&
            request.resource.data.sessionStatus == 'no_show' &&
            request.resource.data.noShowAt == eventAfter.createdAt &&
            request.resource.data.noShowByUid == request.auth.uid &&
            request.resource.data.noShowByName is string &&
            validString(request.resource.data.noShowReason, 4, 600) &&
            request.resource.data.noShowReason == eventAfter.reason &&
            eventAfter.fromStatus == 'upcoming' &&
            eventAfter.toStatus == 'no_show' &&
            bookingNoShowGraceElapsed(resource.data)
          )
        );
    }

    function bookingMessagePreview(messageText) {
      return messageText.size() > 180
        ? messageText[0:180]
        : messageText;
    }

    function bookingDecisionMessageMatchesAfter(bookingId, messageId) {
      let messagePath = /databases/$(database)/documents/bookingMessages/$(messageId);
      let messageAfter = getAfter(messagePath).data;
      return existsAfter(messagePath) &&
        messageAfter.id == messageId &&
        messageAfter.bookingId == bookingId &&
        messageAfter.clientUid == request.resource.data.clientUid &&
        messageAfter.senderUid == request.auth.uid &&
        messageAfter.senderRole == 'admin' &&
        messageAfter.type == 'status' &&
        messageAfter.text == request.resource.data.adminResponseNote &&
        messageAfter.createdAt == request.resource.data.adminResponseAt &&
        messageAfter.readByAdmin == true &&
        messageAfter.readByClient == false &&
        request.resource.data.lastMessageId == messageId &&
        request.resource.data.lastMessageAt == messageAfter.createdAt &&
        request.resource.data.lastMessagePreview == bookingMessagePreview(messageAfter.text) &&
        request.resource.data.lastMessageSenderRole == 'admin' &&
        request.resource.data.lastMessageReadByAdmin == true &&
        request.resource.data.lastMessageReadByClient == false;
    }


    function bookingMessageDecisionReferencesBookingAfter(bookingId, messageId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      return exists(bookingPath) &&
        existsAfter(bookingPath) &&
        bookingAfter.lastMessageId == messageId &&
        bookingAfter.lastMessageAt == request.resource.data.createdAt &&
        bookingAfter.lastMessagePreview == bookingMessagePreview(request.resource.data.text) &&
        bookingAfter.lastMessageSenderRole == 'admin' &&
        bookingAfter.lastMessageReadByAdmin == true &&
        bookingAfter.lastMessageReadByClient == false &&
        bookingAfter.adminResponseNote == request.resource.data.text &&
        bookingAfter.adminResponseAt == request.resource.data.createdAt &&
        bookingAfter.clientUid == request.resource.data.clientUid &&
        bookingAfter.bookingRequestStatus in ['confirmed', 'rejected', 'cancelled'] &&
        bookingAfter.updatedAt == request.resource.data.createdAt &&
        (
          !bookingBefore.keys().hasAny(['lastMessageId']) ||
          bookingBefore.lastMessageId != messageId
        );
    }

    function adminBookingDecisionUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let nextStatus = request.resource.data.bookingRequestStatus;
      let messageId = request.resource.data.lastMessageId;
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      return changed.hasOnly([
          'adminResponseAt', 'adminResponseBy', 'adminResponseNote',
          'bookingRequestStatus', 'requestStatus', 'lastRequestDecisionKey',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin',
          'lastMessageReadByClient', 'updatedAt', 'sessionStatus',
          'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
        ]) &&
        (
          nextStatus == 'cancelled' ||
          !changed.hasAny([
            'sessionStatus', 'lastSessionEventAt', 'lastSessionEventType', 'lastSessionEventId'
          ])
        ) &&
        validString(request.resource.data.lastRequestDecisionKey, 8, 128) &&
        messageId == 'request-' + request.resource.data.lastRequestDecisionKey &&
        validIsoTimestampString(request.resource.data.updatedAt) &&
        request.resource.data.adminResponseAt == request.resource.data.updatedAt &&
        request.resource.data.adminResponseBy == request.auth.uid &&
        validString(request.resource.data.adminResponseNote, 0, 600) &&
        request.resource.data.requestStatus == nextStatus &&
        (
          (
            resource.data.bookingRequestStatus == 'submitted' &&
            nextStatus in ['confirmed', 'rejected']
          ) ||
          (
            resource.data.bookingRequestStatus == 'cancellation_requested' &&
            nextStatus in ['cancelled', 'confirmed']
          )
        ) &&
        bookingDecisionMessageMatchesAfter(bookingId, messageId) &&
        bookingScheduleDayMatchesAfter(resource.data.date, bookingId, request.resource.data.updatedAt) &&
        (
          nextStatus == 'confirmed'
            ? bookingSlotStateMatchesAfter(bookingId, request.resource.data)
            : !existsAfter(slotPath)
        ) &&
        (
          nextStatus != 'cancelled' ||
          (
            request.resource.data.sessionStatus == 'cancelled' &&
            bookingSessionEventMatchesAfter(
              request.resource.data.lastSessionEventId,
              bookingId,
              request.resource.data.updatedAt,
              'cancelled',
              'cancelled'
            ) &&
            getAfter(/databases/$(database)/documents/bookingSessionEvents/$(request.resource.data.lastSessionEventId)).data.fromStatus == 'upcoming' &&
            getAfter(/databases/$(database)/documents/bookingSessionEvents/$(request.resource.data.lastSessionEventId)).data.reason == request.resource.data.adminResponseNote
          )
        );
    }

    function adminBookingInitialPaymentLedgerUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let paymentHistory = request.resource.data.paymentHistory;
      let payment = paymentHistory is list && paymentHistory.size() == 1
        ? paymentHistory[0]
        : {};
      let ledgerId = paymentHistory is list && paymentHistory.size() == 1
        ? 'booking-payment-' + bookingId + '-' + payment.id
        : 'invalid-initial-payment-ledger';
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(ledgerId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let slotPath = /databases/$(database)/documents/clientCalendarSlots/$(bookingId);
      let slotAfter = getAfter(slotPath).data;
      let total = resource.data.total;
      let amount = payment.amount;
      let isPaid = total > 0 && amount >= total;
      return changed.hasOnly([
          'dpAmount', 'initialPaymentLedgerStatus', 'invoiceAmount',
          'lastPaymentAt', 'lastPaymentMethod', 'paidAmount', 'paymentHistory',
          'paymentMethod', 'paymentStatus', 'paymentStatusCanonical', 'status'
        ]) &&
        resource.data.source == 'admin' &&
        resource.data.initialPaymentLedgerStatus == 'pending' &&
        resource.data.paymentHistory is list &&
        resource.data.paymentHistory.size() == 0 &&
        request.resource.data.initialPaymentLedgerStatus == 'recorded' &&
        paymentHistory is list &&
        paymentHistory.size() == 1 &&
        payment == resource.data.initialPaymentIntent &&
        validManualInitialPaymentRecord(payment, resource.data) &&
        request.resource.data.paidAmount == amount &&
        request.resource.data.paymentMethod == payment.method &&
        request.resource.data.lastPaymentAt == payment.createdAt &&
        request.resource.data.lastPaymentMethod == payment.method &&
        request.resource.data.invoiceAmount == total - amount &&
        request.resource.data.status == request.resource.data.paymentStatus &&
        (
          (
            isPaid &&
            request.resource.data.dpAmount == 0 &&
            request.resource.data.paymentStatus == 'lunas' &&
            request.resource.data.paymentStatusCanonical == 'paid'
          ) ||
          (
            total > 0 &&
            amount < total &&
            request.resource.data.dpAmount == amount &&
            request.resource.data.paymentStatus == 'dp' &&
            request.resource.data.paymentStatusCanonical == 'partial'
          )
        ) &&
        !exists(ledgerPath) &&
        existsAfter(ledgerPath) &&
        ledgerAfter.id == ledgerId &&
        ledgerAfter.source == 'booking-payment' &&
        ledgerAfter.sourceAction == 'payment' &&
        ledgerAfter.category == 'booking' &&
        ledgerAfter.type == 'income' &&
        ledgerAfter.immutable == true &&
        ledgerAfter.reversalOf == '' &&
        ledgerAfter.sourceBookingId == bookingId &&
        ledgerAfter.sourceEventId == payment.id &&
        ledgerAfter.actorUid == payment.actorUid &&
        ledgerAfter.actorName == payment.actorName &&
        ledgerAfter.amount == amount &&
        ledgerAfter.paymentMethod == payment.method &&
        ledgerAfter.date == payment.date &&
        ledgerAfter.createdAt == payment.createdAt &&
        ledgerAfter.updatedAt == payment.createdAt &&
        ledgerAfter.idempotencyKey == payment.idempotencyKey &&
        ledgerAfter.note == payment.note &&
        ledgerAfter.title == 'Pembayaran ' + resource.data.invoiceNumber &&
        (
          bookingRequiresPublicSlot(request.resource.data)
            ? existsAfter(slotPath) &&
              slotAfter.bookingId == bookingId &&
              slotAfter.date == request.resource.data.date &&
              slotAfter.status == request.resource.data.paymentStatus
            : !existsAfter(slotPath)
        );
    }

    function adminBookingOperationalUpdate(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny([
          'bookingRequestStatus', 'adminResponseAt', 'lastRequestDecisionKey'
        ])
        ? adminBookingDecisionUpdate(bookingId)
        : changed.hasAny(['lastSessionEventId'])
          ? adminBookingSessionActionUpdate(bookingId)
          : adminBookingManualUpdate(bookingId);
    }

    function adminBookingUpdateAllowed(bookingId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasAny(['initialPaymentLedgerStatus'])
        ? isApprovedScheduleAdmin() && adminBookingInitialPaymentLedgerUpdate(bookingId)
        : changed.hasAny([
            'lastFinanceAction', 'paymentHistory', 'refundHistory'
          ])
          ? adminBookingFinanceUpdateAllowed(bookingId)
          : isApprovedScheduleAdmin() &&
          adminBookingFinanceFieldsUnchanged() &&
          adminBookingOperationalUpdate(bookingId);
    }

    match /bookings/{bookingId} {
      allow read: if (isApproved() && (canAccessBookingData() || hasPermission('bookkeeping'))) || isClientBookingOwner(resource.data);
      allow create: if (
          isApprovedScheduleAdmin() &&
          validManualBookingCreate(request.resource.data, bookingId) &&
          bookingManualCreateCompanionsAfter(bookingId, request.resource.data)
        ) || (
          isClientAccount() &&
          isSafeClientBookingRequestCreate(request.resource.data, bookingId)
        );
      allow update: if adminBookingUpdateAllowed(bookingId) || (
        isClientBookingOwner(resource.data) &&
        request.resource.data.clientUid == resource.data.clientUid &&
        (
          clientSendsBookingMessage(bookingId) ||
          clientRequestsBookingCancellation(bookingId) ||
          clientMarksLatestMessageRead()
        )
      );
      allow delete: if false;
    }

    function validPaymentProof(data, proofId) {
      return data.keys().hasOnly([
          'id', 'bookingId', 'bookingCode', 'invoiceNumber',
          'clientUid', 'customer', 'category', 'amount', 'method',
          'status', 'proofUrl', 'proofPublicId', 'proofFileName',
          'proofMimeType', 'clientNote', 'adminNote', 'createdAt',
          'updatedAt', 'reviewedAt', 'reviewedByUid', 'reviewedByName'
          , 'approvedAmount', 'approvedMethod', 'payerName',
          'transactionReference', 'reviewDecision', 'reviewOperationId'
        ]) &&
        data.id == proofId &&
        validString(data.bookingId, 1, 128) &&
        validString(data.bookingCode, 0, 120) &&
        validString(data.invoiceNumber, 0, 120) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.customer, 1, 120) &&
        data.category in ['dp', 'pelunasan'] &&
        validNumber(data.amount, 1, 100000000) &&
        data.method in ['transfer', 'qris'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        validString(data.proofUrl, 0, 1200) &&
        validString(data.proofPublicId, 0, 240) &&
        validString(data.proofFileName, 0, 240) &&
        validString(data.proofMimeType, 0, 120) &&
        validString(data.clientNote, 0, 600) &&
        validString(data.adminNote, 0, 600) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'reviewedAt', 40) &&
        validOptionalString(data, 'reviewedByUid', 128) &&
        validOptionalString(data, 'reviewedByName', 120) &&
        (!data.keys().hasAny(['approvedAmount']) || validNumber(data.approvedAmount, 1, 100000000)) &&
        (!data.keys().hasAny(['approvedMethod']) || validString(data.approvedMethod, 1, 80)) &&
        validOptionalString(data, 'payerName', 120) &&
        validOptionalString(data, 'transactionReference', 120) &&
        validOptionalString(data, 'reviewDecision', 20) &&
        validOptionalString(data, 'reviewOperationId', 80);
    }

    function clientCreatesPaymentProof(data, proofId) {
      return isSignedIn() &&
        validPaymentProof(data, proofId) &&
        data.clientUid == request.auth.uid &&
        data.status == 'pending' &&
        data.adminNote == '' &&
        data.reviewedAt == '' &&
        data.reviewedByUid == '' &&
        data.reviewedByName == '' &&
        data.reviewDecision == '' &&
        data.reviewOperationId == '' &&
        data.proofUrl == '' &&
        data.proofPublicId == '' &&
        validString(data.transactionReference, 4, 120) &&
        validString(data.payerName, 0, 120) &&
        bookingExists(data.bookingId) &&
        bookingData(data.bookingId).clientUid == request.auth.uid &&
        bookingData(data.bookingId).status != 'void' &&
        bookingData(data.bookingId).get('invoiceStatus', '') != 'void' &&
        bookingData(data.bookingId).get('paymentStatus', '') != 'void' &&
        bookingData(data.bookingId).get('paymentStatus', '') != 'refunded' &&
        bookingData(data.bookingId).get('paymentStatusCanonical', '') != 'void' &&
        bookingData(data.bookingId).get('paymentStatusCanonical', '') != 'refunded';
    }

    function validBookingMessage(data, messageId) {
      return data.keys().hasOnly([
          'id', 'bookingId', 'clientUid', 'senderUid', 'senderRole',
          'senderName', 'text', 'type', 'createdAt', 'readByAdmin', 'readByClient'
        ]) &&
        data.id == messageId &&
        validString(data.bookingId, 1, 128) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.senderUid, 1, 128) &&
        data.senderRole in ['admin', 'client'] &&
        validString(data.senderName, 1, 120) &&
        validString(data.text, 1, 600) &&
        data.type in ['message', 'status', 'cancellation'] &&
        validIsoTimestampString(data.createdAt) &&
        data.readByAdmin is bool &&
        data.readByClient is bool;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function bookingData(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }


    function approvedPaymentProofMatchesAfter(proofId) {
      let proof = request.resource.data;
      let bookingPath = /databases/$(database)/documents/bookings/$(proof.bookingId);
      let bookingAfter = getAfter(bookingPath).data;
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(bookingAfter.lastFinanceLedgerEntryId);
      let ledgerAfter = getAfter(ledgerPath).data;
      let history = bookingAfter.paymentHistory;
      let payment = history[history.size() - 1];
      return existsAfter(bookingPath) &&
        bookingAfter.lastFinanceAction == 'proof-approve' &&
        bookingAfter.lastFinanceProofId == proofId &&
        bookingAfter.lastFinanceOperationId == proof.reviewOperationId &&
        bookingAfter.lastFinanceLedgerEntryId == ledgerAfter.id &&
        payment.proofId == proofId &&
        payment.proofReference == proof.transactionReference &&
        payment.payerName == proof.payerName &&
        payment.amount == proof.approvedAmount &&
        payment.method == proof.approvedMethod &&
        payment.operationId == proof.reviewOperationId &&
        existsAfter(ledgerPath) &&
        ledgerAfter.source == 'booking-payment' &&
        ledgerAfter.sourceProofId == proofId &&
        ledgerAfter.sourceBookingId == proof.bookingId &&
        ledgerAfter.sourceEventId == payment.id &&
        ledgerAfter.operationId == proof.reviewOperationId &&
        ledgerAfter.amount == proof.approvedAmount &&
        ledgerAfter.paymentMethod == proof.approvedMethod;
    }

    function paymentProofReviewUpdateAllowed(proofId) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      let proof = request.resource.data;
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        resource.data.status == 'pending' &&
        validPaymentProof(proof, proofId) &&
        changed.hasOnly([
          'adminNote', 'approvedAmount', 'approvedMethod', 'reviewedAt',
          'reviewedByUid', 'reviewedByName', 'reviewDecision',
          'reviewOperationId', 'status', 'updatedAt'
        ]) &&
        proof.id == resource.data.id &&
        proof.bookingId == resource.data.bookingId &&
        proof.clientUid == resource.data.clientUid &&
        proof.amount == resource.data.amount &&
        proof.transactionReference == resource.data.transactionReference &&
        proof.payerName == resource.data.payerName &&
        proof.reviewedByUid == request.auth.uid &&
        validIsoTimestampString(proof.reviewedAt) &&
        validIsoTimestampString(proof.updatedAt) &&
        validString(proof.reviewOperationId, 8, 80) &&
        (
          (
            proof.status == 'rejected' &&
            proof.reviewDecision == 'rejected' &&
            validString(proof.adminNote, 4, 600) &&
            !proof.keys().hasAny(['approvedAmount', 'approvedMethod']) &&
            repositoryOperationMatchesAfter(
              proof.reviewOperationId,
              'finance',
              'proof-reject',
              'paymentProofs',
              proofId
            )
          ) ||
          (
            proof.status == 'approved' &&
            proof.reviewDecision == 'approved' &&
            validNumber(proof.approvedAmount, 1, 100000000) &&
            proof.approvedMethod in ['cash', 'transfer', 'qris', 'other'] &&
            approvedPaymentProofMatchesAfter(proofId)
          )
        );
    }

    match /paymentProofs/{proofId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if clientCreatesPaymentProof(request.resource.data, proofId);
      allow update: if paymentProofReviewUpdateAllowed(proofId);
      allow delete: if false;
    }

    match /bookingMessages/{messageId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if validBookingMessage(request.resource.data, messageId) &&
        bookingExists(request.resource.data.bookingId) && (
          (
            isApproved() &&
            canAccessBookingData() &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.senderRole == 'admin' &&
            request.resource.data.clientUid == bookingData(request.resource.data.bookingId).clientUid &&
            request.resource.data.readByAdmin == true &&
            request.resource.data.readByClient == false &&
            (request.resource.data.type != 'status' || bookingMessageDecisionReferencesBookingAfter(request.resource.data.bookingId, messageId))
          ) ||
          (
            isClientAccount() &&
            request.resource.data.clientUid == request.auth.uid &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.senderRole == 'client' &&
            bookingData(request.resource.data.bookingId).clientUid == request.auth.uid &&
            request.resource.data.readByAdmin == false &&
            request.resource.data.readByClient == true &&
            request.resource.data.type in ['message', 'cancellation']
          )
        );
      allow update: if validBookingMessage(request.resource.data, messageId) && (
        (
          isApproved() &&
          canAccessBookingData() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByAdmin']) &&
          request.resource.data.readByAdmin == true
        ) ||
        (
          isClientAccount() &&
          resource.data.clientUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByClient']) &&
          request.resource.data.readByClient == true
        )
      );
      allow delete: if isOwner();
    }

    match /bookingSessionEvents/{eventId} {
      allow read: if isApprovedScheduleAdmin();
      allow create: if isApprovedScheduleAdmin() &&
        validBookingSessionEvent(request.resource.data, eventId) &&
        bookingSessionEventReferencesBookingAfter(eventId);
      allow update, delete: if false;
    }

    function financeVoidScheduleSlotDeleteAllowed(bookingId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        existsAfter(bookingPath) &&
        bookingAfter.lastFinanceAction == 'void' &&
        bookingAfter.lastFinanceLedgerEntryId == '' &&
        bookingAfter.lastFinanceProofId == '' &&
        bookingAfter.paymentStatus == 'void' &&
        !bookingRequiresPublicSlot(bookingAfter) &&
        financeBookingVoidScheduleMatchesAfter(bookingId, bookingAfter);
    }

    match /clientCalendarSlots/{slotId} {
      // Public availability exposes generic occupied-slot metadata only.
      allow read: if true;
      allow create, update: if isApprovedScheduleAdmin() &&
        existsAfter(/databases/$(database)/documents/bookings/$(slotId)) &&
        bookingCalendarSlotMatchesAfter(slotId, getAfter(/databases/$(database)/documents/bookings/$(slotId)).data);
      allow delete: if (
          isApprovedScheduleAdmin() &&
          existsAfter(/databases/$(database)/documents/bookings/$(slotId)) &&
          !bookingRequiresPublicSlot(getAfter(/databases/$(database)/documents/bookings/$(slotId)).data) &&
          bookingScheduleDayMatchesAfter(
            getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.date,
            slotId,
            getAfter(/databases/$(database)/documents/bookings/$(slotId)).data.updatedAt
          )
        ) || financeVoidScheduleSlotDeleteAllowed(slotId);
    }

    function bookingDocumentChangesAfter(bookingId, updatedAt) {
      let bookingPath = /databases/$(database)/documents/bookings/$(bookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return existsAfter(bookingPath) &&
        bookingAfter.updatedAt == updatedAt &&
        (
          !exists(bookingPath) ||
          get(bookingPath).data.updatedAt != updatedAt
        );
    }

    function financeVoidScheduleDayCompanionAllowed(dateId, dayData) {
      let bookingPath = /databases/$(database)/documents/bookings/$(dayData.lastBookingId);
      let bookingAfter = getAfter(bookingPath).data;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(bookingAfter.lastFinanceBusinessDate + '__main');
      let closingAfter = getAfter(closingPath).data;
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        existsAfter(bookingPath) &&
        bookingAfter.lastFinanceAction == 'void' &&
        bookingAfter.date == dateId &&
        bookingAfter.updatedAt == dayData.updatedAt &&
        bookingDocumentChangesAfter(dayData.lastBookingId, dayData.updatedAt) &&
        financeBookingVoidScheduleMatchesAfter(dayData.lastBookingId, bookingAfter) &&
        closingAfter.lastOperationAction == 'void' &&
        closingAfter.lastOperationId == bookingAfter.lastFinanceOperationId &&
        closingAfter.lastBookingId == dayData.lastBookingId &&
        repositoryOperationMatchesAfter(
          bookingAfter.lastFinanceOperationId,
          'finance',
          'void',
          'bookings',
          dayData.lastBookingId
        );
    }

    match /bookingScheduleDays/{dateId} {
      allow read: if isApprovedAdmin() && (canManageBookingData() || hasPermission('billing'));
      allow create: if (
          isApprovedScheduleAdmin() &&
          validBookingScheduleDay(request.resource.data, dateId) &&
          request.resource.data.revision == 1 &&
          bookingDocumentChangesAfter(request.resource.data.lastBookingId, request.resource.data.updatedAt)
        ) || (
          validBookingScheduleDay(request.resource.data, dateId) &&
          request.resource.data.revision == 1 &&
          financeVoidScheduleDayCompanionAllowed(dateId, request.resource.data)
        );
      allow update: if (
          isApprovedScheduleAdmin() &&
          validBookingScheduleDay(request.resource.data, dateId) &&
          resource.data.date == dateId &&
          request.resource.data.revision == resource.data.revision + 1 &&
          bookingDocumentChangesAfter(request.resource.data.lastBookingId, request.resource.data.updatedAt)
        ) || (
          validBookingScheduleDay(request.resource.data, dateId) &&
          resource.data.date == dateId &&
          request.resource.data.revision == resource.data.revision + 1 &&
          financeVoidScheduleDayCompanionAllowed(dateId, request.resource.data)
        );
      allow delete: if false;
    }

    function validCustomer(data, customerId) {
      return data.keys().hasOnly([
          'id', 'authUid', 'name', 'phone', 'phoneKey', 'email', 'instagram',
          'notes', 'followUpStatus', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.id == customerId &&
        validString(data.name, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.phoneKey, 0, 32) &&
        validString(data.email, 0, 254) &&
        validString(data.instagram, 0, 80) &&
        validString(data.notes, 0, 2000) &&
        data.followUpStatus in ['normal', 'follow-up', 'vip', 'watchlist'] &&
        validOptionalString(data, 'source', 40) &&
        validOptionalString(data, 'authUid', 128) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function isOwnClientProfile(customerId, data) {
      return isClientAccount() &&
        customerId == ('auth_' + request.auth.uid) &&
        data.authUid == request.auth.uid &&
        data.source == 'clientPortal';
    }

    function clientProfileIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phone is string &&
          data.phone == request.auth.token.phone_number
        );
    }

    match /customers/{customerId} {
      allow read: if (isApproved() && canAccessCustomerData()) ||
        (isClientAccount() && customerId == ('auth_' + request.auth.uid));
      allow create: if (
        isApproved() &&
        canManageCustomerData() &&
        validCustomer(request.resource.data, customerId)
      ) || (
        isOwnClientProfile(customerId, request.resource.data) &&
        clientProfileIdentityMatches(request.resource.data) &&
        request.resource.data.followUpStatus == 'normal' &&
        validCustomer(request.resource.data, customerId)
      );
      allow update: if (
        isApproved() &&
        canManageCustomerData() &&
        validCustomer(request.resource.data, customerId)
      ) || (
        isOwnClientProfile(customerId, request.resource.data) &&
        clientProfileIdentityMatches(request.resource.data) &&
        resource.data.authUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['name', 'phone', 'phoneKey', 'email', 'updatedAt']) &&
        validCustomer(request.resource.data, customerId)
      );
      allow delete: if isApproved() && canManageCustomerData();
    }

    function validStudioSettings(data) {
      return data.keys().hasOnly([
          'studioName', 'studioAddress', 'studioPhone',
          'bankName', 'bankAccountNumber', 'bankAccountHolder',
          'qrisLabel', 'qrisNote', 'paymentTerms', 'updatedAt'
        ]) &&
        validString(data.studioName, 1, 120) &&
        validString(data.studioAddress, 0, 500) &&
        validString(data.studioPhone, 0, 32) &&
        validString(data.bankName, 1, 80) &&
        validString(data.bankAccountNumber, 1, 80) &&
        validString(data.bankAccountHolder, 1, 120) &&
        validString(data.qrisLabel, 0, 160) &&
        validString(data.qrisNote, 0, 240) &&
        data.paymentTerms is list &&
        data.paymentTerms.size() <= 12 &&
        validOptionalString(data, 'updatedAt', 40);
    }

    function validPricingSettings(data) {
      return data.keys().hasOnly(['sessions', 'discounts', 'recordingTypes', 'packages']) &&
        data.sessions is list && data.sessions.size() > 0 && data.sessions.size() <= 50 &&
        data.discounts is list && data.discounts.size() <= 100 &&
        data.recordingTypes is list && data.recordingTypes.size() <= 50 &&
        data.packages is list && data.packages.size() <= 100;
    }

    function validInvoiceSettings(data) {
      return data.keys().hasOnly(['studioName', 'subtitle', 'phone', 'address', 'footer', 'paperSize', 'updatedAt']) &&
        validString(data.studioName, 1, 120) &&
        validString(data.subtitle, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.address, 0, 500) &&
        validString(data.footer, 1, 500) &&
        data.paperSize in ['80mm', '58mm'] &&
        validOptionalString(data, 'updatedAt', 40);
    }

    match /settings/studio {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validStudioSettings(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/pricing {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validPricingSettings(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/invoice {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validInvoiceSettings(request.resource.data);
      allow delete: if isOwner();
    }

    // >>> STUDIO37 OPERATOR FEE RULES START
    match /settings/operatorFees {
      allow read: if isOwner();
      allow create, update, delete: if isOwner();
    }

    function validOperatorFeeEntry(
      data,
      entryId
    ) {
      return data.keys().hasOnly([
          'id',
          'amount',
          'bookingCode',
          'bookingDate',
          'bookingId',
          'calculationMode',
          'durationHours',
          'mealAmount',
          'note',
          'overtimeAmount',
          'payeeRole',
          'paymentMethod',
          'personId',
          'personName',
          'postedAt',
          'postedBookkeepingEntryId',
          'postedByUid',
          'ruleId',
          'ruleName',
          'serviceLabel',
          'sourcePricingId',
          'sourcePricingLabel',
          'sourcePricingType',
          'status',
          'title',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == entryId &&
        validNumber(data.amount, 0, 1000000000) &&
        validString(data.bookingCode, 0, 160) &&
        validString(data.bookingDate, 0, 40) &&
        validString(data.bookingId, 0, 160) &&
        validString(data.calculationMode, 1, 80) &&
        validNumber(data.durationHours, 0, 1000) &&
        validNumber(data.mealAmount, 0, 1000000000) &&
        validString(data.note, 0, 2000) &&
        validNumber(data.overtimeAmount, 0, 1000000000) &&
        data.payeeRole in ['guard', 'recording_operator'] &&
        validString(data.paymentMethod, 1, 80) &&
        validString(data.personId, 0, 160) &&
        validString(data.personName, 1, 160) &&
        validString(data.postedAt, 0, 40) &&
        validString(data.postedBookkeepingEntryId, 0, 240) &&
        validString(data.postedByUid, 0, 128) &&
        validString(data.ruleId, 0, 240) &&
        validString(data.ruleName, 1, 240) &&
        validString(data.serviceLabel, 0, 240) &&
        validString(data.sourcePricingId, 0, 240) &&
        validString(data.sourcePricingLabel, 0, 240) &&
        validString(data.sourcePricingType, 0, 80) &&
        data.status in ['draft', 'reviewed', 'posted', 'void'] &&
        validString(data.title, 1, 240) &&
        validNumber(data.totalAmount, 0, 1000000000) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function operatorFeePostedFieldsAreClear(
      data
    ) {
      return data.postedAt == '' &&
        data.postedBookkeepingEntryId == '' &&
        data.postedByUid == '';
    }

    function operatorFeeCreatesNonPosted(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        request.resource.data.status in [
          'draft',
          'reviewed'
        ] &&
        operatorFeePostedFieldsAreClear(
          request.resource.data
        );
    }

    function operatorFeeUpdatesNonPosted(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        resource.data.status != 'posted' &&
        request.resource.data.status in [
          'draft',
          'reviewed',
          'void'
        ] &&
        operatorFeePostedFieldsAreClear(
          request.resource.data
        );
    }

    function operatorFeeBookkeepingExistsAfter(
      entryId
    ) {
      let bookkeepingId =
        request.resource.data.postedBookkeepingEntryId;

      let bookkeepingPath =
        /databases/$(database)/documents/bookkeepingEntries/$(bookkeepingId);

      return bookkeepingId is string &&
        bookkeepingId.size() > 0 &&
        existsAfter(bookkeepingPath) &&
        getAfter(bookkeepingPath).data.id ==
          bookkeepingId &&
        getAfter(bookkeepingPath).data.type ==
          'expense' &&
        getAfter(bookkeepingPath).data.source ==
          'operatorFee' &&
        getAfter(bookkeepingPath).data.sourceFeeEntryId ==
          entryId &&
        getAfter(bookkeepingPath).data.sourceBookingId ==
          resource.data.bookingId &&
        getAfter(bookkeepingPath).data.amount ==
          resource.data.totalAmount;
    }

    function adminPostsOperatorFee(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        resource.data.status == 'reviewed' &&
        request.resource.data.status == 'posted' &&
        request.resource.data.postedAt != '' &&
        request.resource.data.postedBookkeepingEntryId != '' &&
        request.resource.data.postedByUid ==
          request.auth.uid &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'postedAt',
            'postedBookkeepingEntryId',
            'postedByUid',
            'status',
            'updatedAt'
          ]) &&
        operatorFeeBookkeepingExistsAfter(
          entryId
        );
    }

    match /operatorFeeEntries/{entryId} {
      allow read: if canManageOperatorFees();

      allow create:
        if operatorFeeCreatesNonPosted(
          entryId
        );

      allow update:
        if operatorFeeUpdatesNonPosted(
          entryId
        ) ||
        adminPostsOperatorFee(
          entryId
        );

      allow delete:
        if canManageOperatorFees() &&
        resource.data.status != 'posted';
    }
    // <<< STUDIO37 OPERATOR FEE RULES END

    function validOperatorFeeBookkeepingSource(data) {
      return data.source != 'operatorFee' || (
        data.keys().hasAll([
          'sourceBookingId',
          'sourceFeeEntryId'
        ]) &&
        validString(
          data.sourceBookingId,
          1,
          160
        ) &&
        validString(
          data.sourceFeeEntryId,
          1,
          240
        )
      );
    }

    function validGuardMealBookkeepingSource(data) {
      return data.source != 'guardAttendanceMeal' || (
        data.keys().hasAll([
          'sourceAttendanceId',
          'sourceAttendanceDate',
          'sourceGuardPersonId'
        ]) &&
        validString(data.sourceAttendanceId, 1, 160) &&
        validIsoDate(data.sourceAttendanceDate) &&
        validString(data.sourceGuardPersonId, 1, 160)
      );
    }

    function validManualBookkeepingEntry(data, entryId) {
      return data.keys().hasOnly([
          'id', 'type', 'category', 'title', 'amount', 'date',
          'paymentMethod', 'note', 'source',
          'sourceAttendanceId', 'sourceAttendanceDate',
          'sourceGuardPersonId', 'sourceBookingId',
          'sourceFeeEntryId', 'sourceEventId', 'sourceAction', 'sourceWorkOrderId',
          'actorName', 'actorUid', 'idempotencyKey', 'immutable',
          'operationId', 'sourceProofId', 'reversalOf', 'createdAt', 'updatedAt'
        ]) &&
        data.id == entryId &&
        data.source == 'manual' &&
        data.type in ['income', 'expense'] &&
        validString(data.category, 1, 80) &&
        validString(data.title, 1, 160) &&
        validNumber(data.amount, 1, 1000000000) &&
        validIsoDate(data.date) &&
        data.paymentMethod in ['cash', 'transfer', 'qris', 'other'] &&
        validString(data.note, 0, 2000) &&
        validString(data.actorUid, 1, 128) &&
        validString(data.actorName, 1, 120) &&
        validString(data.idempotencyKey, 8, 240) &&
        validString(data.operationId, 8, 80) &&
        data.immutable == false &&
        data.sourceProofId == '' &&
        data.reversalOf == '' &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function validBookkeepingEntry(data, entryId) {
      return data.keys().hasOnly([
          'id', 'type', 'category', 'title', 'amount', 'date',
          'paymentMethod', 'note', 'source',
          'sourceAttendanceId', 'sourceAttendanceDate',
          'sourceGuardPersonId', 'sourceBookingId',
          'sourceFeeEntryId', 'sourceEventId', 'sourceAction', 'sourceWorkOrderId',
          'actorName', 'actorUid', 'idempotencyKey', 'immutable',
          'operationId', 'sourceProofId', 'reversalOf', 'createdAt', 'updatedAt'
        ]) &&
        data.id == entryId &&
        data.type in ['income', 'expense'] &&
        validString(data.category, 1, 80) &&
        validString(data.title, 1, 160) &&
        validNumber(data.amount, 0, 1000000000) &&
        validIsoDate(data.date) &&
        validString(data.paymentMethod, 1, 80) &&
        validString(data.note, 0, 2000) &&
        validOptionalString(data, 'source', 80) &&
        validOptionalString(data, 'sourceAttendanceId', 160) &&
        validOptionalString(data, 'sourceAttendanceDate', 40) &&
        validOptionalString(data, 'sourceGuardPersonId', 160) &&
        validOptionalString(data, 'sourceBookingId', 160) &&
        validOptionalString(data, 'sourceFeeEntryId', 240) &&
        validOptionalString(data, 'sourceWorkOrderId', 160) &&
        validOptionalString(data, 'sourceEventId', 240) &&
        validOptionalString(data, 'sourceAction', 80) &&
        validOptionalString(data, 'actorName', 120) &&
        validOptionalString(data, 'actorUid', 128) &&
        validOptionalString(data, 'idempotencyKey', 240) &&
        validOptionalString(data, 'operationId', 80) &&
        validOptionalString(data, 'sourceProofId', 160) &&
        (!data.keys().hasAny(['immutable']) || data.immutable is bool) &&
        validOptionalString(data, 'reversalOf', 240) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOperatorFeeBookkeepingSource(data) &&
        validGuardMealBookkeepingSource(data);
    }

    function isReconciledBookkeepingSource(
      data
    ) {
      return data.source in [
        'operatorFee',
        'guardAttendanceMeal',
        'booking-payment',
        'booking-refund',
        'procurement-payment'
      ];
    }

    function operatorFeeBookkeepingBecomesPostedAfter(
      data
    ) {
      let feeEntryId =
        data.sourceFeeEntryId;

      let feePath =
        /databases/$(database)/documents/operatorFeeEntries/$(feeEntryId);

      return data.source != 'operatorFee' || (
        feeEntryId is string &&
        feeEntryId.size() > 0 &&
        existsAfter(feePath) &&
        getAfter(feePath).data.status ==
          'posted' &&
        getAfter(feePath).data.postedBookkeepingEntryId ==
          data.id &&
        getAfter(feePath).data.bookingId ==
          data.sourceBookingId &&
        getAfter(feePath).data.totalAmount ==
          data.amount &&
        (
          !exists(feePath) ||
          get(feePath).data.status !=
            'posted'
        )
      );
    }

    function guardMealBookkeepingBecomesPostedAfter(
      data
    ) {
      let attendanceId =
        data.sourceAttendanceId;

      let attendancePath =
        /databases/$(database)/documents/guardAttendanceSessions/$(attendanceId);

      return data.source != 'guardAttendanceMeal' || (
        attendanceId is string &&
        attendanceId.size() > 0 &&
        existsAfter(attendancePath) &&
        getAfter(attendancePath).data.mealBookkeepingStatus ==
          'posted' &&
        getAfter(attendancePath).data.mealBookkeepingEntryId ==
          data.id &&
        getAfter(attendancePath).data.date ==
          data.sourceAttendanceDate &&
        getAfter(attendancePath).data.guardPersonId ==
          data.sourceGuardPersonId &&
        getAfter(attendancePath).data.mealAmount ==
          data.amount &&
        (
          !exists(attendancePath) ||
          !(
            'mealBookkeepingStatus' in
            get(attendancePath).data
          ) ||
          get(attendancePath).data.mealBookkeepingStatus !=
            'posted'
        )
      );
    }

    function reconciledBookkeepingWriteAllowed(
      data
    ) {
      return operatorFeeBookkeepingBecomesPostedAfter(
          data
        ) &&
        guardMealBookkeepingBecomesPostedAfter(
          data
        );
    }

    function bookkeepingBusinessDateOpen(data) {
      let closingId = data.date + '__main';
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      return !exists(closingPath) || get(closingPath).data.status != 'closed';
    }


    function financeBookingPaymentLedgerPairMatchesAfter(data, entryId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(data.sourceBookingId);
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      let history = bookingAfter.paymentHistory;
      let event = history[history.size() - 1];
      let beforeCount = ('paymentHistory' in bookingBefore) ? bookingBefore.paymentHistory.size() : 0;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(data.date + '__main');
      let closingAfter = getAfter(closingPath).data;
      return exists(bookingPath) &&
        existsAfter(bookingPath) &&
        history.size() == beforeCount + 1 &&
        bookingAfter.lastFinanceAction in ['payment', 'proof-approve'] &&
        bookingAfter.lastFinanceBusinessDate == data.date &&
        bookingAfter.lastFinanceOperationId == data.operationId &&
        bookingAfter.lastFinanceLedgerEntryId == entryId &&
        bookingAfter.lastFinanceEventId == event.id &&
        bookingAfter.lastFinanceProofId == data.sourceProofId &&
        event.ledgerEntryId == entryId &&
        event.operationId == data.operationId &&
        event.id == data.sourceEventId &&
        event.amount == data.amount &&
        event.method == data.paymentMethod &&
        event.date == data.date &&
        event.actorUid == request.auth.uid &&
        (data.sourceProofId == '' ? !event.keys().hasAny(['proofId']) : event.proofId == data.sourceProofId) &&
        data.id == entryId &&
        data.source == 'booking-payment' &&
        data.sourceAction == 'payment' &&
        data.type == 'income' &&
        data.category == 'booking' &&
        data.immutable == true &&
        data.actorUid == request.auth.uid &&
        data.operationId is string &&
        data.idempotencyKey == event.idempotencyKey &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == bookingAfter.lastFinanceAction &&
        closingAfter.lastOperationId == data.operationId &&
        closingAfter.lastBookingId == data.sourceBookingId &&
        closingAfter.lastLedgerEntryId == entryId &&
        closingAfter.lastProofId == data.sourceProofId;
    }

    function financeBookingRefundLedgerPairMatchesAfter(data, entryId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(data.sourceBookingId);
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      let history = bookingAfter.refundHistory;
      let event = history[history.size() - 1];
      let beforeCount = ('refundHistory' in bookingBefore) ? bookingBefore.refundHistory.size() : 0;
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(data.date + '__main');
      let closingAfter = getAfter(closingPath).data;
      return exists(bookingPath) &&
        existsAfter(bookingPath) &&
        history.size() == beforeCount + 1 &&
        bookingAfter.lastFinanceAction == 'refund' &&
        bookingAfter.lastFinanceBusinessDate == data.date &&
        bookingAfter.lastFinanceOperationId == data.operationId &&
        bookingAfter.lastFinanceLedgerEntryId == entryId &&
        bookingAfter.lastFinanceEventId == event.id &&
        bookingAfter.lastFinanceProofId == '' &&
        event.ledgerEntryId == entryId &&
        event.operationId == data.operationId &&
        event.id == data.sourceEventId &&
        event.amount == data.amount &&
        event.method == data.paymentMethod &&
        event.date == data.date &&
        event.actorUid == request.auth.uid &&
        data.id == entryId &&
        data.source == 'booking-refund' &&
        data.sourceAction == 'refund' &&
        data.type == 'expense' &&
        data.category == 'refund' &&
        data.sourceProofId == '' &&
        data.immutable == true &&
        data.actorUid == request.auth.uid &&
        data.idempotencyKey == event.idempotencyKey &&
        existsAfter(closingPath) &&
        closingAfter.lastOperationAction == 'refund' &&
        closingAfter.lastOperationId == data.operationId &&
        closingAfter.lastBookingId == data.sourceBookingId &&
        closingAfter.lastLedgerEntryId == entryId &&
        closingAfter.lastProofId == '';
    }

    function financeBookingLedgerCreateAllowed(data, entryId) {
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        validBookkeepingEntry(data, entryId) &&
        bookkeepingBusinessDateOpen(data) &&
        (
          data.source == 'booking-payment' && data.sourceAction == 'payment'
            ? data.type == 'income' && data.category == 'booking' &&
              financeBookingPaymentLedgerPairMatchesAfter(data, entryId)
            : data.source == 'booking-refund' && data.sourceAction == 'refund'
              ? data.type == 'expense' && data.category == 'refund' &&
                financeBookingRefundLedgerPairMatchesAfter(data, entryId)
              : false
        );
    }

    function manualBookkeepingFenceMatchesAfter(entryId, operationId, action, businessDate) {
      let closingId = businessDate + '__main';
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let closingAfter = getAfter(closingPath).data;
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(entryId);
      let entryAfter = existsAfter(entryPath) ? getAfter(entryPath).data : {};
      let entryBefore = exists(entryPath) ? get(entryPath).data : {};
      return existsAfter(closingPath) &&
        closingAfter.lastOperationId == operationId &&
        closingAfter.lastOperationAction == action &&
        closingAfter.lastLedgerEntryId == entryId &&
        closingAfter.businessDate == businessDate &&
        (
          action == 'manual-delete'
            ? (!existsAfter(entryPath) && exists(entryPath) && entryBefore.source in ['', 'manual'] && entryBefore.date == businessDate)
            : (existsAfter(entryPath) && entryAfter.source == 'manual' &&
                entryAfter.operationId == operationId &&
                (entryAfter.date == businessDate || (exists(entryPath) && entryBefore.date == businessDate)))
        );
    }

    function manualBookkeepingCreateOrUpdateAllowed(data, entryId, action) {
      return data.operationId is string &&
        manualBookkeepingFenceMatchesAfter(entryId, data.operationId, action, data.date) &&
        repositoryOperationMatchesAfter(
          data.operationId,
          'bookkeeping',
          action,
          'bookkeepingEntries',
          entryId
        );
    }

    function manualBookkeepingUpdateAllowed(data, entryId) {
      return manualBookkeepingCreateOrUpdateAllowed(
          data,
          entryId,
          'manual-update'
        ) &&
        (
          resource.data.date == data.date ||
          manualBookkeepingFenceMatchesAfter(
            entryId,
            data.operationId,
            'manual-update',
            resource.data.date
          )
        );
    }

    function manualBookkeepingDeleteAllowed(entryId) {
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(resource.data.date + '__main');
      let closingAfter = existsAfter(closingPath) ? getAfter(closingPath).data : {};
      let operationId = closingAfter.lastOperationId;
      return isApprovedAdmin() &&
        canManageBookkeepingData() &&
        resource.data.source in ['', 'manual'] &&
        !isReconciledBookkeepingSource(resource.data) &&
        existsAfter(closingPath) &&
        manualBookkeepingFenceMatchesAfter(entryId, operationId, 'manual-delete', resource.data.date) &&
        repositoryOperationMatchesAfter(
          operationId,
          'bookkeeping',
          'manual-delete',
          '',
          ''
        );
    }

    function bookingInitialPaymentLedgerPairMatchesAfter(data, entryId) {
      let bookingPath = /databases/$(database)/documents/bookings/$(data.sourceBookingId);
      let bookingBefore = get(bookingPath).data;
      let bookingAfter = getAfter(bookingPath).data;
      let payment = bookingAfter.paymentHistory[0];
      return exists(bookingPath) &&
        existsAfter(bookingPath) &&
        bookingBefore.source == 'admin' &&
        bookingBefore.initialPaymentLedgerStatus == 'pending' &&
        bookingAfter.initialPaymentLedgerStatus == 'recorded' &&
        bookingAfter.paymentHistory.size() == 1 &&
        bookingBefore.initialPaymentIntent == payment &&
        data.id == entryId &&
        data.id == 'booking-payment-' + data.sourceBookingId + '-' + data.sourceEventId &&
        data.sourceBookingId == bookingAfter.id &&
        data.sourceEventId == payment.id &&
        data.actorUid == payment.actorUid &&
        data.actorName == payment.actorName;
    }

    function bookingInitialPaymentLedgerCreateAllowed(data, entryId) {
      // Cheap, document-local discriminator first. Generic manual/Worker-owned
      // bookkeeping writes must not trigger a cross-document booking lookup.
      return data.source == 'booking-payment' &&
        data.sourceAction == 'payment' &&
        data.category == 'booking' &&
        data.type == 'income' &&
        data.immutable == true &&
        validString(data.sourceBookingId, 1, 160) &&
        validString(data.sourceEventId, 1, 80) &&
        data.keys().hasOnly([
          'id', 'actorName', 'actorUid', 'amount', 'category', 'createdAt',
          'date', 'idempotencyKey', 'immutable', 'note', 'paymentMethod',
          'reversalOf', 'source', 'sourceAction', 'sourceBookingId',
          'sourceEventId', 'title', 'type', 'updatedAt'
        ]) &&
        data.id == entryId &&
        data.paymentMethod in ['cash', 'transfer', 'qris', 'other'] &&
        data.reversalOf == '' &&
        data.updatedAt == data.createdAt &&
        bookingInitialPaymentLedgerPairMatchesAfter(data, entryId);
    }

    function bookkeepingEntryCreateAllowed(data, entryId) {
      let source = data.get('source', '');
      return source == 'booking-payment'
        ? (
            (
              bookingInitialPaymentLedgerCreateAllowed(data, entryId) &&
              bookkeepingBusinessDateOpen(data)
            ) || financeBookingLedgerCreateAllowed(data, entryId)
          )
        : source == 'booking-refund'
          ? financeBookingLedgerCreateAllowed(data, entryId)
          : source == 'manual'
            ? (
                isApprovedAdmin() &&
                hasPermission('bookkeeping') &&
                validManualBookkeepingEntry(data, entryId) &&
                data.actorUid == request.auth.uid &&
                bookkeepingBusinessDateOpen(data) &&
                manualBookkeepingCreateOrUpdateAllowed(data, entryId, 'manual-create')
              )
            : source in ['operatorFee', 'guardAttendanceMeal']
              ? (
                  isApprovedAdmin() &&
                  hasPermission('operator-fee') &&
                  validBookkeepingEntry(data, entryId) &&
                  bookkeepingBusinessDateOpen(data) &&
                  reconciledBookkeepingWriteAllowed(data)
                )
              : false;
    }

    match /bookkeepingEntries/{entryId} {
      allow read: if isApproved() && canAccessBookkeepingData();
      allow create: if bookkeepingEntryCreateAllowed(request.resource.data, entryId);
      allow update: if isApprovedAdmin() &&
        hasPermission('bookkeeping') &&
        validManualBookkeepingEntry(request.resource.data, entryId) &&
        resource.data.source in ['', 'manual'] &&
        manualBookkeepingUpdateAllowed(request.resource.data, entryId);
      allow delete: if manualBookkeepingDeleteAllowed(entryId);
    }

    function validCashClosingSession(data, closingId) {
      return data is map &&
        data.keys().hasOnly([
          'id', 'businessDate', 'registerId', 'status', 'activityRevision',
          'createdAt', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
          'lastOperationId', 'lastOperationAction', 'lastBookingId',
          'lastLedgerEntryId', 'lastProofId', 'revision', 'cashVariance',
          'closedAt', 'closedByName', 'closedByUid', 'cashDenominations',
          'countedCash', 'cutoffAt', 'digitalCounts', 'digitalReconciliation',
          'expectedCash', 'lastEventAt', 'lastEventId', 'lastEventType',
          'openingCash', 'reviewNote', 'sourceFingerprint', 'sourceWatermark',
          'totalsByMethod', 'transactionCount', 'transactionReferences',
          'varianceReason', 'lastFinanceOperationId', 'reopenReason',
          'reopenedAt', 'reopenedByName', 'reopenedByUid'
        ]) &&
        data.keys().hasAll([
          'id', 'businessDate', 'registerId', 'status', 'activityRevision',
          'createdAt', 'updatedAt'
        ]) &&
        data.id == closingId &&
        closingId == data.businessDate + '__main' &&
        validIsoDate(data.businessDate) &&
        data.registerId == 'main' &&
        data.status in ['open', 'reopened', 'closed'] &&
        data.activityRevision is int &&
        data.activityRevision >= 0 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'lastActivityAt', 40) &&
        validOptionalString(data, 'lastActivityByUid', 128) &&
        validOptionalString(data, 'lastOperationId', 80) &&
        validOptionalString(data, 'lastOperationAction', 40) &&
        validOptionalString(data, 'lastBookingId', 160) &&
        validOptionalString(data, 'lastLedgerEntryId', 160) &&
        validOptionalString(data, 'lastProofId', 160) &&
        validOptionalString(data, 'lastFinanceOperationId', 80) &&
        (!data.keys().hasAny(['revision']) || (data.revision is int && data.revision >= 0)) &&
        (!data.keys().hasAny(['transactionCount']) || (data.transactionCount is int && data.transactionCount >= 0 && data.transactionCount <= 1000)) &&
        (!data.keys().hasAny(['transactionReferences']) || (data.transactionReferences is list && data.transactionReferences.size() <= 1000)) &&
        (!data.keys().hasAny(['totalsByMethod']) || data.totalsByMethod is map) &&
        (!data.keys().hasAny(['digitalCounts']) || data.digitalCounts is map) &&
        (!data.keys().hasAny(['digitalReconciliation']) || data.digitalReconciliation is map) &&
        (!data.keys().hasAny(['cashDenominations']) || data.cashDenominations is map) &&
        validOptionalString(data, 'closedAt', 40) &&
        validOptionalString(data, 'closedByName', 120) &&
        validOptionalString(data, 'closedByUid', 128) &&
        validOptionalString(data, 'cutoffAt', 40) &&
        validOptionalString(data, 'lastEventAt', 40) &&
        validOptionalString(data, 'lastEventId', 160) &&
        validOptionalString(data, 'lastEventType', 40) &&
        validOptionalString(data, 'sourceFingerprint', 64) &&
        validOptionalString(data, 'sourceWatermark', 50) &&
        validOptionalString(data, 'reviewNote', 1000) &&
        validOptionalString(data, 'varianceReason', 600) &&
        validOptionalString(data, 'reopenReason', 600) &&
        validOptionalString(data, 'reopenedAt', 40) &&
        validOptionalString(data, 'reopenedByName', 120) &&
        validOptionalString(data, 'reopenedByUid', 128);
    }

    function activityRevisionIncrements(closingId, data) {
      let closingPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      return exists(closingPath)
        ? data.activityRevision == get(closingPath).data.get('activityRevision', 0) + 1
        : data.activityRevision == 1;
    }

    function financeActivityLedgerCompanionMatchesAfter(data, bookingAfter) {
      let ledgerPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let ledgerAfter = getAfter(ledgerPath).data;
      return data.lastLedgerEntryId is string &&
        data.lastLedgerEntryId.size() > 0 &&
        existsAfter(ledgerPath) &&
        ledgerAfter.operationId == data.lastOperationId &&
        ledgerAfter.sourceBookingId == data.lastBookingId &&
        ledgerAfter.sourceEventId == bookingAfter.lastFinanceEventId &&
        ledgerAfter.sourceProofId == data.lastProofId &&
        ledgerAfter.amount is number &&
        ledgerAfter.actorUid == request.auth.uid &&
        ledgerAfter.date == data.businessDate;
    }

    function financeActivityVoidCompanionMatchesAfter(data, bookingAfter) {
      return data.lastLedgerEntryId == '' &&
        data.lastProofId == '' &&
        bookingAfter.lastFinanceAction == 'void' &&
        bookingAfter.lastFinanceLedgerEntryId == '' &&
        bookingAfter.lastFinanceProofId == '';
    }

    function financeActivityBookingCompanionMatchesAfter(data, action) {
      let bookingPath = /databases/$(database)/documents/bookings/$(data.lastBookingId);
      let bookingAfter = getAfter(bookingPath).data;
      return existsAfter(bookingPath) &&
        bookingAfter.lastFinanceAction == action &&
        bookingAfter.lastFinanceBusinessDate == data.businessDate &&
        bookingAfter.lastFinanceOperationId == data.lastOperationId &&
        bookingAfter.lastFinanceLedgerEntryId == data.lastLedgerEntryId &&
        bookingAfter.lastFinanceProofId == data.lastProofId &&
        (
          action == 'void'
            ? financeActivityVoidCompanionMatchesAfter(data, bookingAfter)
            : financeActivityLedgerCompanionMatchesAfter(data, bookingAfter)
        ) &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'finance',
          action,
          'bookings',
          data.lastBookingId
        );
    }

    function financeActivityFenceUpdateAllowed(closingId) {
      let data = request.resource.data;
      let action = data.lastOperationAction;
      return isApprovedAdmin() &&
        hasPermission('billing') &&
        validCashClosingSession(data, closingId) &&
        data.status in ['open', 'reopened'] &&
        action in ['payment', 'proof-approve', 'refund', 'void'] &&
        data.lastActivityByUid == request.auth.uid &&
        validIsoTimestampString(data.lastActivityAt) &&
        data.lastOperationId is string &&
        data.lastBookingId is string &&
        data.lastBookingId.size() > 0 &&
        activityRevisionIncrements(closingId, data) &&
        (!exists(/databases/$(database)/documents/cashClosingSessions/$(closingId)) ||
          get(/databases/$(database)/documents/cashClosingSessions/$(closingId)).data.status != 'closed') &&
        financeActivityBookingCompanionMatchesAfter(data, action);
    }

    function manualBookkeepingFenceCompanionMatchesAfter(data, action) {
      let entryPath = /databases/$(database)/documents/bookkeepingEntries/$(data.lastLedgerEntryId);
      let entryAfter = existsAfter(entryPath) ? getAfter(entryPath).data : {};
      let entryBefore = exists(entryPath) ? get(entryPath).data : {};
      return action == 'manual-delete'
        ? (!existsAfter(entryPath) && exists(entryPath) &&
            entryBefore.source in ['', 'manual'] && entryBefore.date == data.businessDate)
        : (existsAfter(entryPath) && entryAfter.source == 'manual' &&
            entryAfter.operationId == data.lastOperationId &&
            (entryAfter.date == data.businessDate ||
              (exists(entryPath) && entryBefore.date == data.businessDate)));
    }

    function validManualBookkeepingActivityFence(data, closingId) {
      let fencePath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let allowedChanges = [
        'activityRevision', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
        'lastOperationId', 'lastOperationAction', 'lastBookingId',
        'lastLedgerEntryId', 'lastProofId'
      ];
      return data is map &&
        (
          exists(fencePath)
            ? data.diff(get(fencePath).data).affectedKeys().hasOnly(allowedChanges)
            : data.keys().hasOnly([
                'id', 'businessDate', 'registerId', 'status', 'activityRevision',
                'createdAt', 'updatedAt', 'lastActivityAt', 'lastActivityByUid',
                'lastOperationId', 'lastOperationAction', 'lastBookingId',
                'lastLedgerEntryId', 'lastProofId'
              ])
        ) &&
        data.id == closingId &&
        closingId == data.businessDate + '__main' &&
        validIsoDate(data.businessDate) &&
        data.registerId == 'main' &&
        data.status in ['open', 'reopened'] &&
        data.activityRevision is int &&
        data.activityRevision >= 1 &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validIsoTimestampString(data.lastActivityAt) &&
        data.lastActivityByUid == request.auth.uid &&
        data.lastOperationId is string &&
        data.lastOperationId.size() > 0 &&
        data.lastOperationAction in ['manual-create', 'manual-update', 'manual-delete'] &&
        data.lastLedgerEntryId is string &&
        data.lastLedgerEntryId.size() > 0 &&
        data.lastBookingId == '' &&
        data.lastProofId == '';
    }

    function manualBookkeepingFenceUpdateAllowed(closingId) {
      let data = request.resource.data;
      return isApprovedAdmin() &&
        hasPermission('bookkeeping') &&
        validManualBookkeepingActivityFence(data, closingId) &&
        activityRevisionIncrements(closingId, data) &&
        (!exists(/databases/$(database)/documents/cashClosingSessions/$(closingId)) ||
          get(/databases/$(database)/documents/cashClosingSessions/$(closingId)).data.status != 'closed') &&
        manualBookkeepingFenceCompanionMatchesAfter(data, data.lastOperationAction);
    }

    function validCashClosingEvent(data, eventId) {
      return data is map &&
        data.keys().hasOnly([
          'action', 'actorName', 'actorUid', 'businessDate', 'closingId',
          'createdAt', 'id', 'reason', 'registerId', 'revision',
          'sourceFingerprint', 'snapshot', 'summary', 'type', 'operationId'
        ]) &&
        data.id == eventId &&
        data.action in ['closed', 'reopened'] &&
        validString(data.actorName, 1, 120) &&
        data.actorUid == request.auth.uid &&
        validIsoDate(data.businessDate) &&
        validString(data.closingId, 1, 80) &&
        data.closingId == data.businessDate + '__main' &&
        validIsoTimestampString(data.createdAt) &&
        validString(data.reason, 0, 600) &&
        data.registerId == 'main' &&
        data.revision is int &&
        data.revision >= 1 &&
        validString(data.get('sourceFingerprint', ''), 0, 64) &&
        data.type == 'cash-closing-event' &&
        validString(data.operationId, 8, 80) &&
        (!data.keys().hasAny(['snapshot']) || data.snapshot is map) &&
        (!data.keys().hasAny(['summary']) || data.summary is map);
    }

    function cashClosingEventReferencesSessionAfter(eventId) {
      let event = request.resource.data;
      let sessionPath = /databases/$(database)/documents/cashClosingSessions/$(event.closingId);
      let sessionAfter = getAfter(sessionPath).data;
      let expectedAction = event.action == 'closed' ? 'daily-close' : 'daily-reopen';
      return existsAfter(sessionPath) &&
        sessionAfter.lastEventId == eventId &&
        sessionAfter.lastEventType == event.action &&
        sessionAfter.lastOperationId == event.operationId &&
        sessionAfter.lastOperationAction == expectedAction &&
        sessionAfter.businessDate == event.businessDate &&
        sessionAfter.revision == event.revision &&
        sessionAfter.status == (event.action == 'closed' ? 'closed' : 'reopened');
    }

    function dailyClosingSessionTransitionCompanionsMatchAfter(closingId, data) {
      let sessionPath = /databases/$(database)/documents/cashClosingSessions/$(closingId);
      let hasPrevious = exists(sessionPath);
      let previous = hasPrevious ? get(sessionPath).data : {};
      let eventId = data.lastEventId;
      let eventPath = /databases/$(database)/documents/cashClosingEvents/$(eventId);
      let eventAfter = existsAfter(eventPath) ? getAfter(eventPath).data : {};
      let action = data.lastOperationAction;
      return (
        (
          action == 'daily-close' &&
          data.status == 'closed' &&
          (!hasPrevious || previous.status in ['open', 'reopened']) &&
          data.revision == previous.get('revision', 0) + 1 &&
          data.activityRevision == previous.get('activityRevision', 0) &&
          data.lastEventType == 'closed' &&
          existsAfter(eventPath) &&
          eventAfter.action == 'closed' &&
          eventAfter.operationId == data.lastOperationId &&
          eventAfter.closingId == closingId
        ) ||
        (
          action == 'daily-reopen' &&
          isOwner() &&
          hasPrevious &&
          previous.status == 'closed' &&
          data.status == 'reopened' &&
          data.revision == previous.revision &&
          data.activityRevision == previous.get('activityRevision', 0) + 1 &&
          data.lastEventType == 'reopened' &&
          existsAfter(eventPath) &&
          eventAfter.action == 'reopened' &&
          eventAfter.operationId == data.lastOperationId &&
          eventAfter.closingId == closingId
        )
      );
    }

    function dailyClosingSessionTransitionAllowed(closingId) {
      let data = request.resource.data;
      let action = data.lastOperationAction;
      return isApprovedAdmin() &&
        canManageBookkeepingData() &&
        validCashClosingSession(data, closingId) &&
        action in ['daily-close', 'daily-reopen'] &&
        repositoryOperationMatchesAfter(
          data.lastOperationId,
          'finance',
          action,
          'cashClosingSessions',
          closingId
        ) &&
        dailyClosingSessionTransitionCompanionsMatchAfter(closingId, data);
    }

    function cashClosingSessionWriteAllowed(closingId, data) {
      let action = data.get('lastOperationAction', '');
      return action in ['payment', 'proof-approve', 'refund', 'void']
        ? financeActivityFenceUpdateAllowed(closingId)
        : action in ['manual-create', 'manual-update', 'manual-delete']
          ? manualBookkeepingFenceUpdateAllowed(closingId)
          : action in ['daily-close', 'daily-reopen']
            ? dailyClosingSessionTransitionAllowed(closingId)
            : false;
    }

    match /cashClosingSessions/{closingId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create, update: if cashClosingSessionWriteAllowed(closingId, request.resource.data);
      allow delete: if false;
    }

    match /cashClosingEvents/{eventId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create: if isApprovedAdmin() &&
        canManageBookkeepingData() &&
        validCashClosingEvent(request.resource.data, eventId) &&
        cashClosingEventReferencesSessionAfter(eventId);
      allow update, delete: if false;
    }

    function validInventoryItem(data, itemId) {
      return data.keys().hasOnly(['id', 'name', 'category', 'type', 'quantity', 'unit', 'minStock', 'condition', 'status', 'location', 'note', 'createdAt', 'updatedAt']) &&
        data.id == itemId &&
        validString(data.name, 1, 160) &&
        validString(data.category, 1, 80) &&
        validString(data.type, 1, 40) &&
        validNumber(data.quantity, 0, 1000000) &&
        validString(data.unit, 1, 40) &&
        validNumber(data.minStock, 0, 1000000) &&
        validString(data.condition, 1, 40) &&
        validString(data.status, 1, 40) &&
        validString(data.location, 0, 240) &&
        validString(data.note, 0, 2000) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    match /inventoryItems/{itemId} {
      allow read: if isApproved() && canAccessInventoryData() ||
        (false && validInventoryItem(resource.data, itemId));
      // Canonical inventory writes run through Admin Operations Worker so item
      // metadata, stock movements, idempotency keys, and audit records commit atomically.
      allow create, update, delete: if false;
    }

    match /inventoryMovements/{movementId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update, delete: if false;
    }

    match /maintenanceWorkOrders/{workOrderId} {
      allow read: if isApproved() && canAccessInventoryData();
      // Work orders and their lifecycle are written only by Admin Operations Worker.
      allow create, update, delete: if false;
    }

    match /maintenanceEvents/{eventId} {
      allow read: if isApproved() && canAccessInventoryData();
      // Maintenance history is append-only and server-authoritative.
      allow create, update, delete: if false;
    }

    function validGalleryItem(data) {
      return data.keys().hasOnly([
          'title', 'description', 'url', 'publicId', 'category', 'isFavorite',
          'isDeleted', 'uploadedBy', 'createdAt', 'deletedAt',
          'permanentDeleteKey', 'permanentDeleteStartedAt', 'permanentDeleteStatus'
        ]) &&
        validString(data.title, 1, 180) &&
        validString(data.description, 0, 2000) &&
        validString(data.url, 8, 2000) &&
        validString(data.publicId, 1, 500) &&
        data.publicId.matches('^studio37/gallery/[A-Za-z0-9_./-]+$') &&
        validString(data.category, 1, 80) &&
        data.isFavorite is bool &&
        data.isDeleted is bool &&
        validString(data.uploadedBy, 1, 120) &&
        validIsoTimestampString(data.createdAt) &&
        (!data.keys().hasAny(['deletedAt']) || data.deletedAt == null || validIsoTimestampString(data.deletedAt));
    }

    match /gallery/{imageId} {
      allow read: if isApproved() && hasPermission('gallery');
      allow create: if isApproved() && hasPermission('gallery') &&
        validGalleryItem(request.resource.data) &&
        !request.resource.data.keys().hasAny([
          'permanentDeleteKey', 'permanentDeleteStartedAt', 'permanentDeleteStatus'
        ]);
      allow update: if isApproved() && hasPermission('gallery') &&
        (!resource.data.keys().hasAny(['permanentDeleteStatus']) ||
          resource.data.permanentDeleteStatus != 'deleting') &&
        validGalleryItem(request.resource.data) &&
        request.resource.data.publicId == resource.data.publicId &&
        request.resource.data.url == resource.data.url &&
        request.resource.data.uploadedBy == resource.data.uploadedBy &&
        request.resource.data.createdAt == resource.data.createdAt &&
        !request.resource.data.keys().hasAny([
          'permanentDeleteKey', 'permanentDeleteStartedAt', 'permanentDeleteStatus'
        ]);
      allow delete: if false;
    }

    // Server-authoritative operation control plane. Admin SDK/REST service
    // accounts bypass client rules after independently verifying actor access.
    match /adminOperationKeys/{operationId} {
      allow read, write: if false;
    }

    match /adminOperationAudit/{auditId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /adminOperationDryRuns/{snapshotId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    match /adminOperationJobs/{jobId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }

    // >>> STUDIO37 NOTIFICATION EVENT RULES START
    function validNotificationEvent(data, eventId) {
      return data.keys().hasOnly([
          'actorEmail', 'actorRole', 'actorUid', 'attempts',
          'bookingId', 'channel', 'createdAt', 'errorMessage',
          'id', 'message', 'metadata', 'paymentProofId',
          'priority', 'provider', 'sentAt', 'source', 'status',
          'targetMode', 'targetRole', 'targetUid', 'title',
          'type', 'updatedAt', 'url', 'lastAction', 'lastActionAt',
          'lastActionByEmail', 'lastActionByRole', 'lastActionByUid',
          'lastActionReason', 'lastActionRequestId', 'leaseExpiresAt',
          'leaseId', 'providerNotificationId'
        ]) &&
        data.id == eventId &&
        data.actorRole in ['admin', 'client', 'guard', 'system'] &&
        validString(data.actorUid, 1, 128) &&
        validString(data.actorEmail, 0, 254) &&
        validNumber(data.attempts, 0, 20) &&
        validString(data.bookingId, 0, 160) &&
        data.channel == 'in_app' &&
        validIsoTimestampString(data.createdAt) &&
        validString(data.errorMessage, 0, 1000) &&
        validString(data.message, 1, 600) &&
        data.metadata is map &&
        validString(data.paymentProofId, 0, 160) &&
        data.priority in ['low', 'normal', 'high'] &&
        data.provider == 'firestore' &&
        validOptionalString(data, 'sentAt', 40) &&
        validString(data.source, 1, 80) &&
        data.status in ['pending', 'processing', 'sent', 'failed', 'cancelled'] &&
        data.targetMode in ['role', 'user'] &&
        data.targetRole in ['admin', 'client', 'none'] &&
        validString(data.targetUid, 0, 128) &&
        validString(data.title, 1, 180) &&
        data.type in [
          'booking_confirmed',
          'booking_message_created',
          'booking_rejected',
          'booking_request_created',
          'guard_attendance_submitted',
          'payment_proof_approved',
          'payment_proof_rejected',
          'payment_proof_submitted'
        ] &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.url, 0, 700) &&
        validOptionalString(data, 'lastAction', 80) &&
        validOptionalString(data, 'lastActionAt', 40) &&
        validOptionalString(data, 'lastActionByEmail', 254) &&
        validOptionalString(data, 'lastActionByRole', 40) &&
        validOptionalString(data, 'lastActionByUid', 128) &&
        validOptionalString(data, 'lastActionReason', 500) &&
        validOptionalString(data, 'lastActionRequestId', 160) &&
        validOptionalString(data, 'leaseExpiresAt', 40) &&
        validOptionalString(data, 'leaseId', 160) &&
        validOptionalString(data, 'providerNotificationId', 240);
    }

    function notificationEventActorMatches(data) {
      return data.actorUid == request.auth.uid &&
        (
          (data.actorRole == 'client' && isClientAccount()) ||
          (data.actorRole == 'admin' && isApprovedAdmin()) ||
          (data.actorRole == 'guard' && isStudioGuardAccount())
        );
    }

    function notificationEventCreateIsRecorded(data) {
      return data.status == 'sent' &&
        data.attempts == 0 &&
        data.errorMessage == '' &&
        validIsoTimestampString(data.sentAt) &&
        !data.keys().hasAny([
          'lastAction', 'lastActionAt', 'lastActionByEmail',
          'lastActionByRole', 'lastActionByUid', 'lastActionReason',
          'lastActionRequestId', 'leaseExpiresAt', 'leaseId',
          'providerNotificationId'
        ]);
    }

    function notificationEventTargetIsSafe(data) {
      return (
          data.targetMode == 'role' &&
          data.targetRole == 'admin' &&
          data.targetUid == '' &&
          data.actorRole in ['admin', 'client', 'guard']
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'client' &&
          data.targetUid.size() > 0 &&
          data.actorRole == 'admin'
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'admin' &&
          data.targetUid.size() > 0 &&
          data.actorRole == 'admin'
        );
    }

    match /notificationEvents/{eventId} {
      allow read: if isSignedIn() && (
        canAccessNotifications() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );

      allow create: if isSignedIn() &&
        validNotificationEvent(request.resource.data, eventId) &&
        notificationEventActorMatches(request.resource.data) &&
        notificationEventCreateIsRecorded(request.resource.data) &&
        notificationEventTargetIsSafe(request.resource.data);

      // Activity events are immutable after creation.
      allow update, delete: if false;
    }
    // <<< STUDIO37 NOTIFICATION EVENT RULES END

    // Procurement reads follow Inventory/Bookkeeping permission boundaries.
    // All supplier, PO, receipt, payment, and event writes are Worker-owned.
    match /suppliers/{supplierId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update, delete: if false;
    }

    match /purchaseOrders/{purchaseOrderId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update, delete: if false;
    }

    match /goodsReceipts/{receiptId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update, delete: if false;
    }

    match /procurementPayments/{paymentId} {
      allow read: if isApproved() && canAccessBookkeepingData();
      allow create, update, delete: if false;
    }

    match /procurementEvents/{eventId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update, delete: if false;
    }

    // Customer follow-up reads follow the existing customer permission boundary.
    // Canonical task and immutable event writes are exclusively Worker-owned.
    match /customerFollowUpTasks/{taskId} {
      allow read: if isApproved() && canAccessCustomerData();
      allow create, update, delete: if false;
    }

    match /customerFollowUpEvents/{eventId} {
      allow read: if isApproved() && canAccessCustomerData();
      allow create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
