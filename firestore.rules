    }
    function bookingSessionIsUpcoming(data) {
      return data.get('sessionStatus', data.get('sessionState', 'upcoming')) in ['upcoming', 'scheduled'];
    }
    function bookingSessionIsInProgress(data) {
      return data.get('sessionStatus', data.get('sessionState', '')) in ['in_progress', 'active', 'ongoing'];
    }
    function bookingNoShowGraceElapsed(data) {
      let localNow = request.time + duration.value(7, 'h');
