rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isBootstrapOwnerEmail() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'marsicprod@gmail.com';
    }
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function ownershipControlExists() {
      return exists(/databases/$(database)/documents/adminControl/ownership);
    }
    function ownershipControlMatches() {
      return ownershipControlExists() &&
        get(/databases/$(database)/documents/adminControl/ownership).data.currentOwnerUid == request.auth.uid;
    }
    function isOwner() {
      return (!ownershipControlExists() && !userDocExists() && isBootstrapOwnerEmail()) ||
        (userDocExists() &&
          getUserData().role == 'owner' &&
          getUserData().status == 'approved' &&
          (!ownershipControlExists() || ownershipControlMatches()));
    }
    function isApproved() {
      return isOwner() ||
        (userDocExists() &&
          getUserData().role in ['admin', 'studio_guard'] &&
          getUserData().status == 'approved');
    }
    function isApprovedAdmin() {
      return isOwner() ||
        (userDocExists() &&
          getUserData().role == 'admin' &&
          getUserData().status == 'approved');
    }
    function isClientAccount() {
      return userDocExists() &&
        getUserData().role == 'client' &&
        getUserData().status == 'active';
    }
    function isStudioGuardAccount() {
      return userDocExists() &&
        getUserData().role == 'studio_guard' &&
        getUserData().status == 'approved';
    }
    function hasPermission(page) {
      return isOwner() ||
        (isApprovedAdmin() &&
          getUserData().permissions is map &&
          getUserData().permissions.get(page, false) == true);
    }
    function hasApprovedAdminPermission(page) {
      return hasPermission(page);
    }
    function hasProcurementBookkeepingPermission() {
      return hasPermission('bookkeeping');
    }
    function canAccessNotifications() {
      return isOwner() ||
        hasPermission('notifications') ||
        (isApprovedAdmin() &&
          getUserData().permissions is map &&
          !getUserData().permissions.keys().hasAny(['notifications']) &&
          getUserData().permissions.get('settings', false) == true);
    }
    function canManageOperatorFees() {
      return hasPermission('operator-fee');
    }
    function canManageGuardAttendance() {
      return isOwner() ||
        hasPermission('guard-attendance') ||
        (isApprovedAdmin() &&
          getUserData().permissions is map &&
          !getUserData().permissions.keys().hasAny(['guard-attendance']) &&
          getUserData().permissions.get('operator-fee', false) == true);
    }
    function canAccessBookingData() {
      return hasPermission('dashboard') ||
        hasPermission('schedule') ||
        hasPermission('customers') ||
        hasPermission('billing');
    }
    function canManageBookingData() {
      return hasPermission('schedule');
    }
    function isApprovedScheduleAdmin() {
      return hasPermission('schedule');
    }
    function canAccessCustomerData() {
      return hasPermission('dashboard') || hasPermission('customers');
    }
    function canManageCustomerData() {
      return hasPermission('customers');
    }
    function canAccessBookkeepingData() {
      return hasPermission('dashboard') || hasPermission('bookkeeping');
    }
    function canAccessInventoryData() {
      return hasPermission('dashboard') || hasPermission('inventory');
    }
    function canAccessMaintenanceData() {
      return canAccessInventoryData() || canAccessBookkeepingData();
    }
    match /guardAttendanceSessions/{attendanceId} {
      allow read: if canManageGuardAttendance() ||
        canManageOperatorFees() ||
        (isStudioGuardAccount() && resource.data.guardUid == request.auth.uid);
      allow create: if isStudioGuardAccount() &&
        request.resource.data.id == attendanceId &&
        request.resource.data.guardUid == request.auth.uid &&
        request.resource.data.status == 'pending_approval' &&
        request.resource.data.approvalStatus == 'pending';
      allow update: if (
          isStudioGuardAccount() &&
          resource.data.guardUid == request.auth.uid &&
          request.resource.data.guardUid == resource.data.guardUid &&
          resource.data.clockOutAt == '' &&
          request.resource.data.status == 'closed' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'clockOutAt', 'clockOutByUid', 'closedAt', 'durationHours', 'status', 'updatedAt'
          ])
        ) || (
          (canManageGuardAttendance() || canManageOperatorFees()) &&
          request.resource.data.id == resource.data.id &&
          request.resource.data.guardUid == resource.data.guardUid
        );
      allow delete: if isOwner();
    }
    function hasNoAdminPermissions(data) {
      return data is map &&
        data.get('dashboard', false) == false &&
        data.get('schedule', false) == false &&
        data.get('customers', false) == false &&
        data.get('billing', false) == false &&
        data.get('bookkeeping', false) == false &&
        data.get('operator-fee', false) == false &&
        data.get('guard-attendance', false) == false &&
        data.get('inventory', false) == false &&
        data.get('gallery', false) == false &&
        data.get('settings', false) == false &&
        data.get('notifications', false) == false;
    }
    function validUser(data, userId) {
      return data is map &&
        data.uid == userId &&
        data.role in ['owner', 'admin', 'client', 'studio_guard'] &&
        data.status in ['active', 'pending', 'approved', 'rejected'] &&
        data.permissions is map &&
        (
          (data.role == 'owner' && data.status == 'approved') ||
          (data.role == 'admin' && data.status in ['pending', 'approved', 'rejected']) ||
          (data.role == 'client' && data.status == 'active' && hasNoAdminPermissions(data.permissions)) ||
          (data.role == 'studio_guard' && data.status == 'approved' && hasNoAdminPermissions(data.permissions))
        );
    }
    function isSafeAccountSelfCreate(data) {
      return (isBootstrapOwnerEmail() && data.role == 'owner' && data.status == 'approved') ||
        (!isBootstrapOwnerEmail() && data.role == 'admin' && data.status == 'pending') ||
        (!isBootstrapOwnerEmail() && data.role == 'client' && data.status == 'active' && hasNoAdminPermissions(data.permissions));
    }
    function isSafeAdminRequestToClientTransition(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'admin' &&
        resource.data.status in ['pending', 'rejected'] &&
        request.resource.data.role == 'client' &&
        request.resource.data.status == 'active' &&
        hasNoAdminPermissions(request.resource.data.permissions) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'permissions', 'adminRequestCancelledAt', 'updatedAt'
        ]);
    }
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        validUser(request.resource.data, userId) &&
        isSafeAccountSelfCreate(request.resource.data);
      allow update: if validUser(request.resource.data, userId) && (
        (isOwner() && request.resource.data.role == resource.data.role) ||
        (isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'preferences', 'updatedAt'])) ||
        isSafeAdminRequestToClientTransition(userId)
      );
      allow delete: if false;
    }
    function canAccessOwnRepositoryOperations(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        (isApproved() || isClientAccount());
    }
    match /users/{userId}/repositoryOperations/{operationId} {
      allow read: if canAccessOwnRepositoryOperations(userId);
      allow create: if canAccessOwnRepositoryOperations(userId) &&
        request.resource.data.operationId == operationId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /adminControl/ownership {
      allow read: if isSignedIn();
      allow create: if isSignedIn() &&
        !ownershipControlExists() &&
        request.resource.data.currentOwnerUid == request.auth.uid &&
        (isBootstrapOwnerEmail() || isOwner());
      allow update, delete: if false;
    }
    function isClientBookingOwner(data) {
      return isClientAccount() && (
        (data.clientUid is string && data.clientUid == request.auth.uid) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) ||
        (
          'phone_number' in request.auth.token &&
          request.auth.token.phone_number is string &&
          (
            (data.phone is string && (
              data.phone == request.auth.token.phone_number ||
              ('+' + data.phone) == request.auth.token.phone_number
            )) ||
            (data.customerPhoneKey is string && (
              data.customerPhoneKey == request.auth.token.phone_number ||
              ('+' + data.customerPhoneKey) == request.auth.token.phone_number
            ))
          )
        )
      );
    }
    match /bookings/{bookingId} {
      allow read: if (isApproved() && (canAccessBookingData() || hasPermission('bookkeeping'))) ||
        isClientBookingOwner(resource.data);
      allow create: if (
          isApprovedScheduleAdmin() &&
          request.resource.data.id == bookingId
        ) || (
          isClientAccount() &&
          request.resource.data.id == bookingId &&
          request.resource.data.clientUid == request.auth.uid &&
          request.resource.data.source == 'clientPortal' &&
          request.resource.data.bookingRequestStatus == 'submitted' &&
          request.resource.data.paymentStatus == 'pending' &&
          request.resource.data.status == 'pending' &&
          request.resource.data.paidAmount == 0
        );
      allow update: if (
          isApproved() &&
          canAccessBookingData() &&
          request.resource.data.id == resource.data.id
        ) || (
          isClientBookingOwner(resource.data) &&
          request.resource.data.clientUid == resource.data.clientUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'bookingRequestStatus', 'clientRequestNote', 'clientRequestUpdatedAt',
            'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
            'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
          ])
        );
      allow delete: if false;
    }
    match /paymentProofs/{proofId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if isSignedIn() &&
        request.resource.data.id == proofId &&
        request.resource.data.clientUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      allow update: if hasApprovedAdminPermission('billing') &&
        resource.data.status == 'pending' &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.bookingId == resource.data.bookingId &&
        request.resource.data.clientUid == resource.data.clientUid &&
        request.resource.data.status in ['approved', 'rejected'];
      allow delete: if false;
    }
    match /bookingMessages/{messageId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if request.resource.data.id == messageId && (
        (
          isApproved() &&
          canAccessBookingData() &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderRole == 'admin'
        ) || (
          isClientAccount() &&
          request.resource.data.clientUid == request.auth.uid &&
          request.resource.data.senderUid == request.auth.uid &&
          request.resource.data.senderRole == 'client'
        )
      );
      allow update: if (
          isApproved() &&
          canAccessBookingData() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByAdmin']) &&
          request.resource.data.readByAdmin == true
        ) || (
          isClientAccount() &&
          resource.data.clientUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByClient']) &&
          request.resource.data.readByClient == true
        );
      allow delete: if isOwner();
    }
    match /bookingSessionEvents/{eventId} {
      allow read: if isApprovedScheduleAdmin();
      allow create: if isApprovedScheduleAdmin() &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /clientCalendarSlots/{slotId} {
      allow read: if true;
      allow create, update: if isApprovedScheduleAdmin() || hasApprovedAdminPermission('billing');
      allow delete: if isApprovedScheduleAdmin() || hasApprovedAdminPermission('billing');
    }
    match /bookingScheduleDays/{dateId} {
      allow read: if isApprovedAdmin() && (canManageBookingData() || hasPermission('billing'));
      allow create, update: if (isApprovedScheduleAdmin() || hasApprovedAdminPermission('billing')) &&
        request.resource.data.date == dateId;
      allow delete: if false;
    }
    match /customers/{customerId} {
      allow read: if (isApproved() && canAccessCustomerData()) ||
        (isClientAccount() && customerId == ('auth_' + request.auth.uid));
      allow create: if (
          isApproved() &&
          canManageCustomerData() &&
          request.resource.data.id == customerId
        ) || (
          isClientAccount() &&
          customerId == ('auth_' + request.auth.uid) &&
          request.resource.data.id == customerId &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.source == 'clientPortal'
        );
      allow update: if (
          isApproved() &&
          canManageCustomerData() &&
          request.resource.data.id == customerId
        ) || (
          isClientAccount() &&
          customerId == ('auth_' + request.auth.uid) &&
          resource.data.authUid == request.auth.uid &&
          request.resource.data.authUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'phone', 'phoneKey', 'email', 'updatedAt'])
        );
      allow delete: if isApproved() && canManageCustomerData();
    }
    match /settings/studio {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings');
      allow delete: if isOwner();
    }
    match /settings/pricing {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings');
      allow delete: if isOwner();
    }
    match /settings/invoice {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings');
      allow delete: if isOwner();
    }
    match /settings/operatorFees {
      allow read, create, update, delete: if isOwner();
    }
    match /operatorFeeEntries/{entryId} {
      allow read: if canManageOperatorFees();
      allow create: if canManageOperatorFees() &&
        request.resource.data.id == entryId &&
        request.resource.data.status in ['draft', 'reviewed'];
      allow update: if canManageOperatorFees() &&
        request.resource.data.id == entryId &&
        (resource.data.status != 'posted' || request.resource.data.status == 'posted');
      allow delete: if canManageOperatorFees() && resource.data.status != 'posted';
    }
    function canWriteBookkeepingEntry(data) {
      let source = data.get('source', '');
      return (source in ['', 'manual', 'procurement-payment', 'maintenance'] && hasApprovedAdminPermission('bookkeeping')) ||
        (source in ['booking-payment', 'booking-refund'] && (isApprovedScheduleAdmin() || hasApprovedAdminPermission('billing') || hasApprovedAdminPermission('bookkeeping'))) ||
        (source in ['operatorFee', 'guardAttendanceMeal'] && (canManageOperatorFees() || canManageGuardAttendance()));
    }
    match /bookkeepingEntries/{entryId} {
      allow read: if isApproved() && canAccessBookkeepingData();
      allow create: if isApproved() &&
        request.resource.data.id == entryId &&
        request.resource.data.type in ['income', 'expense'] &&
        canWriteBookkeepingEntry(request.resource.data);
      allow update: if hasApprovedAdminPermission('bookkeeping') &&
        request.resource.data.id == entryId &&
        resource.data.get('source', 'manual') in ['', 'manual'] &&
        request.resource.data.get('source', 'manual') in ['', 'manual'];
      allow delete: if hasApprovedAdminPermission('bookkeeping') &&
        resource.data.get('source', 'manual') in ['', 'manual'];
    }
    match /cashClosingSessions/{closingId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create, update: if isApproved() &&
        request.resource.data.id == closingId &&
        (hasApprovedAdminPermission('bookkeeping') || hasApprovedAdminPermission('billing') || isApprovedScheduleAdmin());
      allow delete: if false;
    }
    match /cashClosingEvents/{eventId} {
      allow read: if isApproved() && (canAccessBookkeepingData() || hasPermission('billing'));
      allow create: if hasApprovedAdminPermission('bookkeeping') &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /inventoryItems/{itemId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == itemId;
      allow delete: if false;
    }
    match /inventoryMovements/{movementId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == movementId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /maintenanceWorkOrders/{workOrderId} {
      allow read: if isApproved() && canAccessMaintenanceData();
      allow create: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == workOrderId;
      allow update: if (hasApprovedAdminPermission('inventory') || hasApprovedAdminPermission('bookkeeping')) &&
        request.resource.data.id == workOrderId;
      allow delete: if false;
    }
    match /maintenanceEvents/{eventId} {
      allow read: if isApproved() && canAccessMaintenanceData();
      allow create: if (hasApprovedAdminPermission('inventory') || hasApprovedAdminPermission('bookkeeping')) &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /gallery/{imageId} {
      allow read: if isApproved() && hasPermission('gallery');
      allow create: if isApproved() &&
        hasPermission('gallery') &&
        !request.resource.data.keys().hasAny(['permanentDeleteKey', 'permanentDeleteStartedAt', 'permanentDeleteStatus']);
      allow update: if isApproved() &&
        hasPermission('gallery') &&
        request.resource.data.publicId == resource.data.publicId &&
        request.resource.data.url == resource.data.url &&
        !request.resource.data.keys().hasAny(['permanentDeleteKey', 'permanentDeleteStartedAt', 'permanentDeleteStatus']);
      allow delete: if false;
    }
    match /adminOperationKeys/{operationId} {
      allow read, write: if false;
    }
    match /adminOperationAudit/{auditId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }
    match /adminOperationDryRuns/{snapshotId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }
    match /adminOperationJobs/{jobId} {
      allow read: if isOwner();
      allow create, update, delete: if false;
    }
    match /notificationEvents/{eventId} {
      allow read: if isSignedIn() && (
        canAccessNotifications() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid &&
        (isApprovedAdmin() || isClientAccount() || isStudioGuardAccount());
      allow update, delete: if false;
    }
    match /suppliers/{supplierId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == supplierId &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /purchaseOrders/{purchaseOrderId} {
      allow read: if isApproved() && (canAccessInventoryData() || hasPermission('bookkeeping'));
      allow create: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == purchaseOrderId &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if (hasApprovedAdminPermission('inventory') || hasProcurementBookkeepingPermission()) &&
        request.resource.data.id == purchaseOrderId;
      allow delete: if false;
    }
    match /goodsReceipts/{receiptId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create: if hasApprovedAdminPermission('inventory') &&
        request.resource.data.id == receiptId &&
        request.resource.data.receivedByUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /procurementPayments/{paymentId} {
      allow read: if isApproved() && canAccessBookkeepingData();
      allow create: if hasProcurementBookkeepingPermission() &&
        request.resource.data.id == paymentId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /procurementEvents/{eventId} {
      allow read: if isApproved() && (canAccessInventoryData() ||
        (hasPermission('bookkeeping') && resource.data.action == 'payment_recorded'));
      allow create: if (hasApprovedAdminPermission('inventory') || hasProcurementBookkeepingPermission()) &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /customerFollowUpTasks/{taskId} {
      allow read: if isApproved() && canAccessCustomerData();
      allow create: if isApproved() &&
        canManageCustomerData() &&
        request.resource.data.id == taskId &&
        request.resource.data.createdByUid == request.auth.uid;
      allow update: if isApproved() &&
        canManageCustomerData() &&
        request.resource.data.id == taskId &&
        request.resource.data.customerId == resource.data.customerId;
      allow delete: if false;
    }
    match /customerFollowUpEvents/{eventId} {
      allow read: if isApproved() && canAccessCustomerData();
      allow create: if isApproved() &&
        canManageCustomerData() &&
        request.resource.data.id == eventId &&
        request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
