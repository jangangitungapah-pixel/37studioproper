  resource.data.status == 'draft' && data.status in ['submitted', 'cancelled']
  ) || (
  resource.data.status == 'submitted' && data.status in ['approved', 'cancelled']
  ) || (
  resource.data.status == 'approved' && data.status in ['ordered', 'cancelled']
  );
  return nextStatusAllowed &&
  data.diff(resource.data).affectedKeys().hasOnly([
  'status', 'updatedAt', 'approvedAt', 'approvedByUid', 'approvedByName',
  'orderedAt', 'cancelledAt', 'cancelReason', 'cancelledByUid',
  'lastOperationId', 'lastOperationAction', 'lastEventId'
  ]) &&
  data.lastOperationAction == 'transition' &&
  (
  data.status != 'approved' ||
  (
  data.approvedAt == data.updatedAt &&
  data.approvedByUid == request.auth.uid
  )
  ) &&
  (
  data.status != 'ordered' ||
  data.orderedAt == data.updatedAt
  ) &&
  (
  data.status != 'cancelled' ||
  (
  resource.data.paidAmount == 0 &&
  data.cancelReason is string &&
  data.cancelReason.size() >= 4 &&
  data.cancelReason.size() <= 600 &&
  data.cancelledByUid == request.auth.uid &&
  data.cancelledAt == data.updatedAt
  )
  ) &&
  repositoryOperationMatchesAfter(
  data.lastOperationId,
  'procurement',
  'purchase-order-transition',
  'purchaseOrders',
  purchaseOrderId
  ) &&
  procurementPurchaseOrderEventMatchesAfter(data);
  }
  function procurementPurchaseOrderPaymentUpdateAllowed(purchaseOrderId, data) {
  let paymentId = data.get('lastPaymentId', '');
  let paymentPath = /databases/$(database)/documents/procurementPayments/$(paymentId);
  let payment = getAfter(paymentPath).data;
  let eventPath = /databases/$(database)/documents/procurementEvents/$(data.lastEventId);
  return resource.data.status in ['submitted', 'approved', 'ordered', 'partially_received', 'received'] &&
  data.status == resource.data.status &&
  data.diff(resource.data).affectedKeys().hasOnly([
  'paidAmount', 'updatedAt', 'lastOperationId', 'lastOperationAction',
  'lastEventId', 'lastPaymentId'
  ]) &&
  paymentId != '' &&
  existsAfter(paymentPath) &&
  payment.id == data.lastPaymentId &&
  payment.purchaseOrderId == purchaseOrderId &&
  payment.actorUid == request.auth.uid &&
  payment.operationId == data.lastOperationId &&
  payment.createdAt == data.updatedAt &&
  payment.amount > 0 &&
  data.paidAmount == resource.data.paidAmount + payment.amount &&
  data.paidAmount <= data.totalAmount &&
  existsAfter(eventPath) &&
  data.lastOperationAction == 'payment' &&
  repositoryOperationMatchesAfter(
  data.lastOperationId,
  'procurement',
  'procurement-payment',
  'purchaseOrders',
  purchaseOrderId
  );
  }
  function procurementPurchaseOrderUpdateAllowed(purchaseOrderId) {
  let data = request.resource.data;
  let action = data.get('lastOperationAction', '');
  return actorHasAdminPage(action == 'payment' ? 'bookkeeping' : 'inventory') &&
  data.id == purchaseOrderId &&
  validIsoTimestampString(data.updatedAt) &&
  data.updatedAt != resource.data.updatedAt &&
  data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
  data.lastOperationId != resource.data.lastOperationId &&
  data.lastEventId is string && data.lastEventId.size() > 0 &&
  (
  action == 'transition'
  ? procurementPurchaseOrderTransitionUpdateAllowed(purchaseOrderId, data)
  : action == 'payment'
  ? procurementPurchaseOrderPaymentUpdateAllowed(purchaseOrderId, data)
  : action == 'receipt' && procurementPurchaseOrderReceiptUpdateAllowed(purchaseOrderId, data)
  );
  }
  function procurementEventSupplierMatchesAfter(data) {
  let supplierPath = /databases/$(database)/documents/suppliers/$(data.entityId);
  let supplier = getAfter(supplierPath).data;
  return existsAfter(supplierPath) &&
  supplier.lastEventId == data.id &&
  supplier.lastOperationId == data.operationId &&
  supplier.status == 'active' &&
  supplier.createdAt == data.createdAt;
  }
  function procurementEventPurchaseOrderMatchesAfter(data) {
  let poPath = /databases/$(database)/documents/purchaseOrders/$(data.entityId);
  let po = getAfter(poPath).data;
  return existsAfter(poPath) &&
  po.lastEventId == data.id &&
  po.lastOperationId == data.operationId &&
  po.status == data.get('toStatus', '') &&
  po.updatedAt == data.createdAt &&
  po.lastOperationAction == (data.action == 'created' ? 'create' : 'transition');
  }
  function procurementGoodsReceiptEventMatchesAfter(data) {
  let receiptPath = /databases/$(database)/documents/goodsReceipts/$(data.entityId);
  let receipt = getAfter(receiptPath).data;
  return existsAfter(receiptPath) &&
  receipt.eventId == data.id &&
  receipt.operationId == data.operationId &&
  receipt.purchaseOrderId == data.purchaseOrderId &&
  receipt.items == data.items &&
  receipt.receivedAt == data.createdAt;
  }
  function procurementGoodsReceiptCreateAllowed(receiptId) {
  let data = request.resource.data;
  let poPath = /databases/$(database)/documents/purchaseOrders/$(data.purchaseOrderId);
  let po = getAfter(poPath).data;
  return actorHasAdminPage('inventory') &&
  data.keys().hasOnly([
  'id', 'purchaseOrderId', 'poNumber', 'supplierId', 'supplierName',
  'items', 'note', 'receivedAt', 'receivedByUid', 'receivedByName',
  'createdAt', 'operationId', 'eventId', 'payloadHash'
  ]) &&
  data.id == receiptId &&
  data.poNumber is string && data.poNumber.size() >= 12 &&
  data.supplierId is string && data.supplierId.size() > 0 &&
  data.items is list &&
  data.items.size() >= 1 &&
  data.items.size() <= 5 &&
  validIsoTimestampString(data.receivedAt) &&
  data.receivedByUid == request.auth.uid &&
  data.createdAt == data.receivedAt &&
  data.operationId.matches('^v1_[a-f0-9]{64}$') &&
  data.payloadHash.matches('^[a-f0-9]{64}$') &&
  data.eventId is string && data.eventId.size() > 0 &&
  existsAfter(poPath) &&
  po.lastReceiptId == receiptId &&
  po.lastEventId == data.eventId &&
  po.lastOperationId == data.operationId &&
  po.lastOperationAction == 'receipt' &&
  po.updatedAt == data.receivedAt &&
  po.status in ['partially_received', 'received'];
  }
  function procurementPurchaseOrderReceiptUpdateAllowed(purchaseOrderId, data) {
  let receiptId = data.get('lastReceiptId', '');
  let receiptPath = /databases/$(database)/documents/goodsReceipts/$(receiptId);
  let receipt = getAfter(receiptPath).data;
  let changed = data.diff(resource.data).affectedKeys();
  return resource.data.status in ['ordered', 'partially_received'] &&
  data.status in ['partially_received', 'received'] &&
  data.items is list &&
  data.items.size() == resource.data.items.size() &&
  changed.hasOnly([
  'items', 'status', 'updatedAt', 'receivedAt',
  'lastOperationId', 'lastOperationAction', 'lastEventId', 'lastReceiptId'
  ]) &&
  receiptId != '' &&
  existsAfter(receiptPath) &&
  receipt.id == receiptId &&
  receipt.purchaseOrderId == purchaseOrderId &&
  receipt.operationId == data.lastOperationId &&
  receipt.eventId == data.lastEventId &&
  receipt.receivedAt == data.updatedAt;
  }
  function procurementEventCreateAllowed(eventId) {
  let data = request.resource.data;
  return actorHasAdminPage(data.action == 'payment_recorded' ? 'bookkeeping' : 'inventory') &&
  validProcurementEvent(data, eventId) && (
    data.action == 'payment_recorded'
      ? data.entityType == 'purchase_order' &&
        procurementPaymentEventMatchesAfter(data)
      : (
          data.action == 'received'
            ? data.entityType == 'goods_receipt' &&
              procurementGoodsReceiptEventMatchesAfter(data)
            : (
                (
                  data.entityType == 'supplier' &&
                  data.action == 'created' &&
                  procurementEventSupplierMatchesAfter(data)
                ) ||
                (
                  data.entityType == 'purchase_order' &&
                  data.action in ['created', 'status_changed'] &&
                  procurementEventPurchaseOrderMatchesAfter(data)
                )
              )
        )
  );
  }
    match /suppliers/{supplierId} {
  allow read: if canAccessInventoryData();
  allow create: if procurementSupplierCreateAllowed(supplierId);
  allow update, delete: if false;
  }
    match /purchaseOrders/{purchaseOrderId} {
  allow read: if canAccessMaintenanceData();
  allow create: if procurementPurchaseOrderCreateAllowed(purchaseOrderId);
  allow update: if procurementPurchaseOrderUpdateAllowed(purchaseOrderId);
  allow delete: if false;
  }
    match /goodsReceipts/{receiptId} {
  allow read: if canAccessInventoryData();
  allow create: if procurementGoodsReceiptCreateAllowed(receiptId);
  allow update, delete: if false;
  }
    match /procurementPayments/{paymentId} {
  allow read: if canAccessBookkeepingData();
  allow create: if procurementPaymentCreateAllowed(paymentId);
  allow update, delete: if false;
  }
    match /procurementEvents/{eventId} {
  allow read: if actorCanReadProcurementEvent(resource.data.action);
  allow create: if procurementEventCreateAllowed(eventId);
  allow update, delete: if false;
  }
  function validCustomerFollowUpOptionalTimestamp(value) {
  return value is string && (value == '' || (value.size() >= 10 && value.size() <= 40));
  }
  function customerFollowUpActorAllowed() {
  let userPath = /databases/$(database)/documents/users/$(request.auth.uid);
  let ownershipPath = /databases/$(database)/documents/adminControl/ownership;
  let profileExists = exists(userPath);
  let profile = profileExists ? get(userPath).data : {};
  return profileExists
  ? profile.status == 'approved' &&
  (
  (
  profile.role == 'admin' &&
  profile.permissions is map &&
  profile.permissions.customers == true
  ) ||
  (
  profile.role == 'owner' &&
  (!exists(ownershipPath) ||
  get(ownershipPath).data.currentOwnerUid == request.auth.uid)
  )
  )
  : !exists(ownershipPath) && isBootstrapOwnerEmail();
  }
  function customerFollowUpAssigneeAllowed(uid) {
  return uid == request.auth.uid || customerFollowUpOtherAssigneeAllowed(uid);
  }
  function customerFollowUpOtherAssigneeAllowed(uid) {
  let userPath = /databases/$(database)/documents/users/$(uid);
  let ownershipPath = /databases/$(database)/documents/adminControl/ownership;
  let profileExists = exists(userPath);
  let profile = profileExists ? get(userPath).data : {};
  return profileExists &&
  profile.uid == uid &&
  profile.status == 'approved' &&
  (
  (
  profile.role == 'admin' &&
  profile.permissions is map &&
  profile.permissions.customers == true
  ) ||
  (
  profile.role == 'owner' &&
  exists(ownershipPath) &&
  get(ownershipPath).data.currentOwnerUid == uid
  )
  );
  }
  function validCustomerFollowUpEvent(data, eventId) {
  return data.keys().hasOnly([
  'id', 'taskId', 'customerId', 'action', 'actorUid', 'actorName',
  'changes', 'fromStatus', 'toStatus', 'outcome', 'dueAt', 'reason',
  'note', 'createdAt', 'operationId', 'operationAction'
  ]) &&
  data.id == eventId &&
  data.taskId is string && data.taskId.size() > 0 &&
  data.customerId is string && data.customerId.size() > 0 &&
  data.action in [
  'created', 'updated', 'reassigned', 'rescheduled', 'snoozed',
  'completed', 'cancelled', 'reopened', 'contacted', 'open',
  'in_progress'
  ] &&
  data.actorUid == request.auth.uid &&
  validIsoTimestampString(data.createdAt) &&
  data.operationId.matches('^v1_[a-f0-9]{64}$') &&
  data.operationAction in ['create', 'update'];
  }
  function validCustomerFollowUpTask(data, taskId) {
  return data.keys().size() == 42 &&
  data.id == taskId &&
  data.customerId is string && data.customerId.size() > 0 &&
  data.sourceId is string && data.sourceId.size() > 0 &&
  data.sourceType in ['customer', 'client_account', 'booking'] &&
  data.assignedToUid is string && data.assignedToUid.size() > 0 &&
  data.title is string && data.title.size() >= 3 &&
  data.templateKey in ['payment', 'booking', 'comeback'] &&
  data.status in ['open', 'in_progress', 'snoozed', 'completed', 'cancelled'] &&
  data.outcome in ['', 'connected', 'no_answer', 'rescheduled', 'not_interested', 'paid', 'booked', 'other'] &&
  validIsoDate(data.dueAt) &&
  (
  data.dueTime == '' ||
  data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
  ) &&
  validIsoTimestampString(data.createdAt) &&
  validIsoTimestampString(data.updatedAt) &&
  validCustomerFollowUpOptionalTimestamp(data.snoozedAt) &&
  data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
  data.lastOperationPayloadHash.size() == 64 &&
  data.lastOperationPayloadHash.matches('^[0-9a-f]{64}') &&
  data.lastEventId is string && data.lastEventId.size() > 0 &&
  data.lastEventSnapshot is map &&
  data.lastEventSnapshot.keys().size() >= 11 &&
  data.lastEventSnapshot.keys().size() <= 16 &&
  data.lastEventSnapshot.id == data.lastEventId &&
  data.lastEventSnapshot.taskId == data.id &&
  data.lastEventSnapshot.customerId == data.customerId &&
  data.lastEventSnapshot.actorUid == request.auth.uid &&
  data.lastEventSnapshot.operationId == data.lastOperationId &&
  data.lastEventSnapshot.operationAction == data.lastOperationAction &&
  data.lastEventSnapshot.createdAt == data.updatedAt;
  }
    function validCustomerFollowUpTaskUpdateEventSnapshot(data) {
  let snapshot = data.lastEventSnapshot;
  return snapshot is map &&
  snapshot.keys().size() == 16 &&
  snapshot.id == data.lastEventId &&
  snapshot.taskId == data.id &&
  snapshot.customerId == data.customerId &&
  snapshot.action is string && snapshot.action.size() > 0 &&
  snapshot.actorUid == request.auth.uid &&
  snapshot.changes is map &&
  snapshot.operationId == data.lastOperationId &&
  snapshot.operationAction == 'update' &&
  snapshot.createdAt == data.updatedAt;
  }
  function validCustomerFollowUpTaskUpdate(data, taskId) {
  return data.keys().size() == 42 &&
  data.id == taskId &&
  data.customerId == resource.data.customerId &&
  data.customerName == resource.data.customerName &&
  data.customerPhone == resource.data.customerPhone &&
  data.sourceId == resource.data.sourceId &&
  data.sourceType == resource.data.sourceType &&
  data.bookingId == resource.data.bookingId &&
  data.templateKey == resource.data.templateKey &&
  data.createdAt == resource.data.createdAt &&
  data.createdByUid == resource.data.createdByUid &&
  data.createdByName == resource.data.createdByName &&
  data.assignedToUid is string && data.assignedToUid.size() > 0 &&
  data.title is string && data.title.size() >= 3 &&
  data.status in ['open', 'in_progress', 'snoozed', 'completed', 'cancelled'] &&
  data.outcome in ['', 'connected', 'no_answer', 'rescheduled', 'not_interested', 'paid', 'booked', 'other'] &&
  validIsoDate(data.dueAt) &&
  (
  data.dueTime == '' ||
  data.dueTime.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
  ) &&
  data.revision == resource.data.revision + 1 &&
  validIsoTimestampString(data.updatedAt) &&
  validCustomerFollowUpOptionalTimestamp(data.snoozedAt) &&
  data.lastOperationId.matches('^v1_[a-f0-9]{64}$') &&
  data.lastOperationAction == 'update' &&
  data.lastOperationPayloadHash.size() == 64 &&
  data.lastOperationPayloadHash.matches('^[0-9a-f]{64}') &&
  data.lastEventId is string && data.lastEventId.size() > 0 &&
  validCustomerFollowUpTaskUpdateEventSnapshot(data);
  }
  function customerFollowUpPreviousEventRecorded() {
  let eventId = resource.data.get('lastEventId', '');
  let eventPath = /databases/$(database)/documents/customerFollowUpEvents/$(eventId);
  return eventId == '' || exists(eventPath);
  }
  function customerFollowUpTaskCreateAllowed(taskId) {
  let data = request.resource.data;
  return customerFollowUpActorAllowed() &&
  validCustomerFollowUpTask(data, taskId) &&
  data.revision == 1 &&
  data.createdByUid == request.auth.uid &&
  data.lastOperationAction == 'create' &&
  customerFollowUpAssigneeAllowed(data.assignedToUid) &&
  data.lastEventSnapshot.operationAction == 'create';
  }
  function customerFollowUpTaskUpdateAllowed(taskId) {
  let data = request.resource.data;
  return data.get('lastOperationId', '') is string &&
  data.get('lastOperationId', '') != resource.data.get('lastOperationId', '') &&
  customerFollowUpActorAllowed() &&
  customerFollowUpPreviousEventRecorded() &&
  validCustomerFollowUpTaskUpdate(data, taskId) &&
  (
  data.assignedToUid == resource.data.assignedToUid ||
  customerFollowUpAssigneeAllowed(data.assignedToUid)
  );
  }
  function customerFollowUpEventCreateAllowed(eventId) {
  let data = request.resource.data;
  let taskPath = /databases/$(database)/documents/customerFollowUpTasks/$(data.taskId);
  let taskExists = exists(taskPath);
  let task = taskExists ? get(taskPath).data : {};
  return customerFollowUpActorAllowed() &&
  validCustomerFollowUpEvent(data, eventId) &&
  taskExists &&
  task.lastEventSnapshot == data;
  }
  // Customer Follow-up writes the task snapshot first, then appends the exact
    match /customerFollowUpTasks/{taskId} {
  allow read: if isApproved() && canAccessCustomerData();
  allow create: if customerFollowUpTaskCreateAllowed(taskId);
  allow update: if customerFollowUpTaskUpdateAllowed(taskId);
  allow delete: if false;
  }
    match /customerFollowUpEvents/{eventId} {
  allow read: if isApproved() && canAccessCustomerData();
  allow create: if customerFollowUpEventCreateAllowed(eventId);
  allow update, delete: if false;
  }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
