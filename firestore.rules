            .concat(action == 'check_in' ? [] : action == 'start' ? ['sessionStatus'] : action == 'complete' ? ['sessionStatus', 'actualDurationMinutes'] : ['sessionStatus', 'noShowReason'])
        ) &&
        d[p + 'At'] == eventAfter.createdAt &&
        d[p + 'ByUid'] == request.auth.uid &&
        (action == 'check_in' || d.sessionStatus == (action == 'start' ? 'in_progress' : action == 'complete' ? 'completed' : 'no_show')) &&
        (!(action in ['check_in', 'no_show']) || notCheckedIn) &&
        (action != 'complete' || (d.actualDurationMinutes is int && d.actualDurationMinutes >= 1 && d.actualDurationMinutes <= 1440)) &&
        (action != 'no_show' || (d.noShowReason is string && d.noShowReason.size() >= 4 && d.noShowReason == eventAfter.reason && bookingNoShowGraceElapsed(resource.data)));
