rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function hasBootstrapOwnerToken() {
      return request.auth.token.email_verified == true &&
        request.auth.token.get('email', '').lower() == 'marsicprod@gmail.com';
    }
    function isBootstrapOwnerEmail() {
      return isSignedIn() && hasBootstrapOwnerToken();
    }
    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function ownershipControlExists() {
      return exists(/databases/$(database)/documents/adminControl/ownership);
    }
    function ownershipControlMatches() {
      return ownershipControlExists() &&
        get(/databases/$(database)/documents/adminControl/ownership).data.currentOwnerUid == request.auth.uid;
    }
    function isOwner() {
      return (!userDocExists() && isBootstrapOwnerEmail() && !ownershipControlExists()) ||
        (userDocExists() &&
          getUserData().role == 'owner' &&
          getUserData().status == 'approved' &&
          ownerUidMatches());
    }
    function ownerUidMatches() {
      let own = /databases/$(database)/documents/adminControl/ownership;
      return !exists(own) || get(own).data.currentOwnerUid == request.auth.uid;
    }
    function actorUser() {
      let p = /databases/$(database)/documents/users/$(request.auth.uid);
      return request.auth != null && exists(p) ? get(p).data : null;
    }
    function actorIsCurrentOwner(u) {
      return u != null && u.role == 'owner' && u.status == 'approved' && ownerUidMatches();
    }
    function actorIsOwnerOnly() {
      return actorIsCurrentOwner(actorUser());
    }
    function actorHasAdminPage(page) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && u.permissions.get(page, false) == true)
      );
    }
    function actorHasAdminPageOrOwnerOnly(page, ownerOnly) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (!ownerOnly && u.role == 'admin' && u.permissions is map && u.permissions.get(page, false) == true)
      );
    }
    function actorHasTwoAdminPages(pageA, pageB) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get(pageA, false) == true ||
          u.permissions.get(pageB, false) == true
        ))
      );
    }
    function actorCanReadBooking() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('schedule', false),
          u.permissions.get('customers', false),
          u.permissions.get('billing', false),
          u.permissions.get('bookkeeping', false)
        ])
      );
    }
    function actorApprovedGuardAdmin(u) {
      return u != null && u.role == 'admin' &&
        u.status == 'approved' &&
        u.permissions is map &&
        u.permissions.get('guard-attendance', u.permissions.get('operator-fee', false)) == true;
    }
    function actorCanManageGuardAttendanceAdminOnly() {
      return actorApprovedGuardAdmin(actorUser());
    }
    function actorCanManageGuardOrOperatorFees() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get('operator-fee', false) == true ||
          u.permissions.get('guard-attendance', false) == true
        ))
      );
    }
    function isApproved() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        u.role in ['admin', 'studio_guard'] ||
        (u.role == 'owner' && ownerUidMatches())
      );
    }
    function isClientAccount() {
      let u = actorUser();
      return u != null && u.role == 'client' && u.status == 'active';
    }
    function isStudioGuardAccount() {
      let u = actorUser();
      return u != null && u.role == 'studio_guard' && u.status == 'approved';
    }
    function hasCanonicalGuardId(data) {
      return data.guardId is string &&
        data.guardId.size() > 0;
    }
    function hasPermission(page) {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved' &&
        profile.permissions is map &&
        profile.permissions[page] == true
      ) || isOwner();
    }
    function hasApprovedAdminPermission(page) {
      let profileExists = userDocExists();
      let profile = profileExists ? getUserData() : {};
      return (
        profileExists &&
        profile.role == 'admin' &&
        profile.status == 'approved' &&
        profile.permissions is map &&
        profile.permissions[page] == true
      ) || isOwner();
    }
    function hasProcurementBookkeepingPermission() {
      return actorHasAdminPage('bookkeeping');
    }
    function canAccessNotifications() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map &&
          u.permissions.get('notifications', u.permissions.get('settings', false)) == true)
      );
    }
    function canManageOperatorFees() {
      return actorHasAdminPage('operator-fee');
    }
    function canManageGuardAttendance() {
      return isOwner() || actorCanManageGuardAttendanceAdminOnly();
    }
    function canAccessBookingData() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('schedule', false),
          u.permissions.get('customers', false),
          u.permissions.get('billing', false)
        ])
      );
    }
    function isApprovedScheduleAdmin() {
      return actorHasAdminPage('schedule');
    }
    function canAccessCustomerData() {
      return actorHasTwoAdminPages('dashboard', 'customers');
    }
    function canManageCustomerData() {
      return actorHasAdminPage('customers');
    }
    function canAccessBookkeepingData() {
      return actorHasTwoAdminPages('dashboard', 'bookkeeping');
    }
    function canAccessInventoryData() {
      return actorHasTwoAdminPages('dashboard', 'inventory');
    }
    function canAccessMaintenanceData() {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && true in [
          u.permissions.get('dashboard', false),
          u.permissions.get('inventory', false),
          u.permissions.get('bookkeeping', false)
        ])
      );
    }
    function actorCanReadProcurementEvent(action) {
      let u = actorUser();
      return u != null && u.status == 'approved' && (
        (u.role == 'owner' && ownerUidMatches()) ||
        (u.role == 'admin' && u.permissions is map && (
          u.permissions.get('dashboard', false) == true ||
          u.permissions.get('inventory', false) == true ||
          (action == 'payment_recorded' && u.permissions.get('bookkeeping', false) == true)
        ))
      );
    }
    function canAccessBookingDataOrClient(docClientUid) {
      let u = actorUser();
      return u != null && (
        (u.role == 'client' && u.status == 'active' && docClientUid == request.auth.uid) ||
        (u.status == 'approved' && (
          (u.role == 'owner' && ownerUidMatches()) ||
          (u.role == 'admin' && u.permissions is map && true in [
            u.permissions.get('dashboard', false),
            u.permissions.get('schedule', false),
            u.permissions.get('customers', false),
            u.permissions.get('billing', false)
          ])
        ))
      );
    }
    function actorCanReadCustomerOrClient(customerId) {
      let u = actorUser();
      return u != null && (
        (u.role == 'client' && u.status == 'active' && customerId == ('auth_' + request.auth.uid)) ||
        (u.status == 'approved' && (
          (u.role == 'owner' && ownerUidMatches()) ||
          (u.role == 'admin' && u.permissions is map && (
            u.permissions.get('dashboard', false) == true ||
            u.permissions.get('customers', false) == true
          ))
        ))
      );
    }
    function validString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }
    function validStrMax(value, maxSize) {
      return value is string && value.size() <= maxSize;
    }
    function validOptionalString(data, field, maxSize) {
      return !(field in data) ||
        (data[field] is string && data[field].size() <= maxSize);
    }
    function validNumber(value, minValue, maxValue) {
      return value is number && value >= minValue && value <= maxValue;
    }
    function validIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }
    function validIsoTimestampString(value) {
      return value is string && value.size() >= 10;
    }
    function validPermissions(data) {
      return data is map &&
        data.keys().hasAll([
          'dashboard', 'schedule', 'customers', 'billing',
          'bookkeeping', 'inventory', 'gallery', 'settings'
        ]) &&
        data.keys().hasOnly([
          'dashboard', 'schedule', 'customers', 'billing', 'bookkeeping',
          'operator-fee', 'guard-attendance', 'inventory', 'gallery', 'settings',
          'notifications'
        ]) &&
        data.values().hasOnly([true, false]);
    }
    function adminPermissionsAllFalse(data) {
      return data.values().hasOnly([false]);
    }
    function hasNoAdminPermissions(data) {
      return adminPermissionsAllFalse(data);
    }
    function hasOnlyGuardPortalPermissions(data) {
      return hasNoAdminPermissions(data);
    }
    function validPreferences(data) {
      return data is map &&
        data.keys().hasOnly(['accountNote', 'defaultLandingKey', 'notificationLevel', 'preferredContact', 'theme']);
    }
    function validUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'provider', 'permissions',
          'preferences', 'role', 'status', 'createdAt', 'updatedAt',
          'ownershipTransferredInAt', 'ownershipTransferredOutAt',
          'adminRequestCancelledAt', 'isGuard', 'guardId'
        ]) &&
        data.uid == userId &&
        data.email is string &&
        data.phoneNumber is string &&
        data.displayName is string && data.displayName.size() > 0 &&
        data.provider is string && data.provider.size() > 0 &&
        validPermissions(data.permissions) &&
        (
          (data.role == 'owner' && data.status == 'approved') ||
          (data.role == 'admin' && data.status in ['pending', 'approved', 'rejected', 'inactive']) ||
          (data.role == 'client' && data.status in ['active', 'rejected', 'inactive'] && hasNoAdminPermissions(data.permissions)) ||
          (data.role == 'studio_guard' && data.status == 'approved' && hasOnlyGuardPortalPermissions(data.permissions) && hasCanonicalGuardId(data)) ||
          (data.role == 'studio_guard' && data.status in ['pending', 'rejected', 'inactive'] && hasOnlyGuardPortalPermissions(data.permissions))
        ) &&
        (!('preferences' in data) || validPreferences(data.preferences)) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        (!data.keys().hasAny(['isGuard']) || data.isGuard == null || data.isGuard == false) &&
        (data.get('guardId', null) == null || data.guardId is string);
    }
    function authIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phoneNumber == request.auth.token.phone_number
        );
    }
    function isSafeAccountSelfCreate(data) {
      let bootstrap = isBootstrapOwnerEmail();
      return (bootstrap && data.role == 'owner' && data.status == 'approved') ||
        (!bootstrap && ((data.role == 'admin' && data.status == 'pending') || (data.role == 'client' && data.status == 'active')));
    }
    function isSafeAdminRequestToClientTransition(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'admin' &&
        resource.data.status in ['pending', 'rejected'] &&
        request.resource.data.role == 'client' &&
        request.resource.data.status == 'active' &&
        validIsoTimestampString(request.resource.data.adminRequestCancelledAt) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'permissions', 'adminRequestCancelledAt', 'updatedAt'
        ]);
    }
    function validGuardAttendanceSession(data, attendanceId) {
      return data.keys().hasOnly([
          'id', 'adminNote', 'approvalStatus', 'approvedAt', 'approvedByName', 'approvedByUid',
          'closedAt', 'clockInAt', 'clockInByUid', 'clockOutAt',
          'clockOutByUid', 'createdAt', 'date',
          'durationHours', 'guardEmail', 'guardName', 'guardPersonId',
          'guardUid', 'mealAmount', 'mealEligible',
          'mealBookkeepingEntryId', 'mealBookkeepingStatus',
          'mealPostedAt', 'mealPostedByUid', 'note',
          'ownerActionRequired', 'rejectedAt', 'rejectedByName',
          'rejectedByUid', 'rejectionReason', 'source', 'status',
          'updatedAt', 'voidedAt', 'voidedByUid', 'voidReason'
        ]) &&
        data.id == attendanceId &&
        data.approvalStatus in ['pending', 'approved', 'rejected'] &&
        validIsoTimestampString(data.clockInAt) &&
        validIsoTimestampString(data.createdAt) && validIsoDate(data.date) &&
        data.durationHours is number && data.durationHours >= 0 && data.durationHours <= 48 &&
        data.mealAmount is number && data.mealAmount >= 0 && data.mealAmount <= 1000000 &&
        data.mealEligible is bool && data.ownerActionRequired is bool &&
        data.get('mealBookkeepingStatus', 'not_posted') in ['not_posted', 'posted'] &&
        data.source == 'guardAttendance' &&
        data.status in ['pending_approval', 'active', 'closed', 'rejected', 'void'] &&
        validIsoTimestampString(data.updatedAt);
    }
    function getCurrentGuardPersonId() {
      return getUserData().guardId;
    }
    function guardMealStartsUnposted(data) {
      return data.get('mealBookkeepingStatus', 'not_posted') == 'not_posted' &&
        data.get('mealBookkeepingEntryId', '') == '' &&
        data.get('mealPostedAt', '') == '' &&
        data.get('mealPostedByUid', '') == '';
    }
    function guardMealNotPosted(data) {
      return data.get('mealBookkeepingStatus', '') != 'posted';
    }
    function guardCreatesOwnAttendance(data, attendanceId) {
      return isStudioGuardAccount() &&
        hasCanonicalGuardId(getUserData()) &&
        attendanceId == 'att__' + request.auth.uid + '__' + data.date &&
        data.guardUid == request.auth.uid &&
        data.clockInByUid == request.auth.uid &&
        data.clockOutByUid == '' &&
        data.guardPersonId == getCurrentGuardPersonId() &&
        data.status == 'pending_approval' &&
        data.approvalStatus == 'pending' &&
        data.mealEligible == false &&
        guardMealStartsUnposted(data) &&
        data.ownerActionRequired == true &&
        data.approvedAt == '' &&
        data.approvedByUid == '' &&
        data.rejectedAt == '' &&
        data.rejectedByUid == '' &&
        data.voidedAt == '' &&
        data.voidedByUid == '';
    }
    function validGuardSelfCheckoutPatch() {
      return validIsoTimestampString(request.resource.data.clockOutAt) &&
        request.resource.data.closedAt == request.resource.data.clockOutAt &&
        request.resource.data.clockOutByUid == request.auth.uid &&
        request.resource.data.durationHours is number && request.resource.data.durationHours >= 0 && request.resource.data.durationHours <= 48 &&
        (!('note' in request.resource.data) || request.resource.data.note is string) &&
        validIsoTimestampString(request.resource.data.updatedAt);
    }
    function guardClosesOwnAttendance() {
      return isStudioGuardAccount() &&
        validGuardSelfCheckoutPatch() &&
        resource.data.guardUid == request.auth.uid &&
        request.resource.data.guardUid == resource.data.guardUid &&
        request.resource.data.guardPersonId == resource.data.guardPersonId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        resource.data.clockOutAt == '' &&
        resource.data.status in ['active', 'pending_approval'] &&
        request.resource.data.status == 'closed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clockOutAt',
          'clockOutByUid',
          'closedAt',
          'durationHours',
          'note',
          'status',
          'updatedAt'
        ]);
    }
    function guardUpdatesOwnNote() {
      return request.resource.data.status == resource.data.status &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        (!('note' in request.resource.data) || request.resource.data.note is string) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'note',
          'updatedAt'
        ]);
    }
    function guardResubmitsOwnAttendance() {
      let d = request.resource.data;
      let r = resource.data;
      return hasCanonicalGuardId(getUserData()) &&
        d.guardPersonId == r.guardPersonId &&
        d.date == r.date &&
        d.source == r.source &&
        r.approvalStatus == 'rejected' &&
        r.status != 'void' &&
        guardMealNotPosted(r) &&
        guardMealStartsUnposted(d) &&
        d.status == 'pending_approval' &&
        d.approvalStatus == 'pending' &&
        d.mealEligible == false &&
        d.ownerActionRequired == true &&
        d.clockInByUid == request.auth.uid &&
        d.clockOutAt == '' &&
        d.clockOutByUid == '';
    }
    function guardAttendanceCoreIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.guardUid == resource.data.guardUid;
    }
    function validGuardAttendanceOwnerReviewAuditFields() {
      return validIsoTimestampString(
          request.resource.data.updatedAt
        ) &&
        request.resource.data.mealEligible is bool;
    }
    function validGuardAttendanceOwnerApprovePatch() {
      return validIsoTimestampString(request.resource.data.approvedAt) &&
        request.resource.data.approvedByUid is string && request.resource.data.approvedByUid.size() > 0;
    }
    function validGuardAttendanceOwnerRejectPatch() {
      return validIsoTimestampString(request.resource.data.rejectedAt) &&
        request.resource.data.rejectedByUid is string && request.resource.data.rejectedByUid.size() > 0 &&
        request.resource.data.rejectionReason is string && request.resource.data.rejectionReason.size() > 0;
    }
    function validGuardAttendanceOwnerVoidPatch() {
      return validIsoTimestampString(request.resource.data.voidedAt) &&
        request.resource.data.voidedByUid is string && request.resource.data.voidedByUid.size() > 0 &&
        request.resource.data.voidReason is string && request.resource.data.voidReason.size() > 0;
    }
    function adminApprovesGuardAttendance() {
      return validGuardAttendanceOwnerApprovePatch() &&
        resource.data.approvalStatus in ['pending', 'rejected'] &&
        request.resource.data.approvalStatus == 'approved' &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.rejectedAt == '' &&
        request.resource.data.rejectedByUid == '' &&
        request.resource.data.rejectionReason == '' &&
        (
          (
            resource.data.clockOutAt == '' &&
            request.resource.data.status == 'active'
          ) ||
          (
            resource.data.clockOutAt != '' &&
            request.resource.data.status == 'closed'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'adminNote',
          'approvalStatus',
          'approvedAt',
          'approvedByName',
          'approvedByUid',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }
    function adminRejectsGuardAttendance() {
      return validGuardAttendanceOwnerRejectPatch() &&
        guardMealNotPosted(resource.data) &&
        resource.data.approvalStatus in ['pending', 'approved'] &&
        request.resource.data.approvalStatus == 'rejected' &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }
    function adminVoidsGuardAttendance() {
      return validGuardAttendanceOwnerVoidPatch() &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.status == 'void' &&
        request.resource.data.voidedAt != '' &&
        request.resource.data.voidedByUid != '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealEligible',
          'ownerActionRequired',
          'status',
          'updatedAt',
          'voidReason',
          'voidedAt',
          'voidedByUid'
        ]);
    }
    function guardMealBookkeepingExistsAfter() {
      let entryId =
        request.resource.data.mealBookkeepingEntryId;
      let entryPath =
        /databases/$(database)/documents/bookkeepingEntries/$(entryId);
      let entryAfter = getAfter(entryPath).data;
      return entryId is string &&
        entryId.size() > 0 &&
        existsAfter(entryPath) &&
        getAfter(entryPath).data.source == 'guardAttendanceMeal' &&
        entryAfter.sourceAttendanceId == resource.data.id &&
        entryAfter.sourceAttendanceDate == resource.data.date &&
        entryAfter.sourceGuardPersonId == resource.data.guardPersonId &&
        entryAfter.amount == resource.data.mealAmount;
    }
    function adminPostsGuardMeal() {
      return actorCanManageGuardOrOperatorFees() &&
        resource.data.approvalStatus == 'approved' &&
        resource.data.status == 'closed' &&
        resource.data.mealEligible == true &&
        resource.data.mealAmount > 0 &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.mealBookkeepingStatus == 'posted' &&
        request.resource.data.mealPostedAt != '' &&
        request.resource.data.mealPostedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealBookkeepingEntryId',
          'mealBookkeepingStatus',
          'mealPostedAt',
          'mealPostedByUid',
          'updatedAt'
        ]) &&
        guardMealBookkeepingExistsAfter();
    }
    function adminReviewsGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        validGuardAttendanceOwnerReviewAuditFields() &&
        resource.data.status != 'void' &&
        (
          adminVoidsGuardAttendance() ||
          adminRejectsGuardAttendance() ||
          adminApprovesGuardAttendance()
        );
    }
    match /guardAttendanceSessions/{attendanceId} {
      allow read: if canManageGuardAttendance() ||
        canManageOperatorFees() || (
          isStudioGuardAccount() &&
          resource.data.guardUid == request.auth.uid
        );
      allow create: if validGuardAttendanceSession(request.resource.data, attendanceId) &&
        guardCreatesOwnAttendance(
          request.resource.data,
          attendanceId
        );
      allow update: if guardClosesOwnAttendance() ||
        adminReviewsGuardAttendance() || (
          validGuardAttendanceSession(
            request.resource.data,
            attendanceId
          ) &&
          adminPostsGuardMeal()
        ) || (
          isStudioGuardAccount() &&
          resource.data.guardUid == request.auth.uid &&
          request.resource.data.guardUid == resource.data.guardUid &&
          validIsoTimestampString(request.resource.data.updatedAt) &&
          (guardUpdatesOwnNote() || guardResubmitsOwnAttendance())
        );
      allow delete: if actorIsOwnerOnly();
    }
    // <<< STUDIO37 GUARD ATTENDANCE RULES END
match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || actorHasAdminPage('settings'));
      allow create: if isSignedIn() &&
        validUser(request.resource.data, userId) && (
          (
            request.auth.uid == userId &&
            authIdentityMatches(request.resource.data) &&
            isSafeAccountSelfCreate(request.resource.data)
          ) || (
            isOwner() &&
            request.resource.data.role != 'owner'
          )
        );
      allow update: if validUser(request.resource.data, userId) && (
        (
          isOwner() &&
          (
            request.resource.data.role == resource.data.role ||
            (userId != request.auth.uid && resource.data.role != 'owner' && request.resource.data.role != 'owner')
          )
        ) || (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'preferences', 'updatedAt'])
        ) || isSafeAdminRequestToClientTransition(userId)
      );
      allow delete: if actorIsOwnerOnly() && userId != request.auth.uid && resource.data.role != 'owner';
    }
    function canAccessOwnRepositoryOperations(userId) {
      let profile = actorUser();
      return request.auth != null &&
        request.auth.uid == userId &&
        profile != null &&
        (
          (profile.status == 'approved' && (
            profile.role in ['admin', 'studio_guard'] ||
            (profile.role == 'owner' && ownerUidMatches())
          )) ||
          (profile.role == 'client' && profile.status == 'active')
        );
    }
    function validRepositoryOperation(data, operationId) {
      return data is map &&
        data.keys().hasOnly([
          'operationId', 'actorUid', 'scope', 'action', 'requestId',
          'payloadHash', 'resultCollection', 'resultId', 'createdAt'
        ]) &&
        data.operationId == operationId &&
        operationId.matches('^v1_[a-f0-9]{64}$') &&
        data.actorUid == request.auth.uid &&
        data.scope.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.action.matches('^[a-z][a-z0-9-]{1,47}$') &&
        data.requestId.matches('^[A-Za-z0-9._:-]{8,128}$') &&
        data.payloadHash.matches('^[a-f0-9]{64}$') &&
        (
          (data.resultCollection == '' && data.resultId == '') ||
          (
            data.resultCollection.matches('^[A-Za-z][A-Za-z0-9_]{0,63}$') &&
            data.resultId.matches('^[^/]{1,160}$')
          )
        ) &&
        data.createdAt == request.time;
    }
    function maintenanceOperationMarkerMatches(data) {
      let workOrderPath = /databases/$(database)/documents/maintenanceWorkOrders/$(data.resultId);
      let workOrder = getAfter(workOrderPath).data;
      let expectedAction = data.action == 'waiting-parts' ? 'waiting_parts' : data.action;
      return data.resultCollection == 'maintenanceWorkOrders' &&
        data.action in [
          'report', 'triage', 'approve', 'assign', 'start', 'waiting-parts',
          'resume', 'complete', 'verify', 'cancel', 'reopen', 'cost'
        ] &&
        existsAfter(workOrderPath) &&
        workOrder.id == data.resultId &&
        workOrder.lastOperationId == data.operationId &&
        workOrder.lastOperationAction == expectedAction &&
        validString(workOrder.lastEventId, 1, 160);
    }
    function repositoryOperationDomainMatches(data) {
      return (
        data.scope != 'customer-follow-up' ||
        customerFollowUpOperationMarkerMatches(data)
      ) && (
        data.scope != 'maintenance' ||
        maintenanceOperationMarkerMatches(data)
      );
    }
    function customerFollowUpOperationMarkerMatches(data) {
      let taskPath = /databases/$(database)/documents/customerFollowUpTasks/$(data.resultId);
      let task = get(taskPath).data;
      return data.action in ['create', 'update'] &&
        data.resultCollection == 'customerFollowUpTasks' &&
        exists(taskPath) &&
        task.id == data.resultId &&
        task.lastOperationId == data.operationId &&
        task.lastOperationAction == data.action &&
        task.lastOperationPayloadHash == data.payloadHash;
    }
    match /users/{userId}/repositoryOperations/{operationId} {
      allow read: if canAccessOwnRepositoryOperations(userId);
