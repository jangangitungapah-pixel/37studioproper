rules_version = '2';

// ===============================================================
// Communication data model
// ===============================================================
// bookings/{bookingId}: existing booking fields plus optional request status,
// response notes, and immutable last-message summary fields.
// bookingMessages/{messageId}: id, bookingId, clientUid, senderUid,
// senderRole, senderName, text, type, createdAt, readByAdmin, readByClient.
// Messages are private to the owning client and approved booking admins.
// users/{uid}: one authoritative account role. Valid states are owner/approved,
// admin/pending|approved|rejected, client/active, and studio_guard/approved.
// Client accounts always have every admin permission disabled.
// Studio guard does not use admin-page permissions and may only access
// its own guard attendance records through the dedicated guard rules.
// ===============================================================
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapOwnerEmail() {
      return isSignedIn() &&
        request.auth.token.email is string &&
        request.auth.token.email_verified == true &&
        request.auth.token.email.lower() == 'marsicprod@gmail.com';
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isOwner() {
      return isBootstrapOwnerEmail() ||
        (userDocExists() && getUserData().role == 'owner');
    }

    function isApproved() {
      return isOwner() ||
        (userDocExists() &&
          getUserData().role in ['admin', 'studio_guard'] &&
          getUserData().status == 'approved');
    }

    function isApprovedAdmin() {
      return isOwner() ||
        (userDocExists() &&
          getUserData().role == 'admin' &&
          getUserData().status == 'approved');
    }

    function isClientAccount() {
      return userDocExists() &&
        getUserData().role == 'client' &&
        getUserData().status == 'active';
    }

    function isStudioGuardAccount() {
      return userDocExists() && (
        (getUserData().role == 'studio_guard' && getUserData().status == 'approved') ||
        (getUserData().role == 'admin' && getUserData().status == 'approved' && 'isGuard' in getUserData() && getUserData().isGuard == true)
      );
    }

    function hasPermission(page) {
      return isOwner() || (
        isApprovedAdmin() &&
        getUserData().permissions is map &&
        getUserData().permissions[page] == true
      );
    }

    function canManageOperatorFees() {
      return isOwner() || (
        isApprovedAdmin() &&
        hasPermission('operator-fee')
      );
    }

    function canManageGuardAttendance() {
      return isOwner() || (
        isApprovedAdmin() &&
        hasPermission('guard-attendance')
      );
    }

    function canAccessBookingData() {
      return hasPermission('dashboard') ||
        hasPermission('schedule') ||
        hasPermission('customers') ||
        hasPermission('billing');
    }

    function canAccessCustomerData() {
      return hasPermission('dashboard') || hasPermission('customers');
    }

    function canAccessBookkeepingData() {
      return hasPermission('dashboard') || hasPermission('bookkeeping');
    }

    function canAccessInventoryData() {
      return hasPermission('dashboard') || hasPermission('inventory');
    }

    function validString(value, minSize, maxSize) {
      return value is string && value.size() >= minSize && value.size() <= maxSize;
    }

    function validOptionalString(data, field, maxSize) {
      return !data.keys().hasAny([field]) ||
        (data[field] is string && data[field].size() <= maxSize);
    }

    function validNumber(value, minValue, maxValue) {
      return value is number && float(value) >= float(minValue) && float(value) <= float(maxValue);
    }

    function validIsoDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function validIsoTimestampString(value) {
      return value is string && value.size() >= 10 && value.size() <= 40;
    }

    function validPermissions(data) {
      return data is map &&
        data.keys().hasOnly([
          'dashboard', 'schedule', 'customers', 'billing', 'bookkeeping',
          'operator-fee', 'guard-attendance', 'inventory', 'gallery', 'settings'
        ]) &&
        data.dashboard is bool && data.schedule is bool &&
        data.customers is bool && data.billing is bool &&
        (!data.keys().hasAny(['operator-fee']) || data['operator-fee'] is bool) &&
        (!data.keys().hasAny(['guard-attendance']) || data['guard-attendance'] is bool) &&
        data.bookkeeping is bool && data.inventory is bool &&
        data.gallery is bool && data.settings is bool;
    }

    function hasNoAdminPermissions(data) {
      return validPermissions(data) &&
        data.dashboard == false && data.schedule == false &&
        data.customers == false && data.billing == false &&
        data.bookkeeping == false &&
        (!data.keys().hasAny(['operator-fee']) || data['operator-fee'] == false) &&
        (!data.keys().hasAny(['guard-attendance']) || data['guard-attendance'] == false) &&
        data.inventory == false &&
        data.gallery == false && data.settings == false;
    }

    function hasOnlyGuardPortalPermissions(data) {
      return hasNoAdminPermissions(data);
    }

    function validPreferences(data) {
      return data is map &&
        data.keys().hasOnly(['accountNote', 'defaultLandingKey', 'notificationLevel', 'preferredContact']) &&
        validString(data.accountNote, 0, 240) &&
        data.defaultLandingKey in [
          'dashboard', 'schedule', 'billing', 'bookkeeping', 'operator-fee',
          'guard-attendance', 'inventory', 'settings'
        ] &&
        data.notificationLevel in ['important', 'standard', 'proactive'] &&
        data.preferredContact in ['email', 'phone', 'none'];
    }

    function validUser(data, userId) {
      return data.keys().hasOnly([
          'uid', 'email', 'phoneNumber', 'displayName', 'provider', 'permissions',
          'preferences', 'role', 'status', 'createdAt', 'updatedAt',
          'ownershipTransferredInAt', 'ownershipTransferredOutAt',
          'adminRequestCancelledAt', 'isGuard', 'guardId'
        ]) &&
        data.uid == userId &&
        validString(data.email, 0, 254) &&
        validString(data.phoneNumber, 0, 32) &&
        validString(data.displayName, 1, 120) &&
        validString(data.provider, 1, 80) &&
        data.role in ['owner', 'admin', 'client', 'studio_guard'] &&
        data.status in ['active', 'pending', 'approved', 'rejected'] &&
        validPermissions(data.permissions) &&
        (
          (data.role == 'owner' && data.status == 'approved') ||
          (data.role == 'admin' && data.status in ['pending', 'approved', 'rejected']) ||
          (data.role == 'client' && data.status == 'active' && hasNoAdminPermissions(data.permissions)) ||
          (data.role == 'studio_guard' && data.status == 'approved' && hasOnlyGuardPortalPermissions(data.permissions))
        ) &&
        (!data.keys().hasAny(['preferences']) || validPreferences(data.preferences)) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'ownershipTransferredInAt', 40) &&
        validOptionalString(data, 'ownershipTransferredOutAt', 40) &&
        validOptionalString(data, 'adminRequestCancelledAt', 40) &&
        (!data.keys().hasAny(['isGuard']) || data.isGuard == null || data.isGuard is bool) &&
        (!data.keys().hasAny(['guardId']) || data.guardId == null || (data.guardId is string && data.guardId.size() <= 160));
    }

    function authIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phoneNumber == request.auth.token.phone_number
        );
    }

    function isSafeAccountSelfCreate(data) {
      return (
          isBootstrapOwnerEmail() &&
          data.role == 'owner' &&
          data.status == 'approved'
        ) || (
          !isBootstrapOwnerEmail() &&
          data.role == 'admin' &&
          data.status == 'pending'
        ) || (
          !isBootstrapOwnerEmail() &&
          data.role == 'client' &&
          data.status == 'active' &&
          hasNoAdminPermissions(data.permissions)
        );
    }

    function isSafeAdminRequestToClientTransition(userId) {
      return isSignedIn() &&
        request.auth.uid == userId &&
        resource.data.role == 'admin' &&
        resource.data.status in ['pending', 'rejected'] &&
        request.resource.data.role == 'client' &&
        request.resource.data.status == 'active' &&
        hasNoAdminPermissions(request.resource.data.permissions) &&
        validIsoTimestampString(request.resource.data.adminRequestCancelledAt) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'role', 'status', 'permissions', 'adminRequestCancelledAt', 'updatedAt'
        ]);
    }
    // >>> STUDIO37 NOTIFICATION SUBSCRIPTION RULES START
    function validNotificationSubscription(data, subscriptionUserId) {
      return data.keys().hasOnly([
          'uid', 'role', 'email', 'platform', 'permission', 'optedIn',
          'oneSignalId', 'subscriptionId', 'userAgent', 'source',
          'lastSyncReason', 'createdAt', 'updatedAt'
        ]) &&
        data.uid == subscriptionUserId &&
        validString(data.uid, 1, 128) &&
        data.role in ['admin', 'client', 'studio_guard'] &&
        validString(data.email, 0, 254) &&
        data.platform == 'web' &&
        data.permission in ['default', 'granted', 'denied', 'unsupported', 'unknown'] &&
        data.optedIn is bool &&
        validString(data.oneSignalId, 0, 160) &&
        validString(data.subscriptionId, 0, 160) &&
        validString(data.userAgent, 0, 600) &&
        data.source == 'onesignal-web' &&
        validString(data.lastSyncReason, 0, 80) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function validNotificationSubscriptionDevice(data, deviceId) {
      return data.keys().hasOnly([
          'id', 'deviceId', 'uid', 'role', 'email', 'platform', 'permission',
          'optedIn', 'oneSignalId', 'subscriptionId', 'userAgent', 'source',
          'lastSyncReason', 'createdAt', 'updatedAt', 'lastSeenAt', 'isActive'
        ]) &&
        data.id == deviceId &&
        data.deviceId == deviceId &&
        validString(data.id, 1, 260) &&
        validString(data.deviceId, 1, 260) &&
        data.uid == request.auth.uid &&
        validString(data.uid, 1, 128) &&
        data.role in ['admin', 'client'] &&
        validString(data.email, 0, 254) &&
        data.platform == 'web' &&
        data.permission in ['default', 'granted', 'denied', 'unsupported', 'unknown'] &&
        data.optedIn is bool &&
        data.isActive is bool &&
        validString(data.oneSignalId, 0, 160) &&
        validString(data.subscriptionId, 1, 160) &&
        validString(data.userAgent, 0, 600) &&
        data.source == 'onesignal-web' &&
        validString(data.lastSyncReason, 0, 80) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validIsoTimestampString(data.lastSeenAt);
    }

    function notificationSubscriptionIdentityMatches(data) {
      return data.email == '' || (
        request.auth.token.email is string &&
        data.email.lower() == request.auth.token.email.lower()
      );
    }

    function notificationSubscriptionRoleMatches(data) {
      return (data.role == 'client' && isClientAccount()) ||
        (data.role == 'admin' && isApprovedAdmin()) ||
        (data.role == 'studio_guard' && isStudioGuardAccount());
    }

    match /notificationSubscriptions/{subscriptionUserId} {
      allow read: if isSignedIn() && (
        request.auth.uid == subscriptionUserId ||
        isApprovedAdmin()
      );

      allow create, update: if isSignedIn() &&
        request.auth.uid == subscriptionUserId &&
        validNotificationSubscription(request.resource.data, subscriptionUserId) &&
        notificationSubscriptionIdentityMatches(request.resource.data) &&
        notificationSubscriptionRoleMatches(request.resource.data);

      allow delete: if isOwner() || (isSignedIn() && request.auth.uid == subscriptionUserId);
    }

    match /notificationSubscriptionDevices/{deviceId} {
      allow read: if isSignedIn() && (
        resource.data.uid == request.auth.uid ||
        isApprovedAdmin()
      );

      allow create, update: if isSignedIn() &&
        validNotificationSubscriptionDevice(request.resource.data, deviceId) &&
        notificationSubscriptionIdentityMatches(request.resource.data) &&
        notificationSubscriptionRoleMatches(request.resource.data);

      allow delete: if isOwner() || (
        isSignedIn() &&
        resource.data.uid == request.auth.uid
      );
    }
    // <<< STUDIO37 NOTIFICATION SUBSCRIPTION RULES END


    // >>> STUDIO37 GUARD ATTENDANCE RULES START
    function validGuardAttendanceSession(data, attendanceId) {
      return data.keys().hasOnly([
          'id', 'approvalStatus', 'approvedAt', 'approvedByName', 'approvedByUid',
          'closedAt', 'clockInAt', 'clockInByUid', 'clockOutAt',
          'clockOutByUid', 'createdAt', 'date',
          'durationHours', 'guardEmail', 'guardName', 'guardPersonId',
          'guardUid', 'mealAmount', 'mealEligible',
          'mealBookkeepingEntryId', 'mealBookkeepingStatus',
          'mealPostedAt', 'mealPostedByUid', 'note',
          'ownerActionRequired', 'rejectedAt', 'rejectedByName',
          'rejectedByUid', 'rejectionReason', 'source', 'status',
          'updatedAt', 'voidedAt', 'voidedByUid', 'voidReason'
        ]) &&
        data.id == attendanceId &&
        data.approvalStatus in ['pending', 'approved', 'rejected'] &&
        validString(data.approvedAt, 0, 40) &&
        validString(data.approvedByName, 0, 120) &&
        validString(data.approvedByUid, 0, 128) &&
        (data.closedAt == '' || validIsoTimestampString(data.closedAt)) &&
        validIsoTimestampString(data.clockInAt) &&
        validOptionalString(data, 'clockInByUid', 128) &&
        (data.clockOutAt == '' || validIsoTimestampString(data.clockOutAt)) &&
        validOptionalString(data, 'clockOutByUid', 128) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoDate(data.date) &&
        validNumber(data.durationHours, 0, 48) &&
        validString(data.guardEmail, 0, 254) &&
        validString(data.guardName, 1, 120) &&
        validString(data.guardPersonId, 1, 160) &&
        validString(data.guardUid, 1, 128) &&
        validNumber(data.mealAmount, 0, 1000000) &&
        data.mealEligible is bool &&
        (
          !data.keys().hasAny(['mealBookkeepingEntryId']) ||
          validString(data.mealBookkeepingEntryId, 0, 200)
        ) &&
        (
          !data.keys().hasAny(['mealBookkeepingStatus']) ||
          data.mealBookkeepingStatus in ['not_posted', 'posted']
        ) &&
        (
          !data.keys().hasAny(['mealPostedAt']) ||
          validString(data.mealPostedAt, 0, 40)
        ) &&
        (
          !data.keys().hasAny(['mealPostedByUid']) ||
          validString(data.mealPostedByUid, 0, 128)
        ) &&
        validString(data.note, 0, 1000) &&
        data.ownerActionRequired is bool &&
        validString(data.rejectedAt, 0, 40) &&
        validString(data.rejectedByName, 0, 120) &&
        validString(data.rejectedByUid, 0, 128) &&
        validString(data.rejectionReason, 0, 1000) &&
        data.source == 'guardAttendance' &&
        data.status in ['pending_approval', 'active', 'closed', 'rejected', 'void'] &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.voidedAt, 0, 40) &&
        validString(data.voidedByUid, 0, 128) &&
        validString(data.voidReason, 0, 1000);
    }

    function getCurrentGuardPersonId() {
      let account = getUserData();

      return (
        'guardId' in account &&
        account.guardId is string &&
        account.guardId.size() > 0
      )
        ? account.guardId
        : request.auth.uid;
    }
    function guardMealStartsUnposted(data) {
      return (
          !data.keys().hasAny(['mealBookkeepingStatus']) ||
          data.mealBookkeepingStatus == 'not_posted'
        ) &&
        (
          !data.keys().hasAny(['mealBookkeepingEntryId']) ||
          data.mealBookkeepingEntryId == ''
        ) &&
        (
          !data.keys().hasAny(['mealPostedAt']) ||
          data.mealPostedAt == ''
        ) &&
        (
          !data.keys().hasAny(['mealPostedByUid']) ||
          data.mealPostedByUid == ''
        );
    }

    function guardMealNotPosted(data) {
      return !data.keys().hasAny(['mealBookkeepingStatus']) ||
        data.mealBookkeepingStatus != 'posted';
    }

    function guardCreatesOwnAttendance(data, attendanceId) {
      return isStudioGuardAccount() &&
        attendanceId == 'att__' + request.auth.uid + '__' + data.date &&
        data.guardUid == request.auth.uid &&
        data.clockInByUid == request.auth.uid &&
        data.clockOutByUid == '' &&
        data.guardPersonId == getCurrentGuardPersonId() &&
        data.status == 'pending_approval' &&
        data.approvalStatus == 'pending' &&
        data.mealEligible == false &&
        guardMealStartsUnposted(data) &&
        data.ownerActionRequired == true &&
        data.approvedAt == '' &&
        data.approvedByUid == '' &&
        data.rejectedAt == '' &&
        data.rejectedByUid == '' &&
        data.voidedAt == '' &&
        data.voidedByUid == '';
    }

    function validGuardSelfCheckoutPatch() {
      return validIsoTimestampString(
          request.resource.data.clockOutAt
        ) &&
        validIsoTimestampString(
          request.resource.data.closedAt
        ) &&
        request.resource.data.closedAt ==
          request.resource.data.clockOutAt &&
        validString(
          request.resource.data.clockOutByUid,
          1,
          128
        ) &&
        validNumber(
          request.resource.data.durationHours,
          0,
          48
        ) &&
        validIsoTimestampString(
          request.resource.data.updatedAt
        );
    }

    function guardClosesOwnAttendance() {
      return isStudioGuardAccount() &&
        validGuardSelfCheckoutPatch() &&
        resource.data.guardUid == request.auth.uid &&
        request.resource.data.guardUid == resource.data.guardUid &&
        request.resource.data.guardPersonId == resource.data.guardPersonId &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        resource.data.clockOutAt == '' &&
        resource.data.status in ['active', 'pending_approval'] &&
        request.resource.data.status == 'closed' &&
        request.resource.data.clockOutAt != '' &&
        request.resource.data.closedAt == request.resource.data.clockOutAt &&
        request.resource.data.clockOutByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'clockOutAt',
          'clockOutByUid',
          'closedAt',
          'durationHours',
          'status',
          'updatedAt'
        ]);
    }

    function guardAttendanceCoreIdentityUnchanged() {
      return request.resource.data.id == resource.data.id &&
        request.resource.data.guardUid == resource.data.guardUid &&
        request.resource.data.guardPersonId == resource.data.guardPersonId &&
        request.resource.data.guardEmail == resource.data.guardEmail &&
        request.resource.data.guardName == resource.data.guardName &&
        request.resource.data.date == resource.data.date &&
        request.resource.data.clockInAt == resource.data.clockInAt &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.source == resource.data.source;
    }

    function adminApprovesGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        resource.data.status != 'void' &&
        resource.data.approvalStatus in ['pending', 'rejected'] &&
        request.resource.data.approvalStatus == 'approved' &&
        request.resource.data.approvedAt != '' &&
        request.resource.data.approvedByUid != '' &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.rejectedAt == '' &&
        request.resource.data.rejectedByUid == '' &&
        request.resource.data.rejectionReason == '' &&
        (
          (
            resource.data.clockOutAt == '' &&
            request.resource.data.status == 'active'
          ) ||
          (
            resource.data.clockOutAt != '' &&
            request.resource.data.status == 'closed'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'approvedAt',
          'approvedByName',
          'approvedByUid',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }

    function adminRejectsGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        resource.data.status != 'void' &&
        guardMealNotPosted(resource.data) &&
        resource.data.approvalStatus in ['pending', 'approved'] &&
        request.resource.data.approvalStatus == 'rejected' &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.rejectedAt != '' &&
        request.resource.data.rejectedByUid != '' &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'approvalStatus',
          'mealEligible',
          'ownerActionRequired',
          'rejectedAt',
          'rejectedByName',
          'rejectedByUid',
          'rejectionReason',
          'status',
          'updatedAt'
        ]);
    }

    function adminVoidsGuardAttendance() {
      return canManageGuardAttendance() &&
        guardAttendanceCoreIdentityUnchanged() &&
        resource.data.status != 'void' &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.mealEligible == false &&
        request.resource.data.ownerActionRequired == false &&
        request.resource.data.status == 'void' &&
        request.resource.data.voidedAt != '' &&
        request.resource.data.voidedByUid != '' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealEligible',
          'ownerActionRequired',
          'status',
          'updatedAt',
          'voidReason',
          'voidedAt',
          'voidedByUid'
        ]);
    }

    function guardMealBookkeepingExistsAfter() {
      let entryId =
        request.resource.data.mealBookkeepingEntryId;

      let entryPath =
        /databases/$(database)/documents/bookkeepingEntries/$(entryId);

      return entryId is string &&
        entryId.size() > 0 &&
        existsAfter(entryPath) &&
        getAfter(entryPath).data.id == entryId &&
        getAfter(entryPath).data.type == 'expense' &&
        getAfter(entryPath).data.source == 'guardAttendanceMeal' &&
        getAfter(entryPath).data.sourceAttendanceId == resource.data.id &&
        getAfter(entryPath).data.sourceAttendanceDate == resource.data.date &&
        getAfter(entryPath).data.sourceGuardPersonId == resource.data.guardPersonId &&
        getAfter(entryPath).data.amount == resource.data.mealAmount;
    }

    function adminPostsGuardMeal() {
      return isApprovedAdmin() &&
        (
          hasPermission('operator-fee') ||
          canManageGuardAttendance()
        ) &&
        guardAttendanceCoreIdentityUnchanged() &&
        resource.data.approvalStatus == 'approved' &&
        resource.data.status == 'closed' &&
        resource.data.mealEligible == true &&
        resource.data.mealAmount > 0 &&
        guardMealNotPosted(resource.data) &&
        request.resource.data.approvalStatus == resource.data.approvalStatus &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.mealEligible == resource.data.mealEligible &&
        request.resource.data.mealBookkeepingStatus == 'posted' &&
        request.resource.data.mealBookkeepingEntryId != '' &&
        request.resource.data.mealPostedAt != '' &&
        request.resource.data.mealPostedByUid == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'mealBookkeepingEntryId',
          'mealBookkeepingStatus',
          'mealPostedAt',
          'mealPostedByUid',
          'updatedAt'
        ]) &&
        guardMealBookkeepingExistsAfter();
    }

    function adminUpdatesGuardAttendance() {
      return adminApprovesGuardAttendance() ||
        adminRejectsGuardAttendance() ||
        adminVoidsGuardAttendance() ||
        adminPostsGuardMeal();
    }

    match /guardAttendanceSessions/{attendanceId} {
      allow read: if
        canManageGuardAttendance() ||
        canManageOperatorFees() ||
        (
          isStudioGuardAccount() &&
          resource.data.guardUid == request.auth.uid
        );

      allow create: if validGuardAttendanceSession(request.resource.data, attendanceId) &&
        guardCreatesOwnAttendance(
          request.resource.data,
          attendanceId
        );

      allow update: if guardClosesOwnAttendance() || (
        validGuardAttendanceSession(
          request.resource.data,
          attendanceId
        ) &&
        adminUpdatesGuardAttendance()
      );

      allow delete: if isOwner();
    }
    // <<< STUDIO37 GUARD ATTENDANCE RULES END

match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isOwner());
      allow create: if isSignedIn() &&
        request.auth.uid == userId &&
        validUser(request.resource.data, userId) &&
        authIdentityMatches(request.resource.data) &&
        isSafeAccountSelfCreate(request.resource.data);
      allow update: if validUser(request.resource.data, userId) && (
        isOwner() || (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'preferences', 'updatedAt'])
        ) || isSafeAdminRequestToClientTransition(userId)
      );
      allow delete: if isOwner();
    }

    function isClientBookingOwner(data) {
      return isClientAccount() && (
        (data.clientUid is string && data.clientUid == request.auth.uid) ||
        (
          'email' in request.auth.token &&
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) ||
        (
          'phone_number' in request.auth.token &&
          request.auth.token.phone_number is string &&
          (
            (data.phone is string && (
              data.phone == request.auth.token.phone_number ||
              ('+' + data.phone) == request.auth.token.phone_number
            )) ||
            (data.customerPhoneKey is string && (
              data.customerPhoneKey == request.auth.token.phone_number ||
              ('+' + data.customerPhoneKey) == request.auth.token.phone_number
            ))
          )
        )
      );
    }

    function validBooking(data) {
      return validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.total, 0, 100000000) &&
        data.paymentStatus in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        data.status in ['pending', 'dp', 'lunas', 'refunded', 'void', 'cancelled', 'canceled', 'deleted'] &&
        validOptionalString(data, 'email', 254) &&
        validOptionalString(data, 'clientUid', 128) &&
        validOptionalString(data, 'title', 160) &&
        validOptionalString(data, 'sessionLabel', 160) &&
        validOptionalString(data, 'clientRequestNote', 600) &&
        validOptionalString(data, 'clientRequestUpdatedAt', 40) &&
        validOptionalString(data, 'adminResponseNote', 600) &&
        validOptionalString(data, 'adminResponseAt', 40) &&
        validOptionalString(data, 'lastMessageId', 128) &&
        validOptionalString(data, 'lastMessageAt', 40) &&
        validOptionalString(data, 'lastMessagePreview', 180) &&
        (!data.keys().hasAny(['bookingRequestStatus']) || data.bookingRequestStatus in ['submitted', 'confirmed', 'rejected', 'cancellation_requested', 'cancelled']) &&
        (!data.keys().hasAny(['lastMessageSenderRole']) || data.lastMessageSenderRole in ['admin', 'client']) &&
        (!data.keys().hasAny(['lastMessageReadByAdmin']) || data.lastMessageReadByAdmin is bool) &&
        (!data.keys().hasAny(['lastMessageReadByClient']) || data.lastMessageReadByClient is bool) &&
        (!data.keys().hasAny(['paymentHistory']) || (data.paymentHistory is list && data.paymentHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundHistory']) || (data.refundHistory is list && data.refundHistory.size() <= 100)) &&
        (!data.keys().hasAny(['refundedAmount']) || validNumber(data.refundedAmount, 0, 100000000)) &&
        (!data.keys().hasAny(['refundStatus']) || data.refundStatus in ['partial', 'full']) &&
        validOptionalString(data, 'lastRefundAt', 40) &&
        validOptionalString(data, 'lastRefundMethod', 40) &&
        validOptionalString(data, 'lastRefundReason', 600) &&
        validOptionalString(data, 'refundCompletedAt', 40) &&
        validOptionalString(data, 'paymentStatusBeforeRefund', 40) &&
        (!data.keys().hasAny(['appliedDiscounts']) || (data.appliedDiscounts is list && data.appliedDiscounts.size() <= 50));
    }

    function validClientMessageSummary(data) {
      return validString(data.lastMessageId, 1, 128) &&
        validIsoTimestampString(data.lastMessageAt) &&
        validString(data.lastMessagePreview, 1, 180) &&
        data.lastMessageSenderRole == 'client' &&
        data.lastMessageReadByAdmin == false &&
        data.lastMessageReadByClient == true;
    }

    function clientMessageExistsAfter(bookingId) {
      let messageId = request.resource.data.lastMessageId;
      let messagePath = /databases/$(database)/documents/bookingMessages/$(messageId);
      return existsAfter(messagePath) &&
        getAfter(messagePath).data.bookingId == bookingId &&
        getAfter(messagePath).data.clientUid == request.auth.uid &&
        getAfter(messagePath).data.senderUid == request.auth.uid &&
        getAfter(messagePath).data.senderRole == 'client';
    }

    function clientSendsBookingMessage(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId);
    }

    function clientRequestsBookingCancellation(bookingId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'bookingRequestStatus', 'clientRequestNote', 'clientRequestUpdatedAt',
          'lastMessageId', 'lastMessageAt', 'lastMessagePreview',
          'lastMessageSenderRole', 'lastMessageReadByAdmin', 'lastMessageReadByClient'
        ]) &&
        resource.data.bookingRequestStatus in ['submitted', 'confirmed'] &&
        request.resource.data.bookingRequestStatus == 'cancellation_requested' &&
        validString(request.resource.data.clientRequestNote, 1, 600) &&
        validIsoTimestampString(request.resource.data.clientRequestUpdatedAt) &&
        validClientMessageSummary(request.resource.data) &&
        clientMessageExistsAfter(bookingId) &&
        getAfter(/databases/$(database)/documents/bookingMessages/$(request.resource.data.lastMessageId)).data.type == 'cancellation';
    }

    function clientMarksLatestMessageRead() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageReadByClient']) &&
        resource.data.lastMessageSenderRole == 'admin' &&
        request.resource.data.lastMessageReadByClient == true;
    }

    function clientCreateIdentityMatches(data) {
      return isSignedIn() &&
        data.clientUid is string &&
        data.clientUid == request.auth.uid &&
        data.customerId is string &&
        data.customerId == ('auth_' + request.auth.uid) &&
        (
          !data.keys().hasAny(['email']) ||
          data.email == '' ||
          (
            request.auth.token.email is string &&
            data.email is string &&
            data.email.lower() == request.auth.token.email.lower()
          )
        );
    }

    function isSafeClientBookingRequestCreate(data, documentId) {
      return data.id == documentId &&
        clientCreateIdentityMatches(data) &&
        data.source == 'clientPortal' &&
        data.bookingRequestStatus == 'submitted' &&
        data.paymentStatus == 'pending' &&
        data.status == 'pending' &&
        validString(data.customer, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.customerPhoneKey, 0, 32) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.customerId, 1, 160) &&
        validString(data.bookingId, 1, 120) &&
        validString(data.bookingCode, 1, 120) &&
        validString(data.invoiceNumber, 1, 120) &&
        validString(data.title, 1, 160) &&
        validString(data.sessionLabel, 1, 160) &&
        validIsoDate(data.date) &&
        validNumber(data.startHour, 0, 23) &&
        validNumber(data.durationHours, 0, 24) &&
        validNumber(data.subtotal, 0, 100000000) &&
        validNumber(data.discountAmount, 0, 100000000) &&
        validNumber(data.total, 0, 100000000) &&
        data.invoiceAmount == data.total &&
        data.paidAmount == 0 &&
        data.dpAmount == 0 &&
        data.paymentHistory is list &&
        data.paymentHistory.size() == 0 &&
        (!data.keys().hasAny(['appliedDiscounts']) || data.appliedDiscounts is list) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        (
          !data.keys().hasAny(['clientRequestUpdatedAt']) ||
          validIsoTimestampString(data.clientRequestUpdatedAt)
        );
    }

    match /bookings/{bookingId} {
      allow read: if (isApproved() && canAccessBookingData()) || isClientBookingOwner(resource.data);
      allow create: if (
          isApproved() && canAccessBookingData() && validBooking(request.resource.data)
        ) || (
          isSignedIn() &&
          isSafeClientBookingRequestCreate(request.resource.data, bookingId)
        );
      allow update: if validBooking(request.resource.data) && (
        (isApproved() && canAccessBookingData()) ||
        (
          isClientBookingOwner(resource.data) &&
          request.resource.data.clientUid == resource.data.clientUid &&
          (
            clientSendsBookingMessage(bookingId) ||
            clientRequestsBookingCancellation(bookingId) ||
            clientMarksLatestMessageRead()
          )
        )
      );
      allow delete: if isApproved() && canAccessBookingData();
    }

    function validPaymentProof(data, proofId) {
      return data.keys().hasOnly([
          'id', 'bookingId', 'bookingCode', 'invoiceNumber',
          'clientUid', 'customer', 'category', 'amount', 'method',
          'status', 'proofUrl', 'proofPublicId', 'proofFileName',
          'proofMimeType', 'clientNote', 'adminNote', 'createdAt',
          'updatedAt', 'reviewedAt', 'reviewedByUid', 'reviewedByName'
        ]) &&
        data.id == proofId &&
        validString(data.bookingId, 1, 128) &&
        validString(data.bookingCode, 0, 120) &&
        validString(data.invoiceNumber, 0, 120) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.customer, 1, 120) &&
        data.category in ['dp', 'pelunasan'] &&
        validNumber(data.amount, 1, 100000000) &&
        data.method in ['transfer', 'qris'] &&
        data.status in ['pending', 'approved', 'rejected'] &&
        validString(data.proofUrl, 1, 1200) &&
        validString(data.proofPublicId, 1, 240) &&
        validString(data.proofFileName, 0, 240) &&
        validString(data.proofMimeType, 0, 120) &&
        validString(data.clientNote, 0, 600) &&
        validString(data.adminNote, 0, 600) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOptionalString(data, 'reviewedAt', 40) &&
        validOptionalString(data, 'reviewedByUid', 128) &&
        validOptionalString(data, 'reviewedByName', 120);
    }

    function clientCreatesPaymentProof(data, proofId) {
      return isSignedIn() &&
        validPaymentProof(data, proofId) &&
        data.clientUid == request.auth.uid &&
        data.status == 'pending' &&
        data.adminNote == '' &&
        data.reviewedAt == '' &&
        data.reviewedByUid == '' &&
        data.reviewedByName == '' &&
        bookingExists(data.bookingId) &&
        bookingData(data.bookingId).clientUid == request.auth.uid &&
        bookingData(data.bookingId).status != 'void' &&
        bookingData(data.bookingId).paymentStatus != 'void';
    }

    function adminReviewsPaymentProof() {
      return validPaymentProof(request.resource.data, resource.id) &&
        resource.data.status == 'pending' &&
        request.resource.data.status in ['approved', 'rejected'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'adminNote', 'reviewedAt', 'reviewedByUid', 'reviewedByName', 'updatedAt'
        ]) &&
        request.resource.data.reviewedByUid == request.auth.uid &&
        validIsoTimestampString(request.resource.data.reviewedAt);
    }

    function validBookingMessage(data, messageId) {
      return data.keys().hasOnly([
          'id', 'bookingId', 'clientUid', 'senderUid', 'senderRole',
          'senderName', 'text', 'type', 'createdAt', 'readByAdmin', 'readByClient'
        ]) &&
        data.id == messageId &&
        validString(data.bookingId, 1, 128) &&
        validString(data.clientUid, 1, 128) &&
        validString(data.senderUid, 1, 128) &&
        data.senderRole in ['admin', 'client'] &&
        validString(data.senderName, 1, 120) &&
        validString(data.text, 1, 600) &&
        data.type in ['message', 'status', 'cancellation'] &&
        validIsoTimestampString(data.createdAt) &&
        data.readByAdmin is bool &&
        data.readByClient is bool;
    }

    function bookingExists(bookingId) {
      return exists(/databases/$(database)/documents/bookings/$(bookingId));
    }

    function bookingData(bookingId) {
      return get(/databases/$(database)/documents/bookings/$(bookingId)).data;
    }

    match /paymentProofs/{proofId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if clientCreatesPaymentProof(request.resource.data, proofId);
      allow update: if isApproved() && canAccessBookingData() && adminReviewsPaymentProof();
      allow delete: if isOwner();
    }

    match /bookingMessages/{messageId} {
      allow read: if (isApproved() && canAccessBookingData()) ||
        (isClientAccount() && resource.data.clientUid == request.auth.uid);
      allow create: if validBookingMessage(request.resource.data, messageId) &&
        bookingExists(request.resource.data.bookingId) && (
          (
            isApproved() &&
            canAccessBookingData() &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.senderRole == 'admin' &&
            request.resource.data.clientUid == bookingData(request.resource.data.bookingId).clientUid &&
            request.resource.data.readByAdmin == true &&
            request.resource.data.readByClient == false
          ) ||
          (
            isClientAccount() &&
            request.resource.data.clientUid == request.auth.uid &&
            request.resource.data.senderUid == request.auth.uid &&
            request.resource.data.senderRole == 'client' &&
            bookingData(request.resource.data.bookingId).clientUid == request.auth.uid &&
            request.resource.data.readByAdmin == false &&
            request.resource.data.readByClient == true &&
            request.resource.data.type in ['message', 'cancellation']
          )
        );
      allow update: if validBookingMessage(request.resource.data, messageId) && (
        (
          isApproved() &&
          canAccessBookingData() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByAdmin']) &&
          request.resource.data.readByAdmin == true
        ) ||
        (
          isClientAccount() &&
          resource.data.clientUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readByClient']) &&
          request.resource.data.readByClient == true
        )
      );
      allow delete: if isOwner();
    }

    function validCalendarSlot(data) {
      return data.keys().hasOnly(['bookingId', 'date', 'durationHours', 'sessionLabel', 'startHour', 'status', 'title', 'updatedAt']) &&
        validString(data.bookingId, 1, 160) &&
        validIsoDate(data.date) &&
        validNumber(data.durationHours, 0.5, 24) &&
        validNumber(data.startHour, 0, 23) &&
        data.status in ['pending', 'dp', 'lunas'] &&
        validString(data.sessionLabel, 1, 160) &&
        validString(data.title, 1, 80) &&
        validIsoTimestampString(data.updatedAt);
    }

    match /clientCalendarSlots/{slotId} {
      // Public availability mirror only contains generic occupied-slot metadata.
      // Customer identity, contact, payment proof, and private booking data stay in protected collections.
      allow read: if true;
      allow create, update: if isApproved() && canAccessBookingData() && validCalendarSlot(request.resource.data);
      allow delete: if isApproved() && canAccessBookingData();
    }

    function validCustomer(data, customerId) {
      return data.keys().hasOnly([
          'id', 'authUid', 'name', 'phone', 'phoneKey', 'email', 'instagram',
          'notes', 'followUpStatus', 'source', 'createdAt', 'updatedAt'
        ]) &&
        data.id == customerId &&
        validString(data.name, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.phoneKey, 0, 32) &&
        validString(data.email, 0, 254) &&
        validString(data.instagram, 0, 80) &&
        validString(data.notes, 0, 2000) &&
        data.followUpStatus in ['normal', 'follow-up', 'vip', 'watchlist'] &&
        validOptionalString(data, 'source', 40) &&
        validOptionalString(data, 'authUid', 128) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function isOwnClientProfile(customerId, data) {
      return isClientAccount() &&
        customerId == ('auth_' + request.auth.uid) &&
        data.authUid == request.auth.uid &&
        data.source == 'clientPortal';
    }

    function clientProfileIdentityMatches(data) {
      return (
          request.auth.token.email is string &&
          data.email is string &&
          data.email.lower() == request.auth.token.email.lower()
        ) || (
          request.auth.token.phone_number is string &&
          data.phone is string &&
          data.phone == request.auth.token.phone_number
        );
    }

    match /customers/{customerId} {
      allow read: if (isApproved() && canAccessCustomerData()) ||
        (isClientAccount() && customerId == ('auth_' + request.auth.uid));
      allow create: if validCustomer(request.resource.data, customerId) && (
        (isApproved() && canAccessCustomerData()) ||
        (
          isOwnClientProfile(customerId, request.resource.data) &&
          clientProfileIdentityMatches(request.resource.data) &&
          request.resource.data.followUpStatus == 'normal'
        )
      );
      allow update: if validCustomer(request.resource.data, customerId) && (
        (isApproved() && canAccessCustomerData()) ||
        (
          isOwnClientProfile(customerId, request.resource.data) &&
          clientProfileIdentityMatches(request.resource.data) &&
          resource.data.authUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['name', 'phone', 'phoneKey', 'email', 'updatedAt'])
        )
      );
      allow delete: if isApproved() && canAccessCustomerData();
    }

    function validStudioSettings(data) {
      return data.keys().hasOnly([
          'studioName', 'studioAddress', 'studioPhone',
          'bankName', 'bankAccountNumber', 'bankAccountHolder',
          'qrisLabel', 'qrisNote', 'paymentTerms', 'updatedAt'
        ]) &&
        validString(data.studioName, 1, 120) &&
        validString(data.studioAddress, 0, 500) &&
        validString(data.studioPhone, 0, 32) &&
        validString(data.bankName, 1, 80) &&
        validString(data.bankAccountNumber, 1, 80) &&
        validString(data.bankAccountHolder, 1, 120) &&
        validString(data.qrisLabel, 0, 160) &&
        validString(data.qrisNote, 0, 240) &&
        data.paymentTerms is list &&
        data.paymentTerms.size() <= 12 &&
        validOptionalString(data, 'updatedAt', 40);
    }

    function validPricingSettings(data) {
      return data.keys().hasOnly(['sessions', 'discounts', 'recordingTypes', 'packages']) &&
        data.sessions is list && data.sessions.size() > 0 && data.sessions.size() <= 50 &&
        data.discounts is list && data.discounts.size() <= 100 &&
        data.recordingTypes is list && data.recordingTypes.size() <= 50 &&
        data.packages is list && data.packages.size() <= 100;
    }

    function validInvoiceSettings(data) {
      return data.keys().hasOnly(['studioName', 'subtitle', 'phone', 'address', 'footer', 'paperSize', 'updatedAt']) &&
        validString(data.studioName, 1, 120) &&
        validString(data.subtitle, 1, 120) &&
        validString(data.phone, 0, 32) &&
        validString(data.address, 0, 500) &&
        validString(data.footer, 1, 500) &&
        data.paperSize in ['80mm', '58mm'] &&
        validOptionalString(data, 'updatedAt', 40);
    }

    match /settings/studio {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validStudioSettings(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/pricing {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validPricingSettings(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/invoice {
      allow read: if true;
      allow create, update: if isApprovedAdmin() && hasPermission('settings') && validInvoiceSettings(request.resource.data);
      allow delete: if isOwner();
    }

    match /settings/{settingId} {
      allow read, write: if settingId != 'operatorFees' && isApprovedAdmin() && hasPermission('settings');
    }

    // >>> STUDIO37 OPERATOR FEE RULES START
    match /settings/operatorFees {
      allow read: if isApproved();
      allow create, update, delete: if isOwner();
    }

    function validOperatorFeeEntry(
      data,
      entryId
    ) {
      return data.keys().hasOnly([
          'id',
          'amount',
          'bookingCode',
          'bookingDate',
          'bookingId',
          'calculationMode',
          'durationHours',
          'mealAmount',
          'note',
          'overtimeAmount',
          'payeeRole',
          'paymentMethod',
          'personId',
          'personName',
          'postedAt',
          'postedBookkeepingEntryId',
          'postedByUid',
          'ruleId',
          'ruleName',
          'serviceLabel',
          'sourcePricingId',
          'sourcePricingLabel',
          'sourcePricingType',
          'status',
          'title',
          'totalAmount',
          'createdAt',
          'updatedAt'
        ]) &&
        data.id == entryId &&
        validNumber(data.amount, 0, 1000000000) &&
        validString(data.bookingCode, 0, 160) &&
        validString(data.bookingDate, 0, 40) &&
        validString(data.bookingId, 0, 160) &&
        validString(data.calculationMode, 1, 80) &&
        validNumber(data.durationHours, 0, 1000) &&
        validNumber(data.mealAmount, 0, 1000000000) &&
        validString(data.note, 0, 2000) &&
        validNumber(data.overtimeAmount, 0, 1000000000) &&
        data.payeeRole in ['guard', 'recording_operator'] &&
        validString(data.paymentMethod, 1, 80) &&
        validString(data.personId, 0, 160) &&
        validString(data.personName, 1, 160) &&
        validString(data.postedAt, 0, 40) &&
        validString(data.postedBookkeepingEntryId, 0, 240) &&
        validString(data.postedByUid, 0, 128) &&
        validString(data.ruleId, 0, 240) &&
        validString(data.ruleName, 1, 240) &&
        validString(data.serviceLabel, 0, 240) &&
        validString(data.sourcePricingId, 0, 240) &&
        validString(data.sourcePricingLabel, 0, 240) &&
        validString(data.sourcePricingType, 0, 80) &&
        data.status in ['draft', 'reviewed', 'posted', 'void'] &&
        validString(data.title, 1, 240) &&
        validNumber(data.totalAmount, 0, 1000000000) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function operatorFeePostedFieldsAreClear(
      data
    ) {
      return data.postedAt == '' &&
        data.postedBookkeepingEntryId == '' &&
        data.postedByUid == '';
    }

    function operatorFeeCreatesNonPosted(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        request.resource.data.status in [
          'draft',
          'reviewed'
        ] &&
        operatorFeePostedFieldsAreClear(
          request.resource.data
        );
    }

    function operatorFeeUpdatesNonPosted(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        resource.data.status != 'posted' &&
        request.resource.data.status in [
          'draft',
          'reviewed',
          'void'
        ] &&
        operatorFeePostedFieldsAreClear(
          request.resource.data
        );
    }

    function operatorFeeBookkeepingExistsAfter(
      entryId
    ) {
      let bookkeepingId =
        request.resource.data.postedBookkeepingEntryId;

      let bookkeepingPath =
        /databases/$(database)/documents/bookkeepingEntries/$(bookkeepingId);

      return bookkeepingId is string &&
        bookkeepingId.size() > 0 &&
        existsAfter(bookkeepingPath) &&
        getAfter(bookkeepingPath).data.id ==
          bookkeepingId &&
        getAfter(bookkeepingPath).data.type ==
          'expense' &&
        getAfter(bookkeepingPath).data.source ==
          'operatorFee' &&
        getAfter(bookkeepingPath).data.sourceFeeEntryId ==
          entryId &&
        getAfter(bookkeepingPath).data.sourceBookingId ==
          resource.data.bookingId &&
        getAfter(bookkeepingPath).data.amount ==
          resource.data.totalAmount;
    }

    function adminPostsOperatorFee(
      entryId
    ) {
      return canManageOperatorFees() &&
        validOperatorFeeEntry(
          request.resource.data,
          entryId
        ) &&
        resource.data.status == 'reviewed' &&
        request.resource.data.status == 'posted' &&
        request.resource.data.postedAt != '' &&
        request.resource.data.postedBookkeepingEntryId != '' &&
        request.resource.data.postedByUid ==
          request.auth.uid &&
        request.resource.data
          .diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'postedAt',
            'postedBookkeepingEntryId',
            'postedByUid',
            'status',
            'updatedAt'
          ]) &&
        operatorFeeBookkeepingExistsAfter(
          entryId
        );
    }

    match /operatorFeeEntries/{entryId} {
      allow read: if canManageOperatorFees();

      allow create:
        if operatorFeeCreatesNonPosted(
          entryId
        );

      allow update:
        if operatorFeeUpdatesNonPosted(
          entryId
        ) ||
        adminPostsOperatorFee(
          entryId
        );

      allow delete:
        if canManageOperatorFees() &&
        resource.data.status != 'posted';
    }
    // <<< STUDIO37 OPERATOR FEE RULES END

    function validOperatorFeeBookkeepingSource(data) {
      return data.source != 'operatorFee' || (
        data.keys().hasAll([
          'sourceBookingId',
          'sourceFeeEntryId'
        ]) &&
        validString(
          data.sourceBookingId,
          1,
          160
        ) &&
        validString(
          data.sourceFeeEntryId,
          1,
          240
        )
      );
    }

    function validGuardMealBookkeepingSource(data) {
      return data.source != 'guardAttendanceMeal' || (
        data.keys().hasAll([
          'sourceAttendanceId',
          'sourceAttendanceDate',
          'sourceGuardPersonId'
        ]) &&
        validString(data.sourceAttendanceId, 1, 160) &&
        validIsoDate(data.sourceAttendanceDate) &&
        validString(data.sourceGuardPersonId, 1, 160)
      );
    }

    function validBookkeepingEntry(data, entryId) {
      return data.keys().hasOnly([
          'id', 'type', 'category', 'title', 'amount', 'date',
          'paymentMethod', 'note', 'source',
          'sourceAttendanceId', 'sourceAttendanceDate',
          'sourceGuardPersonId', 'sourceBookingId',
          'sourceFeeEntryId', 'createdAt', 'updatedAt'
        ]) &&
        data.id == entryId &&
        data.type in ['income', 'expense'] &&
        validString(data.category, 1, 80) &&
        validString(data.title, 1, 160) &&
        validNumber(data.amount, 0, 1000000000) &&
        validIsoDate(data.date) &&
        validString(data.paymentMethod, 1, 80) &&
        validString(data.note, 0, 2000) &&
        validOptionalString(data, 'source', 80) &&
        validOptionalString(data, 'sourceAttendanceId', 160) &&
        validOptionalString(data, 'sourceAttendanceDate', 40) &&
        validOptionalString(data, 'sourceGuardPersonId', 160) &&
        validOptionalString(data, 'sourceBookingId', 160) &&
        validOptionalString(data, 'sourceFeeEntryId', 240) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt) &&
        validOperatorFeeBookkeepingSource(data) &&
        validGuardMealBookkeepingSource(data);
    }

    function isReconciledBookkeepingSource(
      data
    ) {
      return data.source in [
        'operatorFee',
        'guardAttendanceMeal'
      ];
    }

    function operatorFeeBookkeepingBecomesPostedAfter(
      data
    ) {
      let feeEntryId =
        data.sourceFeeEntryId;

      let feePath =
        /databases/$(database)/documents/operatorFeeEntries/$(feeEntryId);

      return data.source != 'operatorFee' || (
        feeEntryId is string &&
        feeEntryId.size() > 0 &&
        existsAfter(feePath) &&
        getAfter(feePath).data.status ==
          'posted' &&
        getAfter(feePath).data.postedBookkeepingEntryId ==
          data.id &&
        getAfter(feePath).data.bookingId ==
          data.sourceBookingId &&
        getAfter(feePath).data.totalAmount ==
          data.amount &&
        (
          !exists(feePath) ||
          get(feePath).data.status !=
            'posted'
        )
      );
    }

    function guardMealBookkeepingBecomesPostedAfter(
      data
    ) {
      let attendanceId =
        data.sourceAttendanceId;

      let attendancePath =
        /databases/$(database)/documents/guardAttendanceSessions/$(attendanceId);

      return data.source != 'guardAttendanceMeal' || (
        attendanceId is string &&
        attendanceId.size() > 0 &&
        existsAfter(attendancePath) &&
        getAfter(attendancePath).data.mealBookkeepingStatus ==
          'posted' &&
        getAfter(attendancePath).data.mealBookkeepingEntryId ==
          data.id &&
        getAfter(attendancePath).data.date ==
          data.sourceAttendanceDate &&
        getAfter(attendancePath).data.guardPersonId ==
          data.sourceGuardPersonId &&
        getAfter(attendancePath).data.mealAmount ==
          data.amount &&
        (
          !exists(attendancePath) ||
          !(
            'mealBookkeepingStatus' in
            get(attendancePath).data
          ) ||
          get(attendancePath).data.mealBookkeepingStatus !=
            'posted'
        )
      );
    }

    function reconciledBookkeepingWriteAllowed(
      data
    ) {
      return operatorFeeBookkeepingBecomesPostedAfter(
          data
        ) &&
        guardMealBookkeepingBecomesPostedAfter(
          data
        );
    }

    match /bookkeepingEntries/{entryId} {
      allow read:
        if isApproved() &&
        canAccessBookkeepingData();

      allow create:
        if isApprovedAdmin() &&
        (
          canAccessBookkeepingData() ||
          hasPermission('operator-fee')
        ) &&
        validBookkeepingEntry(
          request.resource.data,
          entryId
        ) &&
        reconciledBookkeepingWriteAllowed(
          request.resource.data
        );

      allow update:
        if isApprovedAdmin() &&
        (
          canAccessBookkeepingData() ||
          hasPermission('operator-fee')
        ) &&
        validBookkeepingEntry(
          request.resource.data,
          entryId
        ) &&
        (
          (
            !isReconciledBookkeepingSource(
              resource.data
            ) &&
            !isReconciledBookkeepingSource(
              request.resource.data
            )
          ) ||
          (
            resource.data.source ==
              request.resource.data.source &&
            reconciledBookkeepingWriteAllowed(
              request.resource.data
            )
          )
        );

      allow delete:
        if isApprovedAdmin() &&
        canAccessBookkeepingData() &&
        !isReconciledBookkeepingSource(
          resource.data
        );
    }

    function validInventoryItem(data, itemId) {
      return data.keys().hasOnly(['id', 'name', 'category', 'type', 'quantity', 'unit', 'minStock', 'condition', 'status', 'location', 'note', 'createdAt', 'updatedAt']) &&
        data.id == itemId &&
        validString(data.name, 1, 160) &&
        validString(data.category, 1, 80) &&
        validString(data.type, 1, 40) &&
        validNumber(data.quantity, 0, 1000000) &&
        validString(data.unit, 1, 40) &&
        validNumber(data.minStock, 0, 1000000) &&
        validString(data.condition, 1, 40) &&
        validString(data.status, 1, 40) &&
        validString(data.location, 0, 240) &&
        validString(data.note, 0, 2000) &&
        validIsoTimestampString(data.createdAt) &&
        validIsoTimestampString(data.updatedAt);
    }

    function validInventoryMovement(data, movementId) {
      return data.keys().hasOnly(['id', 'itemId', 'itemName', 'type', 'quantity', 'previousQuantity', 'nextQuantity', 'unit', 'note', 'createdAt']) &&
        data.id == movementId &&
        validString(data.itemId, 0, 160) &&
        validString(data.itemName, 1, 160) &&
        validString(data.type, 1, 40) &&
        validNumber(data.quantity, 0, 1000000) &&
        validNumber(data.previousQuantity, 0, 1000000) &&
        validNumber(data.nextQuantity, 0, 1000000) &&
        validString(data.unit, 1, 40) &&
        validString(data.note, 0, 2000) &&
        validIsoTimestampString(data.createdAt);
    }

    match /inventoryItems/{itemId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create, update: if isApproved() && canAccessInventoryData() && validInventoryItem(request.resource.data, itemId);
      allow delete: if isApproved() && canAccessInventoryData();
    }

    match /inventoryMovements/{movementId} {
      allow read: if isApproved() && canAccessInventoryData();
      allow create: if isApproved() && canAccessInventoryData() && validInventoryMovement(request.resource.data, movementId);
      allow update: if false;
      allow delete: if isOwner();
    }

    function validGalleryItem(data) {
      return data.keys().hasOnly(['title', 'description', 'url', 'publicId', 'category', 'isFavorite', 'isDeleted', 'uploadedBy', 'createdAt', 'deletedAt']) &&
        validString(data.title, 1, 180) &&
        validString(data.description, 0, 2000) &&
        validString(data.url, 8, 2000) &&
        validString(data.publicId, 1, 500) &&
        validString(data.category, 1, 80) &&
        data.isFavorite is bool &&
        data.isDeleted is bool &&
        validString(data.uploadedBy, 1, 120) &&
        validIsoTimestampString(data.createdAt) &&
        (!data.keys().hasAny(['deletedAt']) || data.deletedAt == null || validIsoTimestampString(data.deletedAt));
    }

    match /gallery/{imageId} {
      allow read: if isApproved() && hasPermission('gallery');
      allow create, update: if isApproved() && hasPermission('gallery') && validGalleryItem(request.resource.data);
      allow delete: if isApproved() && hasPermission('gallery');
    }

    function validApprovalMail(data) {
      return data.keys().hasOnly(['createdBy', 'type', 'createdAt', 'to', 'message']) &&
        data.createdBy == request.auth.uid &&
        data.type == 'adminApprovalRequest' &&
        data.to == 'marsicprod@gmail.com' &&
        validIsoTimestampString(data.createdAt) &&
        data.message is map &&
        data.message.keys().hasOnly(['subject', 'html']) &&
        validString(data.message.subject, 1, 240) &&
        validString(data.message.html, 1, 20000);
    }

    // >>> STUDIO37 NOTIFICATION EVENT RULES START
    function validNotificationEvent(data, eventId) {
      return data.keys().hasOnly([
          'actorEmail', 'actorRole', 'actorUid', 'attempts',
          'bookingId', 'channel', 'createdAt', 'errorMessage',
          'id', 'message', 'metadata', 'paymentProofId',
          'priority', 'provider', 'sentAt', 'source', 'status',
          'targetMode', 'targetRole', 'targetUid', 'title',
          'type', 'updatedAt', 'url'
        ]) &&
        data.id == eventId &&
        data.actorRole in ['admin', 'client', 'guard', 'system'] &&
        validString(data.actorUid, 1, 128) &&
        validString(data.actorEmail, 0, 254) &&
        validNumber(data.attempts, 0, 20) &&
        validString(data.bookingId, 0, 160) &&
        data.channel == 'push' &&
        validIsoTimestampString(data.createdAt) &&
        validString(data.errorMessage, 0, 1000) &&
        validString(data.message, 1, 600) &&
        data.metadata is map &&
        validString(data.paymentProofId, 0, 160) &&
        data.priority in ['low', 'normal', 'high'] &&
        data.provider == 'onesignal' &&
        validOptionalString(data, 'sentAt', 40) &&
        validString(data.source, 1, 80) &&
        data.status in ['pending', 'processing', 'sent', 'failed', 'cancelled'] &&
        data.targetMode in ['role', 'user'] &&
        data.targetRole in ['admin', 'client', 'none'] &&
        validString(data.targetUid, 0, 128) &&
        validString(data.title, 1, 180) &&
        data.type in [
          'booking_confirmed',
          'booking_message_created',
          'booking_rejected',
          'booking_request_created',
          'guard_attendance_submitted',
          'payment_proof_approved',
          'payment_proof_rejected',
          'payment_proof_submitted'
        ] &&
        validIsoTimestampString(data.updatedAt) &&
        validString(data.url, 0, 700);
    }

    function notificationEventActorMatches(data) {
      return data.actorUid == request.auth.uid &&
        (
          (data.actorRole == 'client' && isClientAccount()) ||
          (data.actorRole == 'admin' && isApprovedAdmin()) ||
          (data.actorRole == 'guard' && isStudioGuardAccount())
        );
    }

    function notificationEventCreateIsPending(data) {
      return data.status == 'pending' &&
        data.attempts == 0 &&
        data.errorMessage == '' &&
        data.sentAt == '';
    }

    function notificationEventTargetIsSafe(data) {
      return (
          data.targetMode == 'role' &&
          data.targetRole == 'admin' &&
          data.targetUid == ''
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'client' &&
          data.targetUid.size() > 0
        ) || (
          data.targetMode == 'user' &&
          data.targetRole == 'admin' &&
          data.targetUid.size() > 0
        );
    }

    match /notificationEvents/{eventId} {
      allow read: if isSignedIn() && (
        isApprovedAdmin() ||
        resource.data.actorUid == request.auth.uid ||
        resource.data.targetUid == request.auth.uid
      );

      allow create: if isSignedIn() &&
        validNotificationEvent(request.resource.data, eventId) &&
        notificationEventActorMatches(request.resource.data) &&
        notificationEventCreateIsPending(request.resource.data) &&
        notificationEventTargetIsSafe(request.resource.data);

      allow update: if isApprovedAdmin() &&
        validNotificationEvent(request.resource.data, eventId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'attempts', 'errorMessage', 'sentAt', 'status', 'updatedAt'
        ]);

      allow delete: if isOwner();
    }
    // <<< STUDIO37 NOTIFICATION EVENT RULES END

    match /mail/{mailId} {
      allow create: if isSignedIn() &&
        userDocExists() &&
        getUserData().role == 'admin' &&
        getUserData().status == 'pending' &&
        validApprovalMail(request.resource.data);
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
